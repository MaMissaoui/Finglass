import { Palette } from "std-widgets.slint";

// IBM Plex Sans (SIL Open Font License 1.1, see fonts/OFL.txt), the same four faces as FinDesk.
import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-Medium.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import "fonts/IBMPlexSans-Bold.ttf";

// FinDesk's Material 3 type scale, in IBM Plex Sans. Sizes are in logical pixels; weights are the
// bundled faces (400 Regular, 500 Medium, 600 SemiBold). Use the tokens by role, not by number.
export global Type {
    out property <length> headline-size: 24px;
    out property <int> headline-weight: 600;

    out property <length> title-large-size: 20px;
    out property <int> title-large-weight: 600;

    out property <length> title-medium-size: 16px;
    out property <int> title-medium-weight: 600;

    out property <length> title-small-size: 14px;
    out property <int> title-small-weight: 500;

    out property <length> body-size: 14px;
    out property <int> body-weight: 400;

    out property <length> body-small-size: 12px;
    out property <int> body-small-weight: 400;

    out property <length> label-size: 14px;
    out property <int> label-weight: 500;

    out property <length> label-small-size: 12px;
    out property <int> label-small-weight: 500;

    // Large KPI amounts keep a slightly larger size than the headline token.
    out property <length> amount-size: 28px;
    out property <int> amount-weight: 700;
}

// Corner radii, named by the element they shape. Use these instead of literals so the restyle can
// change a whole family of shapes at once. Sizes are in logical pixels.
export global Radius {
    // Thin accent bars, progress tracks, checkbox boxes and flag corners.
    out property <length> hairline: 2px;
    // Progress fills, "new" dots, small chart bars and receipt marks.
    out property <length> dot: 3px;
    // 7 px category dots.
    out property <length> marker: 4px;
    // Text fields.
    out property <length> field: 4px;
    // Document thumbnail page corners.
    out property <length> thumbnail: 4px;
    // Chart bars and donut segments.
    out property <length> bar: 5px;
    // Menu rows, list rows and small pills.
    out property <length> small: 6px;
    // Inner panels, banners, menu bodies, sidebar items and thumbnails.
    out property <length> panel: 8px;
    // The 18 px unread counter badge.
    out property <length> counter: 9px;
    // 20 px round icon buttons.
    out property <length> icon-small: 10px;
    // The 20 px status badge.
    out property <length> badge: 10px;
    // Dropdown menus.
    out property <length> menu: 10px;
    // 22 px status tags.
    out property <length> tag: 11px;
    // Cards and page surfaces.
    out property <length> surface: 12px;
    // 24 px round icon buttons.
    out property <length> icon: 12px;
    // 26 px colour swatches.
    out property <length> swatch: 13px;
    // 28 px chips and step markers.
    out property <length> chip: 14px;
    // 28 px round icon buttons.
    out property <length> icon-medium: 14px;
    // 32 px chips, month arrows and action pickers.
    out property <length> control-small: 16px;
    // 40 px buttons, fields and select pills.
    out property <length> control: 20px;
    // Modal dialogs.
    out property <length> dialog: 28px;
}

// Finglass's palettes. The window sets `mode` to system, light or dark; in system mode the fluent
// style's colour-scheme is followed so the app matches the desktop.
export global Theme {
    in property <string> mode: "system";

    // The OS colour scheme, captured in each window's `init` before the first explicit assignment
    // replaces Palette's default binding to the OS scheme. Returning to "system" restores it.
    in-out property <ColorScheme> os-scheme: Palette.color-scheme;
    property <bool> os-scheme-captured: false;
    // Set once the app has assigned Palette.color-scheme. While it is false, Palette still follows
    // the OS scheme live. After returning to "system" it is pinned to the captured scheme, so a later
    // live OS change may need a restart.
    property <bool> scheme-assigned: false;

    public function capture-os-scheme() {
        if (!os-scheme-captured) {
            os-scheme = Palette.color-scheme;
            os-scheme-captured = true;
        }
    }

    public function apply-scheme() {
        capture-os-scheme();
        if (mode == "light") {
            Palette.color-scheme = ColorScheme.light;
            scheme-assigned = true;
        } else if (mode == "dark") {
            Palette.color-scheme = ColorScheme.dark;
            scheme-assigned = true;
        } else if (scheme-assigned) {
            Palette.color-scheme = os-scheme;
        }
    }

    // Follow Palette in system mode until it has been assigned, so a live OS change still shows;
    // after that the captured OS scheme is the value both the widgets and Theme.dark use.
    in property <bool> dark: mode == "system"
            ? (scheme-assigned ? os-scheme : Palette.color-scheme) == ColorScheme.dark
            : mode == "dark";

    // Brand
    out property <color> primary: dark ? #5EEAD4 : #0D9488;
    out property <color> primary-hover: dark ? #99F6E4 : #0F766E;
    out property <color> on-primary: dark ? #042F2E : #FFFFFF;

    // Surfaces
    out property <color> sidebar: dark ? #232429 : #ECEFF4;
    out property <color> background: dark ? #1C1B1F : #F5F7FA;
    out property <color> surface: dark ? #232529 : #FFFFFF;
    out property <color> divider: dark ? #49454F : #E5E7EB;
    out property <color> text: dark ? #E6E1E5 : #2F2F2F;
    out property <color> muted-text: dark ? #CAC4D0 : #5B6472;

    // Selection
    out property <color> selected: dark ? #134E4A : #CCFBF1;
    out property <color> on-selected: dark ? #99F6E4 : #134E4A;

    // Semantic colours from FinDesk's Color.kt
    out property <color> error: dark ? #F87171 : #DC2626;
    out property <color> error-hover: dark ? #FCA5A5 : #B91C1C;
    out property <color> success: dark ? #34D399 : #098765;
    out property <color> warning: #F59E0B;

    // The scrim behind modal dialogs.
    out property <color> scrim: #00000080;
    // Document type accents: PDF and image previews.
    out property <color> document-pdf: #E53935;
    out property <color> document-image: #43A047;
    // Pale tag fill and its text for "tax relevant" markers.
    out property <color> warning-pale: #F59E0B33;
    out property <color> warning-strong: #B45309;
}

// The fixed colours of the language flags drawn in the top bar. Identity colours, not theme.
export global FlagColours {
    out property <color> german-black: #000000;
    out property <color> german-red: #DD0000;
    out property <color> german-gold: #FFCE00;
    out property <color> french-blue: #002395;
    out property <color> french-white: #FFFFFF;
    out property <color> french-red: #ED2939;
}

// The eight fixed monogram backgrounds, chosen by the stable colour index from
// `finglass_core::bank_logo::monogram`. White SemiBold letters reach at least 4.5:1 on each.
export global MonogramColours {
    public pure function colour(index: int) -> color {
        if (index == 1) { return #0E7490; }
        if (index == 2) { return #7C3AED; }
        if (index == 3) { return #BE123C; }
        if (index == 4) { return #15803D; }
        if (index == 5) { return #1D4ED8; }
        if (index == 6) { return #A21CAF; }
        if (index == 7) { return #C2410C; }
        return #B45309;
    }
}
