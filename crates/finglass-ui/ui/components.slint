// Colours of account amounts, shared by the page and the panel.
export global AccountTone {
    // A balance: ink at or above zero, alert below it, muted for loans and exactly zero.
    public pure function amount-color(tone: string) -> color {
        if (tone == "negative") {
            return Theme.alert;
        }
        if (tone == "loan") {
            return Theme.muted-text;
        }
        if (tone == "plain") {
            return Theme.muted-text;
        }
        if (tone == "zero") {
            return Theme.muted-text;
        }
        return Theme.text;
    }

    // A booking or flow amount: inflow green, outflow ink.
    public pure function flow-color(tone: string) -> color {
        if (tone == "positive") {
            return Theme.money-in;
        }
        if (tone == "negative") {
            return Theme.money-out;
        }
        return Theme.text;
    }
}

// A small unread-booking counter, shown only above zero.
export component CountBadge inherits Rectangle {
    in property <int> count;
    in property <bool> selected;

    visible: root.count > 0;
    height: 18px;
    min-width: 18px;
    border-radius: Radius.counter;
    background: root.selected ? transparent : Theme.primary;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.on-selected;

    Text {
        width: parent.width;
        text: root.count > 99 ? "99+" : "\{root.count}";
        color: root.selected ? Theme.on-selected : Theme.on-primary;
        font-size: Type.label-small-size;
        font-weight: Type.label-small-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The bank's bundled logo on a white tile, or a coloured monogram when the bank has no logo.
// Decorative: the bank name beside it stays the label.
export component BankBadge inherits Rectangle {
    /// The SVG's id, or "" for a monogram.
    in property <string> logo;
    /// Up to three letters for the monogram.
    in property <string> letters;
    /// The index into the theme's eight monogram colours.
    in property <int> colour-index;
    in property <length> size: 24px;

    function logo-source(id: string) -> image {
        if (id == "hypovereinsbank") { return @image-url("banks/hypovereinsbank.svg"); }
        if (id == "dkb") { return @image-url("banks/dkb.svg"); }
        if (id == "postbank") { return @image-url("banks/postbank.svg"); }
        if (id == "deutsche-bank") { return @image-url("banks/deutsche-bank.svg"); }
        if (id == "commerzbank") { return @image-url("banks/commerzbank.svg"); }
        if (id == "santander") { return @image-url("banks/santander.svg"); }
        if (id == "n26") { return @image-url("banks/n26.svg"); }
        if (id == "sparkasse") { return @image-url("banks/sparkasse.svg"); }
        if (id == "volksbank") { return @image-url("banks/volksbank.svg"); }
        return @image-url("banks/sparkasse.svg");
    }

    visible: root.logo != "" || root.letters != "";
    width: root.size;
    height: root.size;
    // A logo sits on a 25 % rounded white tile; a monogram is a circle-ish filled tile.
    border-radius: root.logo != "" ? root.size * 0.25 : root.size / 2;
    background: root.logo != "" ? #FFFFFF : MonogramColours.colour(root.colour-index);
    border-width: root.logo != "" ? 1px : 0px;
    border-color: Theme.divider;
    accessible-role: none;

    if (root.logo != "") : Image {
        x: root.size * 0.1;
        y: root.size * 0.1;
        width: root.size * 0.8;
        height: root.size * 0.8;
        source: root.logo-source(root.logo);
        accessible-role: none;
    }

    if (root.logo == "") : Text {
        text: root.letters;
        color: #FFFFFF;
        font-size: root.size * 0.42;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// A filled action button in the brand colour. Material 3's 40 dp rounded button: it grows with its
// label instead of carrying a fixed minimum width, and an optional 18 dp icon sits before the text.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    /// A destructive confirmation uses the error colour, as FinDesk's delete dialogs do.
    in property <bool> destructive: false;
    /// Why the button is disabled, shown while the pointer rests on it.
    in property <string> tooltip-text: "";

    callback clicked;

    height: 40px;
    min-width: content.preferred-width;
    border-radius: Radius.control;
    background: !root.enabled ? Theme.divider
            : (touch.has-hover ? (root.destructive ? Theme.error-hover : Theme.primary-hover)
            : (root.destructive ? Theme.error : Theme.primary));

    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.on-primary;

    content := HorizontalLayout {
        padding-left: root.has-icon ? 16px : 24px;
        padding-right: 24px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;

        if (root.has-icon) : Image {
            width: 18px;
            height: 18px;
            source: root.icon;
            colorize: root.enabled ? Theme.on-primary : Theme.muted-text;
            accessible-role: none;
        }

        label := Text {
            text: root.text;
            color: root.enabled ? Theme.on-primary : Theme.muted-text;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if (root.tooltip-text != "") : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

// A small selectable pill for the theme and language choices.
export component ChoiceChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;

    callback clicked;

    height: 32px;
    min-width: 84px;
    border-radius: Radius.control-small;
    background: root.selected ? Theme.selected : Theme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: root.selected ? Theme.primary : (focus.has-focus ? Theme.primary : Theme.divider);

    Text {
        text: root.label;
        color: root.selected ? Theme.on-selected : Theme.text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => root.clicked();
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// A link-like text action for secondary navigation such as "Change passphrase" and "Back".
// Material 3 text button: 40 dp high, fully rounded, 12 dp content padding and an optional icon.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> has-icon: false;

    callback clicked;

    height: 40px;
    min-width: content.preferred-width;
    border-radius: Radius.control;
    background: touch.has-hover && root.enabled ? Theme.background : transparent;

    content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        if (root.has-icon) : Image {
            width: 18px;
            height: 18px;
            source: root.icon;
            colorize: !root.enabled ? Theme.muted-text : (touch.has-hover ? Theme.primary-hover : Theme.primary);
            accessible-role: none;
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.muted-text : (touch.has-hover ? Theme.primary-hover : Theme.primary);
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: parent.border-radius;
    }
}

// An outlined action button for less prominent actions. Material 3's outlined button has the same
// shape and padding as the filled one, with primary content on a transparent surface.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    /// Why the button is disabled, shown while the pointer rests on it.
    in property <string> tooltip-text: "";

    callback clicked;

    height: 40px;
    min-width: content.preferred-width;
    border-radius: Radius.control;
    background: touch.has-hover && root.enabled ? Theme.background : transparent;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.divider;

    content := HorizontalLayout {
        padding-left: root.has-icon ? 16px : 24px;
        padding-right: 24px;
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;

        if (root.has-icon) : Image {
            width: 18px;
            height: 18px;
            source: root.icon;
            colorize: root.enabled ? Theme.text : Theme.muted-text;
            opacity: root.enabled ? 1.0 : 0.38;
            accessible-role: none;
        }

        label := Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.muted-text;
            opacity: root.enabled ? 1.0 : 0.38;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if (root.tooltip-text != "") : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

// An exclusive choice row in Material 3's segmented-button shape: one rounded outline, equal segments
// and a selected segment filled with the primary container tint. Tab reaches the row; Left/Right move
// the selection and Return/Space select it.
export component SegmentedButton inherits Rectangle {
    in property <[string]> labels;
    in property <int> selected: 0;

    callback select(int);

    height: 40px;
    min-width: segments.preferred-width;
    border-radius: Radius.control;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.divider;
    background: transparent;
    clip: true;

    segments := HorizontalLayout {
        spacing: 0px;
        // Inside the outline, so the selected segment's tint doesn't cover it.
        padding: 1px;

        for label[index] in root.labels : Rectangle {
            horizontal-stretch: 1;
            min-width: segment-label.preferred-width + 32px;
            background: index == root.selected ? Theme.selected : transparent;
            // The outer segments carry the control's rounded ends themselves: the software renderer
            // clips children to the rectangle, not to the parent's rounded corners.
            border-top-left-radius: index == 0 ? root.border-radius - 1px : 0px;
            border-bottom-left-radius: index == 0 ? root.border-radius - 1px : 0px;
            border-top-right-radius: index == root.labels.length - 1 ? root.border-radius - 1px : 0px;
            border-bottom-right-radius: index == root.labels.length - 1 ? root.border-radius - 1px : 0px;

            if (index > 0) : Rectangle {
                x: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.divider;
            }

            segment-label := Text {
                text: label;
                color: index == root.selected ? Theme.on-selected : Theme.text;
                font-size: Type.label-size;
                font-weight: index == root.selected ? 600 : Type.label-weight;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            TouchArea {
                clicked => {
                    root.select(index);
                }
            }
        }
    }

    focus := FocusScope {
        // The TouchAreas underneath handle the mouse; see the buttons above.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow && root.selected > 0) {
                root.select(root.selected - 1);
                return accept;
            }
            if (event.text == Key.RightArrow && root.selected < root.labels.length - 1) {
                root.select(root.selected + 1);
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.select(root.selected);
                return accept;
            }
            return reject;
        }
    }
}

// A card surface with a hairline outline.
export component Card inherits Rectangle {
    border-radius: Radius.surface;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.divider;
}

// An icon-only button. Material 3's 40 dp circular hit area with a 24 dp icon. Its accessible label
// replaces the visible text. `outlined` draws the outlined-icon-button ring (for example the row and
// page menus next to a filled Add button).
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> icon-color: Theme.muted-text;
    in property <length> icon-size: 24px;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> outlined: false;
    /// A destructive icon (a trash in a list): muted until the pointer rests on it.
    in property <bool> destructive: false;
    /// The accessible label shown as a tooltip while the pointer rests on the button.
    in property <string> tooltip-text: "";

    callback clicked;

    width: 40px;
    height: 40px;
    border-radius: Radius.control;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.selected ? Theme.selected : (touch.has-hover && root.enabled ? Theme.background : transparent);
    border-width: focus.has-focus ? 2px : (root.outlined ? 1px : 0px);
    border-color: focus.has-focus ? Theme.primary : Theme.divider;
    accessible-role: button;
    accessible-label: root.label;

    Image {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.selected ? Theme.on-selected
                : (root.destructive ? (touch.has-hover ? Theme.error : Theme.muted-text) : root.icon-color);
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: parent.border-radius;
    }

    if (root.tooltip-text != "") : Tooltip {
        text: @markdown("\{root.tooltip-text}");
    }
}

// Inline success and error banner with a dismiss action.
export component MessageBanner inherits Rectangle {
    in property <string> text;
    in property <bool> is-error: false;

    callback dismissed;

    height: 42px;
    border-radius: Radius.panel;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.is-error ? Theme.error : Theme.success;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        spacing: 12px;
        cross-axis-alignment: center;

        Image {
            width: 20px;
            height: 20px;
            source: root.is-error ? @image-url("icons/warning.svg") : @image-url("icons/check_circle.svg");
            colorize: root.is-error ? Theme.error : Theme.success;
            accessible-role: none;
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.is-error ? Theme.error : Theme.text;
            font-size: Type.body-size;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        IconButton {
            icon: @image-url("icons/close.svg");
            label: Tr.t("Dismiss");
            tooltip-text: Tr.t("Dismiss");
            icon-size: 18px;
            clicked => { root.dismissed(); }
        }
    }
}

// One filter tab in a page's tab bar.
export component TabPill inherits Rectangle {
    in property <string> text;
    in property <bool> selected;

    callback clicked;

    height: 36px;
    min-width: 120px;
    border-radius: Radius.small;
    background: root.selected ? Theme.selected : Theme.surface;
    border-width: 1px;
    border-color: Theme.divider;

    Text {
        text: root.text;
        color: root.selected ? Theme.on-selected : Theme.text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => root.clicked();
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// One sidebar entry: icon and label when expanded, a centred icon with an accessible label when
// collapsed. Both variants use the same selection tint, accent bar and keyboard focus ring.
export component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> collapsed;

    callback activated;

    height: root.collapsed ? 44px : 40px;
    border-radius: Radius.panel;
    background: root.selected ? Theme.selected : transparent;
    clip: true;
    accessible-role: button;
    accessible-label: root.label;

    Rectangle {
        visible: root.selected;
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: Theme.primary;
    }

    if (root.collapsed) : Image {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.selected ? Theme.on-selected : Theme.muted-text;
        accessible-role: none;
    }

    if (!root.collapsed) : HorizontalLayout {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        spacing: 12px;
        cross-axis-alignment: center;

        Image {
            width: 24px;
            height: 24px;
            source: root.icon;
            colorize: root.selected ? Theme.on-selected : Theme.muted-text;
            accessible-role: none;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.on-selected : Theme.text;
            font-size: Type.title-medium-size;
            font-weight: root.selected ? Type.title-medium-weight : Type.body-weight;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    TouchArea {
        clicked => root.activated();
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: parent.border-radius;
    }
}

// One document line in the Documents list.
export struct DocumentRow {
    id: int,
    name: string,
    meta: string,
    is-linked: bool,
    has-ocr: bool,
    is-pdf: bool,
    selected: bool,
}

// One transaction the Documents detail panel offers for linking.
export struct DocumentLinkRow {
    id: int,
    title: string,
    meta: string,
    badge: string,
}

// The rounded search field with a leading magnifier.
export component SearchField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;

    callback edited(string);

    height: 40px;
    border-radius: Radius.control;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : Theme.divider;

    /// Puts keyboard focus into the text field, used by View > Find.
    public function focus-input() {
        input.focus();
    }

    /// Clears the field and reports the change, as the clear action does.
    public function clear() {
        if (input.text != "") {
            input.text = "";
            root.edited("");
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 8px;
        cross-axis-alignment: center;

        Image {
            width: 20px;
            height: 20px;
            source: @image-url("icons/search.svg");
            colorize: Theme.muted-text;
            accessible-role: none;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            input := TextInput {
                width: 100%;
                height: 100%;
                text: root.text;
                color: Theme.text;
                font-size: Type.body-size;
                vertical-alignment: center;
                enabled: root.enabled;
                edited => { root.edited(input.text); }
                accepted => { root.edited(input.text); }
                key-pressed(event) => {
                    if (event.text == Key.Escape && input.text != "") {
                        root.clear();
                        return accept;
                    }
                    return reject;
                }
            }

            if (input.text == "") : Text {
                width: 100%;
                height: 100%;
                horizontal-alignment: left;
                text: root.placeholder;
                color: Theme.muted-text;
                font-size: Type.body-size;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if (input.text != "" && root.enabled) : IconButton {
            icon: @image-url("icons/close.svg");
            label: Tr.t("ClearSearch");
            tooltip-text: Tr.t("ClearSearch");
            icon-size: 18px;
            width: 30px;
            height: 30px;
            clicked => { root.clear(); }
        }
    }
}

// A Material 3 outlined text field: 56 dp high, radius 4, a hairline outline that turns primary when
// focused and error-coloured when invalid. The label rests inside as a placeholder and floats onto the
// top border once the field is focused or filled. Supporting text sits below the outline.
export component OutlinedField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <bool> error: false;
    in property <string> supporting-text: "";
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <InputType> input-type: InputType.text;
    in property <bool> multiline: false;
    in property <image> trailing-icon;
    in property <bool> has-trailing-icon: false;
    in property <string> trailing-label;

    callback edited(string);
    callback accepted(string);
    callback trailing-clicked;

    // The label floats when there is something to make room for, or while the field is focused.
    property <bool> floating: input.has-focus || root.text != "" || root.error;

    spacing: 4px;
    alignment: start;

    public function focus-input() {
        input.focus();
    }

    field := Rectangle {
        height: root.multiline ? max(56px, input.preferred-height + 32px) : 56px;
        background: Theme.surface;
        border-radius: Radius.field;
        border-width: root.error || input.has-focus ? 2px : 1px;
        border-color: root.error ? Theme.error : (input.has-focus ? Theme.primary : Theme.divider);
        clip: false;

        // The field's own background behind the floating label cuts the gap into the outline.
        label-background := Rectangle {
            visible: root.floating;
            x: 8px;
            y: -8px;
            width: label.preferred-width + 8px;
            height: 16px;
            background: Theme.surface;
        }

        input := TextInput {
            x: 16px;
            y: root.multiline ? 16px : 16px;
            width: parent.width - 32px - (root.has-trailing-icon ? 36px : 0px);
            height: root.multiline ? max(24px, input.preferred-height) : 24px;
            text <=> root.text;
            enabled: root.enabled;
            read-only: root.read-only;
            single-line: !root.multiline;
            wrap: word-wrap;
            input-type: root.input-type;
            color: root.enabled ? Theme.text : Theme.muted-text;
            font-size: Type.body-size;
            vertical-alignment: root.multiline ? top : center;
            edited => { root.edited(input.text); }
            accepted => { root.accepted(input.text); }
        }

        label := Text {
            x: 12px;
            y: root.floating ? -8px : (parent.height - self.preferred-height) / 2;
            width: parent.width - 24px;
            text: root.label;
            color: root.error ? Theme.error : (input.has-focus ? Theme.primary : Theme.muted-text);
            font-size: root.floating ? Type.body-small-size : Type.body-size;
            font-weight: root.floating ? Type.body-small-weight : Type.body-weight;
            vertical-alignment: center;
            overflow: elide;
        }

        if (root.has-trailing-icon) : IconButton {
            x: parent.width - 44px;
            y: (parent.height - 40px) / 2;
            width: 40px;
            height: 40px;
            icon: root.trailing-icon;
            label: root.trailing-label;
            tooltip-text: root.trailing-label;
            enabled: root.enabled;
            clicked => { root.trailing-clicked(); }
        }
    }

    if (root.supporting-text != "") : Text {
        text: root.supporting-text;
        color: root.error ? Theme.error : Theme.muted-text;
        font-size: Type.body-small-size;
        wrap: word-wrap;
    }
}

// A Material 3 check box row: an 18 dp rounded square, filled primary with a check mark, a 40 dp
// pointer hit area with a hover tint, and the label to the right. Space toggles it.
export component Checkbox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;

    callback toggled;

    height: max(40px, row.preferred-height);
    background: transparent;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;

    function toggle() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    row := HorizontalLayout {
        width: parent.width;
        spacing: 8px;
        cross-axis-alignment: center;

        box-area := Rectangle {
            width: 40px;
            height: 40px;
            border-radius: Radius.control;
            background: touch.has-hover && root.enabled ? Theme.background : transparent;

            box := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: Radius.hairline;
                background: root.checked ? Theme.primary : transparent;
                border-width: 2px;
                border-color: root.checked ? Theme.primary : (touch.has-hover ? Theme.text : Theme.muted-text);
            }

            if (root.checked) : Image {
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/check.svg");
                colorize: Theme.on-primary;
                accessible-role: none;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.enabled ? Theme.text : Theme.muted-text;
            font-size: Type.body-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggle(); }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Space) {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: Radius.panel;
    }
}

// A 40 dp outlined selector pill: "Label: Value" with the down arrow, opening the same option list as
// the old ComboBox. Up/Down/Return/Escape work while the popup is open.
export component SelectPill inherits Rectangle {
    in property <string> label-prefix: "";
    in property <string> value;
    in property <[string]> options;
    in property <bool> enabled: true;

    callback chosen(int);
    callback value-chosen(string);

    property <bool> menu-open: false;
    property <int> hover: 0;

    height: 40px;
    min-width: content.preferred-width;
    border-radius: Radius.control;
    background: touch.has-hover && root.enabled ? Theme.background : Theme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.divider;
    opacity: root.enabled ? 1.0 : 0.55;
    accessible-role: button;
    accessible-label: root.label-prefix + root.value;
    accessible-enabled: root.enabled;

    function open-menu() {
        if (root.enabled && root.options.length > 0) {
            root.hover = 0;
            root.menu-open = true;
            menu.show();
            focus.focus();
        }
    }

    function close-menu() {
        root.menu-open = false;
        menu.close();
    }

    function choose(index: int) {
        if (index >= 0 && index < root.options.length) {
            root.close-menu();
            root.chosen(index);
            root.value-chosen(root.options[index]);
        }
    }

    content := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 6px;
        cross-axis-alignment: center;

        Text {
            text: root.label-prefix + root.value;
            color: Theme.primary;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            vertical-alignment: center;
            overflow: elide;
        }

        Image {
            width: 18px;
            height: 18px;
            source: @image-url("icons/arrow_drop_down.svg");
            colorize: Theme.primary;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.open-menu(); }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (!root.menu-open) {
                if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                    root.open-menu();
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.Escape) {
                root.close-menu();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.hover = min(root.hover + 1, root.options.length - 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.hover = max(root.hover - 1, 0);
                return accept;
            }
            if (event.text == Key.Return) {
                root.choose(root.hover);
                return accept;
            }
            return reject;
        }
    }

    menu := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 220px);
        height: min(max(root.options.length * 36px, 36px), 320px);

        Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            ListView {
                for option[index] in root.options : Rectangle {
                    height: 36px;
                    background: index == root.hover || row-touch.has-hover ? Theme.background : transparent;

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: option;
                        color: index == root.hover ? Theme.primary : Theme.text;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-touch := TouchArea {
                        clicked => { root.choose(index); }
                    }
                }
            }
        }
    }
}

// A small pill for OCR state and match scores.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> positive: true;

    height: 20px;
    border-radius: Radius.badge;
    background: Theme.background;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.positive ? Theme.success : Theme.muted-text;
            font-size: Type.label-small-size;
            font-weight: Type.label-small-weight;
            vertical-alignment: center;
        }
    }
}
