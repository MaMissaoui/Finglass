// Colours of account amounts, shared by the page and the panel.
export global AccountTone {
    public pure function amount-color(tone: string) -> color {
        if (tone == "positive") {
            return Theme.success;
        }
        if (tone == "negative") {
            return Theme.error;
        }
        if (tone == "loan") {
            return Theme.muted-text;
        }
        if (tone == "plain") {
            return Theme.muted-text;
        }
        return Theme.text;
    }
}

// A small unread-booking counter, shown only above zero.
export component CountBadge inherits Rectangle {
    in property <int> count;
    in property <bool> selected;

    visible: root.count > 0;
    height: 18px;
    min-width: 18px;
    border-radius: 9px;
    background: root.selected ? transparent : Theme.primary;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.on-selected;

    Text {
        width: parent.width;
        text: root.count > 99 ? "99+" : "\{root.count}";
        color: root.selected ? Theme.on-selected : Theme.on-primary;
        font-size: Type.label-small-size;
        font-weight: Type.label-small-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A filled action button in the brand colour. The fluent widgets keep their own palette; the
// surfaces and primary actions that belong to Finglass use Theme directly.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked;

    height: 36px;
    min-width: max(120px, label.preferred-width + 28px);
    border-radius: 6px;
    background: !root.enabled ? Theme.divider : (touch.has-hover ? Theme.primary-hover : Theme.primary);

    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.on-primary;

    label := Text {
        text: root.text;
        color: root.enabled ? Theme.on-primary : Theme.muted-text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// A small selectable pill for the theme and language choices.
export component ChoiceChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;

    callback clicked;

    height: 32px;
    min-width: 84px;
    border-radius: 16px;
    background: root.selected ? Theme.primary : Theme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: root.selected ? Theme.primary : (focus.has-focus ? Theme.primary : Theme.divider);

    Text {
        text: root.label;
        color: root.selected ? Theme.on-primary : Theme.text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => root.clicked();
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// A link-like text action for secondary navigation such as "Change passphrase" and "Back".
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked;

    height: 28px;
    min-width: 80px;
    background: transparent;

    Text {
        text: root.text;
        color: !root.enabled ? Theme.muted-text : (touch.has-hover ? Theme.primary-hover : Theme.primary);
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: 4px;
    }
}

// An outlined action button for less prominent actions.
export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked;

    height: 32px;
    min-width: max(80px, label.preferred-width + 20px);
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? Theme.background : Theme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.divider;

    label := Text {
        text: root.text;
        color: root.enabled ? Theme.text : Theme.muted-text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// A card surface with a hairline outline.
export component Card inherits Rectangle {
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.divider;
}

// An icon-only button for the top bar. Its accessible label replaces the visible text.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> icon-color: Theme.muted-text;
    in property <length> icon-size: 24px;
    in property <bool> selected: false;
    in property <bool> enabled: true;

    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: 8px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.selected ? Theme.selected : (touch.has-hover && root.enabled ? Theme.background : transparent);
    accessible-role: button;
    accessible-label: root.label;

    Image {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.selected ? Theme.on-selected : root.icon-color;
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: parent.border-radius;
    }
}

// Inline success and error banner with a dismiss action.
export component MessageBanner inherits Rectangle {
    in property <string> text;
    in property <bool> is-error: false;

    callback dismissed;

    height: 42px;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.is-error ? Theme.error : Theme.success;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        spacing: 12px;

        Image {
            width: 20px;
            height: 20px;
            source: root.is-error ? @image-url("icons/warning.svg") : @image-url("icons/check_circle.svg");
            colorize: root.is-error ? Theme.error : Theme.success;
            accessible-role: none;
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.is-error ? Theme.error : Theme.text;
            font-size: Type.body-size;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        IconButton {
            icon: @image-url("icons/close.svg");
            label: Tr.t("Dismiss");
            icon-size: 18px;
            clicked => { root.dismissed(); }
        }
    }
}

// One filter tab in a page's tab bar.
export component TabPill inherits Rectangle {
    in property <string> text;
    in property <bool> selected;

    callback clicked;

    height: 36px;
    min-width: 120px;
    border-radius: 6px;
    background: root.selected ? Theme.selected : Theme.surface;
    border-width: 1px;
    border-color: Theme.divider;

    Text {
        text: root.text;
        color: root.selected ? Theme.on-selected : Theme.text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => root.clicked();
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// One sidebar entry: icon and label when expanded, a centred icon with an accessible label when
// collapsed. Both variants use the same selection tint, accent bar and keyboard focus ring.
export component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> collapsed;

    callback activated;

    height: root.collapsed ? 44px : 40px;
    border-radius: 8px;
    background: root.selected ? Theme.selected : transparent;
    accessible-role: button;
    accessible-label: root.label;

    Rectangle {
        visible: root.selected;
        x: 0px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 2px;
        background: Theme.primary;
    }

    if (root.collapsed) : Image {
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.selected ? Theme.on-selected : Theme.muted-text;
        accessible-role: none;
    }

    if (!root.collapsed) : HorizontalLayout {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        spacing: 12px;
        cross-axis-alignment: center;

        Image {
            width: 24px;
            height: 24px;
            source: root.icon;
            colorize: root.selected ? Theme.on-selected : Theme.muted-text;
            accessible-role: none;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.on-selected : Theme.text;
            font-size: Type.title-medium-size;
            font-weight: root.selected ? Type.title-medium-weight : Type.body-weight;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    TouchArea {
        clicked => root.activated();
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: parent.border-radius;
    }
}

// One document line in the Documents list.
export struct DocumentRow {
    id: int,
    name: string,
    meta: string,
    is-linked: bool,
    has-ocr: bool,
    is-pdf: bool,
    selected: bool,
}

// One transaction the Documents detail panel offers for linking.
export struct DocumentLinkRow {
    id: int,
    title: string,
    meta: string,
    badge: string,
}

// The rounded search field with a leading magnifier.
export component SearchField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;

    callback edited(string);

    height: 40px;
    border-radius: 20px;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : Theme.divider;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 8px;

        Image {
            width: 20px;
            height: 20px;
            source: @image-url("icons/search.svg");
            colorize: Theme.muted-text;
            accessible-role: none;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            input := TextInput {
                width: 100%;
                height: 100%;
                text: root.text;
                color: Theme.text;
                font-size: Type.body-size;
                vertical-alignment: center;
                enabled: root.enabled;
                edited => { root.edited(input.text); }
                accepted => { root.edited(input.text); }
            }

            if (input.text == "") : Text {
                width: 100%;
                height: 100%;
                horizontal-alignment: left;
                text: root.placeholder;
                color: Theme.muted-text;
                font-size: Type.body-size;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if (input.text != "" && root.enabled) : IconButton {
            icon: @image-url("icons/close.svg");
            label: Tr.t("ClearSearch");
            icon-size: 18px;
            width: 30px;
            height: 30px;
            clicked => { root.edited(""); }
        }
    }
}

// A small pill for OCR state and match scores.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> positive: true;

    height: 20px;
    border-radius: 10px;
    background: root.positive ? Theme.selected : Theme.background;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            color: root.positive ? Theme.success : Theme.muted-text;
            font-size: Type.label-small-size;
            font-weight: Type.label-small-weight;
            vertical-alignment: center;
        }
    }
}
