// One row of the audit log, prepared by finglass-core (including the local-time string).
export struct AuditRow {
    time: string,
    action: string,
    actor: string,
    details: string,
}

// One category in the Settings list, prepared by the UI mapping.
export struct CategoryRow {
    id: int,
    name: string,
    colour: color,
    budget-text: string,
    usage-text: string,
    tax-relevant: bool,
    transfer: bool,
}

// One auto-categorization rule in the Settings list, prepared by the UI mapping.
export struct RuleRow {
    id: int,
    pattern: string,
    category-text: string,
    detail: string,
    prio-text: string,
}

// One colour of the category palette.
export struct ColourSwatch {
    hex: string,
    colour: color,
}

// One option in a TAN-procedure or TAN-medium prompt.
export struct BankingPromptChoice {
    id: string,
    label: string,
}

// One bank suggestion in the add-online-bank dialog.
export struct BankSuggestionRow {
    name: string,
    detail: string,
    blz: string,
    bic: string,
}

// One profile in Settings and in the top bar's dropdown.
export struct ProfileRow {
    index: int,
    name: string,
    open: bool,
    next-start: bool,
    can-switch: bool,
    can-delete: bool,
}
