        auto-apply <=> root.rule-dialog-auto-apply;
        field-options: root.rule-dialog-field-options;
        field-index <=> root.rule-dialog-field-index;
        direction-options: root.rule-dialog-direction-options;
        direction-index <=> root.rule-dialog-direction-index;
        tax-options: root.rule-dialog-tax-options;
        tax-index <=> root.rule-dialog-tax-index;
        error-text: root.rule-dialog-error;
        changed(pattern, priority) => { root.settings-rule-changed(pattern, priority); }
        close => { root.settings-rule-dialog-close(); }
        save => { root.settings-rule-dialog-save(); }
    }

    if (root.rule-delete-open) : ConfirmDialog {
        title: root.rule-delete-title;
        text: root.rule-delete-text;
        confirm-text: Tr.t("Delete");
        confirm => { root.settings-confirm-delete-rule(); }
        cancel => { root.settings-cancel-delete-rule(); }
    }

    if (root.rule-import-open) : RuleImportDialog {
        new-rules-text: root.rule-import-new-rules-text;
        categories-text: root.rule-import-categories-text;
        categories-list: root.rule-import-categories-list;
        duplicates-text: root.rule-import-duplicates-text;
        conflicts-text: root.rule-import-conflicts-text;
        conflicts-list: root.rule-import-conflicts-list;
        errors-text: root.rule-import-errors-text;
        errors-list: root.rule-import-errors-list;
        show-categorize: root.rule-import-show-categorize;
        categorize-text: root.rule-import-categorize-text;
        categorize <=> root.rule-import-categorize;
        busy: root.rule-import-busy;
        confirm-enabled: root.rule-import-confirm-enabled;
        close => { root.settings-cancel-rule-import(); }
        confirm => { root.settings-confirm-rule-import(); }
    }

    if (root.settings-restore-open) : ConfirmDialog {
        title: root.settings-restore-title;
        text: root.settings-restore-text;
        confirm-text: Tr.t("PrepareRestore");
        busy: root.settings-backup-busy;
        confirm => { root.settings-confirm-restore(); }
        cancel => { root.settings-cancel-restore(); }
    }

    if (root.settings-restore-passphrase-open) : BackupPassphraseDialog {
        file-name: root.settings-restore-passphrase-file;
        wrong: root.settings-restore-passphrase-wrong;
        busy: root.settings-backup-busy;
        passphrase <=> root.settings-restore-passphrase;
        close => { root.settings-cancel-restore-passphrase(); }
        submit(value) => { root.settings-confirm-restore-passphrase(value); }
    }

    if (root.profile-dialog-open) : ProfileNameDialog {
        title: root.profile-dialog-title;
        name <=> root.profile-dialog-name;
        error-text: root.profile-dialog-error;
        close => { root.settings-profile-dialog-close(); }
        save => { root.settings-profile-dialog-save(); }
    }

    if (root.profile-delete-open) : ConfirmDialog {
        title: root.profile-delete-title;
        text: root.profile-delete-text;
        confirm-text: Tr.t("Delete");
        confirm => { root.settings-confirm-delete-profile(); }
        cancel => { root.settings-cancel-delete-profile(); }
    }

    // The top bar's profile menu. The backdrop closes it on a click anywhere else.
    if (root.profile-menu-open) : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => { root.profile-menu-open = false; }
        }

        Rectangle {
            x: root.width - 444px;
            y: 58px;
            width: 240px;
            height: 24px + (root.profile-rows.length + 1) * 36px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.divider;
            background: Theme.surface;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                for row in root.profile-rows : ProfileMenuItem {
                    name: row.name;
                    selected: row.open;
                    picked => {
                        root.profile-menu-open = false;
                        if (!row.open) {
                            root.profile-switch(row.index);
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                ProfileMenuItem {
                    name: Tr.t("ManageProfiles");
                    selected: false;
                    picked => {
                        root.profile-menu-open = false;
                        root.profile-manage();
                    }
                }
            }
        }
    }

    // The top bar's language menu. The backdrop closes it on a click anywhere else.
    if (root.language-menu-open) : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => { root.language-menu-open = false; }
        }

        Rectangle {
            x: root.width - 184px;
            y: 58px;
            width: 160px;
            height: 144px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.divider;
            background: Theme.surface;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                LanguageMenuItem {
                    code: "EN";
                    selected: root.language == "en";
                    picked => {
                        root.language-menu-open = false;
                        root.set-language("en");
                    }
                }
                LanguageMenuItem {
                    code: "DE";
                    selected: root.language == "de";
                    picked => {
                        root.language-menu-open = false;
                        root.set-language("de");
                    }
                }
                LanguageMenuItem {
                    code: "FR";
                    selected: root.language == "fr";
                    picked => {
                        root.language-menu-open = false;
                        root.set-language("fr");
                    }
                }
            }
        }
    }

    // Banking prompts stay above every other surface: only one can be open, and it blocks the page beneath.
    if (root.banking-prompt != "") : BankingPrompts {
        kind: root.banking-prompt;
        title: root.banking-prompt-title;
        text: root.banking-prompt-text;
        label: root.banking-prompt-label;
        remember-visible: root.banking-prompt-remember-visible;
        choices: root.banking-prompt-choices;
        challenge: root.banking-prompt-challenge;
        flicker-note: root.banking-prompt-flicker-note;
        challenge-image: root.banking-prompt-image;
        show-image: root.banking-prompt-show-image;
        answer-pin(value, remember) => { root.banking-answer-pin(value, remember); }
        answer-choice(value) => { root.banking-answer-choice(value); }
        answer-tan(value) => { root.banking-answer-tan(value); }
        answer-decoupled(confirmed) => { root.banking-answer-decoupled(confirmed); }
        cancel => { root.banking-answer-cancel(); }
    }
}
