// One language in the top bar's menu.
component LanguageMenuItem inherits Rectangle {
    in property <string> code;
    in property <bool> selected;

    callback picked;

    height: 40px;
    border-radius: 6px;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.background : transparent);
    accessible-role: button;
    accessible-label: root.code;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.code;
        color: root.selected ? Theme.on-selected : Theme.text;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    touch := TouchArea {
        clicked => root.picked();
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.picked();
                return accept;
            }
            return reject;
        }
    }
}

// One profile in the top bar's dropdown.
component ProfileMenuItem inherits Rectangle {
    in property <string> name;
    in property <bool> selected;

    callback picked;

    height: 36px;
    border-radius: 6px;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.background : transparent);
    accessible-role: button;
    accessible-label: root.name;

    Text {
        x: 12px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.name;
        color: root.selected ? Theme.on-selected : Theme.text;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
    }

    if (root.selected) : Text {
        x: parent.width - 26px;
        width: 16px;
        height: parent.height;
        text: "✓";
        color: Theme.on-selected;
        font-size: 14px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        clicked => root.picked();
    }
}

