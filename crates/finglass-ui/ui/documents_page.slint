import { ScrollView, Spinner } from "std-widgets.slint";
import { Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    Badge,
    Card,
    DocumentLinkRow,
    DocumentRow,
    MessageBanner,
    PrimaryButton,
    SearchField,
    SecondaryButton,
    SegmentedButton,
    TextButton,
} from "components.slint";

// One transaction row in the detail panel's suggestion and picker lists.
component LinkCandidateRow inherits Rectangle {
    in property <DocumentLinkRow> candidate;

    callback link(int);

    height: 44px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.candidate.title;
                color: Theme.text;
                font-size: Type.body-size;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: root.candidate.meta;
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        if (root.candidate.badge != "") : Badge {
            text: root.candidate.badge;
            positive: true;
        }

        TextButton {
            min-width: 48px;
            text: Tr.t("Link");
            clicked => { root.link(root.candidate.id); }
        }
    }
}

// The delete confirmation overlay.
component DeleteDocumentDialog inherits Rectangle {
    in property <string> text;

    callback close;
    callback confirm;

    width: 100%;
    height: 100%;
    background: #00000080;

    Rectangle {
        width: 400px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 28px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: Tr.t("DeleteDocumentTitle");
                color: Theme.text;
                font-size: Type.headline-size;
                font-weight: Type.headline-weight;
            }
            Text {
                text: root.text;
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => { root.close(); }
                }
                PrimaryButton {
                    text: Tr.t("Delete");
                    destructive: true;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
// The Documents page, ported from FinDesk's DocumentsScreen: search and upload, the filter tabs,
// the document list, and the detail panel with preview, OCR text and linking.
export component DocumentsPage inherits Rectangle {
    in property <[DocumentRow]> rows;
    in property <string> tab: "all";
    in property <string> tab-all-label;
    in property <string> tab-unlinked-label;
    in property <string> tab-linked-label;
    in property <string> search-query;
    in property <bool> ocr-available: true;
    in property <string> ocr-hint;
    in property <bool> uploading;
    in property <string> progress-text;
    in property <bool> loading;
    in property <string> error-text;
    in property <string> message-text;
    in property <bool> has-selection;
    in property <string> selected-name;
    in property <bool> selected-linked;
    in property <string> selected-link-label;
    in property <string> selected-ocr-heading;
    in property <string> selected-ocr-text;
    in property <string> preview-kind: "none";
    in property <image> preview;
    in property <[DocumentLinkRow]> suggestions;
    in property <[DocumentLinkRow]> candidates;
    in property <string> candidate-query;
    in property <string> delete-text;

    callback set-tab(string);
    callback search(string);
    callback select(int);
    callback close-detail;
    callback link(int);
    callback unlink;
    callback reprocess;
    callback delete;
    callback upload;
    callback open;
    callback candidate-query-changed(string);
    callback dismiss;

    property <bool> confirm-delete-open: false;

    // FinDesk hides the toolbar's search and upload in the completely empty library, where the empty
    // state already offers the one useful action.
    property <bool> library-empty: !root.loading && root.rows.length == 0 && root.search-query == "" && root.tab == "all";

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;

                if (!root.library-empty) : SearchField {
                    text: root.search-query;
                    placeholder: Tr.t("SearchDocuments");
                    enabled: !root.uploading;
                    edited(value) => { root.search(value); }
                }

                if (!root.ocr-available) : Text {
                    text: root.ocr-hint;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
            }

            if (root.uploading) : HorizontalLayout {
                spacing: 8px;
                Spinner {
                    width: 20px;
                    height: 20px;
                }
                Text {
                    text: root.progress-text;
                    color: Theme.muted-text;
                    font-size: Type.body-size;
                    vertical-alignment: center;
                }
            }

            if (!root.library-empty) : PrimaryButton {
                text: Tr.t("Upload");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                enabled: !root.uploading;
                clicked => { root.upload(); }
            }
        }

        if (root.message-text != "" || root.error-text != "") : MessageBanner {
            text: root.error-text != "" ? root.error-text : root.message-text;
            is-error: root.error-text != "";
            dismissed => { root.dismiss(); }
        }

        HorizontalLayout {
            alignment: start;

            SegmentedButton {
                horizontal-stretch: 0;
                labels: [root.tab-all-label, root.tab-unlinked-label, root.tab-linked-label];
                selected: root.tab == "all" ? 0 : (root.tab == "unlinked" ? 1 : 2);
                select(index) => {
                    root.set-tab(index == 0 ? "all" : (index == 1 ? "unlinked" : "linked"));
                }
            }
        }

        HorizontalLayout {
            width: 100%;
            horizontal-stretch: 1;
            spacing: 16px;

            Card {
                horizontal-stretch: 3;

                VerticalLayout {
                    if (root.loading) : VerticalLayout {
                        padding: 24px;
                        spacing: 8px;
                        alignment: center;
                        Spinner {
                            width: 24px;
                            height: 24px;
                        }
                    }

                    if (!root.loading && root.rows.length == 0) : VerticalLayout {
                        padding: 48px;
                        spacing: 8px;

                        Rectangle {
                            vertical-stretch: 1;
                            background: transparent;
                        }

                        HorizontalLayout {
                            width: 100%;
                            vertical-stretch: 0;
                            alignment: center;

                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 8px;
                                border-width: 2px;
                                border-color: Theme.muted-text;
                                background: transparent;

                                Rectangle {
                                    x: 10px;
                                    y: 10px;
                                    width: parent.width - 20px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.muted-text;
                                }
                                Rectangle {
                                    x: 10px;
                                    y: 20px;
                                    width: parent.width - 24px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.muted-text;
                                }
                                Rectangle {
                                    x: 10px;
                                    y: 30px;
                                    width: parent.width - 20px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.muted-text;
                                }
                            }
                        }

                        HorizontalLayout {
                            width: 100%;
                            vertical-stretch: 0;
                            alignment: center;

                            Text {
                                text: root.search-query == "" ? Tr.t("NoDocuments") : Tr.t("NoMatches");
                                color: Theme.text;
                                font-size: Type.title-medium-size;
                                font-weight: Type.title-medium-weight;
                                horizontal-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            width: 100%;
                            vertical-stretch: 0;
                            alignment: center;

                            Text {
                                width: 440px;
                                text: root.search-query == "" ? Tr.t("UploadHint") : Tr.t("TryAnotherSearch");
                                color: Theme.muted-text;
                                font-size: Type.body-size;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        if (root.search-query == "" && root.tab == "all") : HorizontalLayout {
                            width: 100%;
                            vertical-stretch: 0;
                            alignment: center;
                            padding-top: 8px;

                            PrimaryButton {
                                width: 160px;
                                text: Tr.t("Upload");
                                icon: @image-url("icons/add.svg");
                                has-icon: true;
                                enabled: !root.uploading;
                                clicked => { root.upload(); }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: transparent;
                        }
                    }

                    if (root.rows.length > 0) : ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            for row in root.rows : Rectangle {
                                height: 65px;

                                Rectangle {
                                    y: 0px;
                                    height: 64px;
                                    background: row.selected ? Theme.selected : transparent;

                                    HorizontalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        cross-axis-alignment: center;

                                        Image {
                                            width: 20px;
                                            height: 20px;
                                            source: row.is-pdf ? @image-url("icons/documents.svg") : @image-url("icons/image.svg");
                                            colorize: row.is-pdf ? #E53935 : #43A047;
                                            accessible-role: none;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: row.name;
                                                color: Theme.text;
                                                font-size: Type.title-small-size;
                                                font-weight: Type.title-small-weight;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: row.meta;
                                                color: row.is-linked ? Theme.primary : Theme.muted-text;
                                                font-size: Type.body-small-size;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Badge {
                                            text: row.has-ocr ? Tr.t("TextExtracted") : Tr.t("NoText");
                                            positive: row.has-ocr;
                                        }
                                    }

                                    TouchArea {
                                        clicked => { root.select(row.id); }
                                    }
                                }

                                // The divider sits at the row's bottom edge, not across its middle.
                                Rectangle {
                                    y: parent.height - self.height;
                                    height: 1px;
                                    background: Theme.divider;
                                }
                            }
                        }
                    }
                }
            }

            if (root.has-selection) : Card {
                horizontal-stretch: 2;

                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Text {
                                text: root.selected-name;
                                horizontal-stretch: 1;
                                color: Theme.text;
                                font-size: Type.title-medium-size;
                                font-weight: Type.title-medium-weight;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            TextButton {
                                text: Tr.t("Close");
                                clicked => { root.close-detail(); }
                            }
                        }

                        // The detail card is narrow at 1100 px; two rows keep the actions inside it.
                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                SecondaryButton {
                                    text: Tr.t("Open");
                                    clicked => { root.open(); }
                                }
                                SecondaryButton {
                                    text: Tr.t("ReExtractText");
                                    enabled: !root.uploading;
                                    clicked => { root.reprocess(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                SecondaryButton {
                                    text: Tr.t("Delete");
                                    clicked => { root.confirm-delete-open = true; }
                                }
                            }
                        }

                        if (root.preview-kind == "image") : Image {
                            source: root.preview;
                            height: 220px;
                            image-fit: contain;
                        }

                        if (root.preview-kind == "pdf") : Rectangle {
                            height: 120px;
                            border-radius: 8px;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.divider;

                            Rectangle {
                                width: 52px;
                                height: 66px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.divider;

                                Rectangle {
                                    x: 8px;
                                    y: 10px;
                                    width: parent.width - 16px;
                                    height: 3px;
                                    border-radius: 2px;
                                    background: Theme.muted-text;
                                }
                                Rectangle {
                                    x: 8px;
                                    y: 18px;
                                    width: parent.width - 16px;
                                    height: 3px;
                                    border-radius: 2px;
                                    background: Theme.muted-text;
                                }
                                Rectangle {
                                    x: 8px;
                                    y: parent.height - 18px;
                                    width: parent.width - 16px;
                                    height: 10px;
                                    border-radius: 2px;
                                    background: #E53935;
                                }
                            }
                        }

                        Text {
                            text: Tr.t("LinkedTransaction");
                            color: Theme.text;
                            font-size: Type.label-size;
                            font-weight: Type.label-weight;
                        }

                        if (root.selected-linked) : HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: root.selected-link-label;
                                horizontal-stretch: 1;
                                color: Theme.primary;
                                font-size: Type.body-size;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            TextButton {
                                min-width: 56px;
                                text: Tr.t("Unlink");
                                clicked => { root.unlink(); }
                            }
                        }

                        if (!root.selected-linked) : VerticalLayout {
                            spacing: 8px;

                            if (root.suggestions.length > 0) : Text {
                                text: Tr.t("SuggestedMatches");
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }

                            for suggestion in root.suggestions : LinkCandidateRow {
                                candidate: suggestion;
                                link(id) => { root.link(id); }
                            }

                            SearchField {
                                text: root.candidate-query;
                                placeholder: Tr.t("FindTransactionToLink");
                                edited(value) => { root.candidate-query-changed(value); }
                            }

                            if (root.candidate-query != "") : VerticalLayout {
                                spacing: 0px;
                                for candidate in root.candidates : LinkCandidateRow {
                                    candidate: candidate;
                                    link(id) => { root.link(id); }
                                }
                            }
                        }

                        Text {
                            text: root.selected-ocr-heading;
                            color: Theme.text;
                            font-size: Type.label-size;
                            font-weight: Type.label-weight;
                        }

                        Rectangle {
                            border-radius: 8px;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: Theme.divider;

                            VerticalLayout {
                                padding: 12px;

                                Text {
                                    text: root.selected-ocr-text == "" ? Tr.t("NoTextExtracted") : root.selected-ocr-text;
                                    color: Theme.text;
                                    font-size: Type.body-small-size;
                                    font-family: "monospace";
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (root.confirm-delete-open) : DeleteDocumentDialog {
        text: root.delete-text;
        close => { root.confirm-delete-open = false; }
        confirm => {
            root.confirm-delete-open = false;
            root.delete();
        }
    }
}

