import { ScrollView } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    Checkbox,
    ImportCsvField,
    ImportFileRow,
    OutlinedField,
    PrimaryButton,
    ReapplyGroupRow,
    SegmentedButton,
    SelectPill,
    TextButton,
} from "components.slint";

// A label-and-value line of the transaction detail dialog.
component DetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 8px;

    Text {
        width: 88px;
        text: root.label;
        color: Theme.text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        vertical-alignment: center;
    }

    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.text;
        font-size: Type.body-size;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

// The transaction detail dialog: amount, booking data, category, tax override, partner link and the
// bank-balance mismatch note. Attaching receipts and creating rules belong to the next task.
export component TransactionDetailDialog inherits Rectangle {
    in property <string> title;
    in property <string> amount-text;
    in property <bool> expense;
    in property <string> date-text;
    in property <string> account-text;
    in property <string> partner-text;
    in property <string> shop-text;
    in property <string> purpose-text;
    in-out property <int> category-index;
    in property <[string]> category-names;
    in property <bool> tax-relevant;
    in property <string> tax-state-text;
    in-out property <int> tax-index;
    in property <[string]> tax-options;
    in property <bool> has-mismatch;
    in property <string> mismatch-text;
    in property <bool> has-partner;
    in property <string> partner-link-text;
    in property <bool> can-create-rule;

    callback close;
    callback category-selected(int);
    callback tax-selected(int);
    callback show-partner;
    callback attach-receipt;
    callback create-rule;

    function category-value() -> string {
        return root.category-index >= 0 && root.category-index < root.category-names.length
                ? root.category-names[root.category-index] : "";
    }

    function tax-value() -> string {
        return root.tax-index >= 0 && root.tax-index < root.tax-options.length
                ? root.tax-options[root.tax-index] : "";
    }

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 560px;
        height: min(content.preferred-height, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Radius.dialog;

        ScrollView {
            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Type.headline-size;
                    font-weight: Type.headline-weight;
                    wrap: word-wrap;
                }

                Text {
                    text: root.amount-text;
                    color: root.expense ? Theme.error : Theme.success;
                    font-size: Type.headline-size;
                    font-weight: Type.headline-weight;
                }

                DetailRow { label: Tr.t("DetailDate"); value: root.date-text; }
                DetailRow { label: Tr.t("DetailAccount"); value: root.account-text; }
                if (root.partner-text != "") : DetailRow { label: Tr.t("DetailPartner"); value: root.partner-text; }
                if (root.shop-text != "") : DetailRow { label: Tr.t("DetailShop"); value: root.shop-text; }
                if (root.purpose-text != "") : DetailRow { label: Tr.t("DetailPurpose"); value: root.purpose-text; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    SelectPill {
                        label-prefix: Tr.t("DetailCategory") + ": ";
                        value: root.category-value();
                        options: root.category-names;
                        chosen(index) => { root.category-selected(index); }
                    }

                    if (root.tax-relevant) : Rectangle {
                        height: 22px;
                        border-radius: Radius.tag;
                        background: Theme.warning-pale;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            Text {
                                text: Tr.t("TaxRelevant");
                                color: Theme.warning-strong;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    SelectPill {
                        label-prefix: Tr.t("TaxMenu") + ": ";
                        value: root.tax-value();
                        options: root.tax-options;
                        chosen(index) => { root.tax-selected(index); }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.tax-state-text;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                if (root.has-mismatch) : Rectangle {
                    background: Theme.background;
                    border-radius: Radius.panel;
                    border-width: 1px;
                    border-color: Theme.warning;

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Image {
                            width: 20px;
                            height: 20px;
                            source: @image-url("icons/warning.svg");
                            colorize: Theme.warning;
                            accessible-role: none;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.mismatch-text;
                            color: Theme.text;
                            font-size: Type.body-small-size;
                            wrap: word-wrap;
                        }
                    }
                }

                if (root.has-partner) : TextButton {
                    text: root.partner-link-text;
                    clicked => { root.show-partner(); }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    TextButton {
                        text: Tr.t("AttachReceiptEllipsis");
                        clicked => { root.attach-receipt(); }
                    }

                    if (root.can-create-rule) : TextButton {
                        text: Tr.t("CreateRule");
                        clicked => { root.create-rule(); }
                    }

                    TextButton {
                        text: Tr.t("Close");
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }
}

// The add-booking dialog, including the account, direction, date, amount, partner and category.
export component AddTransactionDialog inherits Rectangle {
    in property <string> initial-date;
    in property <int> initial-account-index;
    in property <[string]> accounts;
    in property <[string]> category-names;
    in property <string> amount-label;
    in property <string> error-text;
    in property <bool> focus-amount: false;

    callback close;
    callback submit(int, bool, string, string, string, string, int);

    property <int> account-index: 0;
    property <bool> is-expense: true;
    property <string> date-text: "";
    property <string> amount-text: "";
    property <string> partner-text: "";
    property <string> purpose-text: "";
    property <int> category-index: 0;

    init => {
        root.account-index = root.initial-account-index;
        root.date-text = root.initial-date;
        root.is-expense = true;
        root.amount-text = "";
        root.partner-text = "";
        root.purpose-text = "";
        root.category-index = 0;
        if (root.focus-amount) {
            amount-field.focus-input();
        }
    }

    changed focus-amount => {
        if (root.focus-amount) {
            amount-field.focus-input();
        }
    }

    function account-value() -> string {
        return root.account-index >= 0 && root.account-index < root.accounts.length
                ? root.accounts[root.account-index] : "";
    }

    function category-value() -> string {
        return root.category-index >= 0 && root.category-index < root.category-names.length
                ? root.category-names[root.category-index] : "";
    }

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 500px;
        height: min(content.preferred-height, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Radius.dialog;

        ScrollView {
            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: Tr.t("AddTransaction");
                    color: Theme.text;
                    font-size: Type.headline-size;
                    font-weight: Type.headline-weight;
                }

                HorizontalLayout {
                    alignment: start;

                    SelectPill {
                        value: root.account-value();
                        options: root.accounts;
                        chosen(index) => { root.account-index = index; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    SegmentedButton {
                        labels: [Tr.t("Expense"), Tr.t("Income")];
                        selected: root.is-expense ? 0 : 1;
                        select(index) => { root.is-expense = index == 0; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    OutlinedField {
                        horizontal-stretch: 1;
                        label: Tr.t("DateFormat");
                        text <=> root.date-text;
                    }

                    amount-field := OutlinedField {
                        horizontal-stretch: 1;
                        label: root.amount-label;
                        text <=> root.amount-text;
                    }
                }

                OutlinedField {
                    label: Tr.t("PartnerPayee");
                    text <=> root.partner-text;
                }

                OutlinedField {
                    label: Tr.t("Purpose");
                    text <=> root.purpose-text;
                }

                HorizontalLayout {
                    alignment: start;

                    SelectPill {
                        value: root.category-value();
                        options: root.category-names;
                        chosen(index) => { root.category-index = index; }
                    }
                }

                if (root.error-text != "") : Text {
                    text: root.error-text;
                    color: Theme.error;
                    font-size: Type.body-size;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    TextButton {
                        text: Tr.t("Cancel");
                        clicked => { root.close(); }
                    }

                    PrimaryButton {
                        text: Tr.t("Add");
                        enabled: root.date-text != ""
                            && root.amount-text != ""
                            && (root.partner-text != "" || root.purpose-text != "");
                        clicked => {
                            root.submit(
                                root.account-index,
                                root.is-expense,
                                root.date-text,
                                root.amount-text,
                                root.partner-text,
                                root.purpose-text,
                                root.category-index,
                            );
                        }
                    }
                }
            }
        }
    }
}

// The batch-delete confirmation: the captured date range, per-currency totals, the first bookings
// and the warning that a later sync can bring deleted bookings back.
export component MultiDeleteDialog inherits Rectangle {
    in property <string> title;
    in property <string> range-text;
    in property <string> totals-text;
    in property <[string]> booking-lines;
    in property <string> more-text;

    callback confirm;
    callback cancel;

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 560px;
        height: min(content.preferred-height, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Radius.dialog;

        ScrollView {
            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Type.headline-size;
                    font-weight: Type.headline-weight;
                    wrap: word-wrap;
                }

                Text {
                    text: root.range-text;
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                if (root.totals-text != "") : Text {
                    text: root.totals-text;
                    color: Theme.muted-text;
                    font-size: Type.body-size;
                }

                for line in root.booking-lines : Text {
                    text: line;
                    color: Theme.text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                if (root.more-text != "") : Text {
                    text: root.more-text;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                }

                Text {
                    text: Tr.t("DeleteSyncedHint");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    TextButton {
                        text: Tr.t("Cancel");
                        clicked => { root.cancel(); }
                    }

                    PrimaryButton {
                        text: Tr.t("Delete");
                        destructive: true;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}

// The statement import preview: the selected files, the account, the CSV columns and the balance
// option, plus the files that could not be read.
export component ImportDialog inherits Rectangle {
    in property <string> title;
    in property <string> summary-text;
    in property <[ImportFileRow]> file-rows;
    in property <[ImportCsvField]> csv-fields;
    in property <string> csv-hint;
    in property <[string]> account-options;
    in-out property <int> account-index;
    in property <bool> balance-allowed;
    in-out property <bool> update-balance;
    in property <string> balance-text;
    in property <string> newer-text;
    in property <bool> importing;
    in property <string> confirm-text;
    in property <bool> confirm-enabled;

    callback close;
    callback confirm(bool);
    callback account-selected(int);
    callback csv-changed(string, string);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 720px;
        height: min(body.preferred-height + footer.preferred-height + 64px, parent.height - 32px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Radius.dialog;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            ScrollView {
                vertical-stretch: 1;

                body := VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Type.headline-size;
                        font-weight: Type.headline-weight;
                        wrap: word-wrap;
                    }

                if (root.summary-text != "") : Text {
                    text: root.summary-text;
                    color: Theme.text;
                    font-size: Type.body-size;
                }

                VerticalLayout {
                    spacing: 0px;

                    for file in root.file-rows : Rectangle {
                        height: 30px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 10px;

                            Text {
                                horizontal-stretch: 2;
                                text: file.name;
                                color: file.failure ? Theme.error : Theme.text;
                                font-size: Type.body-small-size;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: 90px;
                                text: file.count-text;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            Text {
                                width: 150px;
                                text: file.period-text;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: file.warning-text;
                                color: Theme.error;
                                font-size: Type.body-small-size;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;

                    SelectPill {
                        label-prefix: Tr.t("IntoAccount");
                        value: root.account-index >= 0 && root.account-index < root.account-options.length
                                ? root.account-options[root.account-index] : "";
                        options: root.account-options;
                        chosen(index) => {
                            root.account-index = index;
                            root.account-selected(index);
                        }
                    }
                }

                if (root.csv-fields.length > 0) : VerticalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: Tr.t("Columns");
                        color: Theme.text;
                        font-size: Type.title-small-size;
                        font-weight: Type.title-small-weight;
                    }

                    if (root.csv-hint != "") : Text {
                        text: root.csv-hint;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                    }

                    GridLayout {
                        spacing: 8px;
                        padding-top: 2px;

                        for field[index] in root.csv-fields : SelectPill {
                            row: Math.floor(index / 2);
                            col: Math.mod(index, 2);
                            // Two equal columns inside the dialog: long column names elide (the full
                            // text is the accessible label) instead of pushing the grid past the edge.
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 1;
                            label-prefix: field.label + ": ";
                            value: field.index >= 0 && field.index < field.options.length
                                    ? field.options[field.index] : "";
                            options: field.options;
                            chosen(option-index) => {
                                root.csv-changed(field.field, field.options[option-index]);
                            }
                        }
                    }
                }

                if (root.balance-allowed) : Checkbox {
                    checked <=> root.update-balance;
                    text: root.balance-text;
                }

                if (root.newer-text != "") : Text {
                    text: root.newer-text;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                Text {
                    text: Tr.t("BookingsSkippedHint");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
            }
            }

            footer := HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    enabled: !root.importing;
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: root.confirm-text;
                    enabled: root.confirm-enabled && !root.importing;
                    clicked => { root.confirm(root.update-balance); }
                }
            }
        }
    }
}

// The re-apply rules preview: one checkbox per category change, all ticked by default.
export component ReapplyRulesDialog inherits Rectangle {
    in property <string> summary-text;
    in property <string> warning-text;
    in property <[ReapplyGroupRow]> groups;
    in property <string> confirm-text;
    in property <bool> confirm-enabled;

    callback cancel;
    callback confirm;
    callback toggle(int, int);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 560px;
        height: min(content.preferred-height, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Radius.dialog;

        ScrollView {
            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: Tr.t("ReapplyRulesTitle");
                    color: Theme.text;
                    font-size: Type.headline-size;
                    font-weight: Type.headline-weight;
                }

                Text {
                    text: root.summary-text;
                    color: Theme.text;
                    font-size: Type.body-size;
                    wrap: word-wrap;
                }

                Text {
                    text: root.warning-text;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                for group in root.groups : HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    Checkbox {
                        width: 40px;
                        checked: group.ticked;
                        toggled => { root.toggle(group.from-id, group.to-id); }
                    }

                    VerticalLayout {
                        spacing: 2px;

                        Text {
                            text: group.title;
                            color: Theme.text;
                            font-size: Type.body-size;
                            wrap: word-wrap;
                        }

                        Text {
                            text: group.detail;
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    TextButton {
                        text: Tr.t("Cancel");
                        clicked => { root.cancel(); }
                    }

                    PrimaryButton {
                        text: root.confirm-text;
                        enabled: root.confirm-enabled;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}

// The period menu's custom From/To range dialog.
export component CustomRangeDialog inherits Rectangle {
    in property <string> initial-from;
    in property <string> initial-to;
    in property <string> error-text;

    callback close;
    callback apply(string, string);

    property <string> from-text: "";
    property <string> to-text: "";

    init => {
        root.from-text = root.initial-from;
        root.to-text = root.initial-to;
    }

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 420px;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Radius.dialog;

        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: Tr.t("CustomRange");
                color: Theme.text;
                font-size: Type.headline-size;
                font-weight: Type.headline-weight;
            }

            HorizontalLayout {
                spacing: 8px;

                OutlinedField {
                    horizontal-stretch: 1;
                    label: Tr.t("FromDate");
                    text <=> root.from-text;
                }

                OutlinedField {
                    horizontal-stretch: 1;
                    label: Tr.t("ToDate");
                    text <=> root.to-text;
                }
            }

            if (root.error-text != "") : Text {
                text: root.error-text;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: Tr.t("Apply");
                    enabled: root.from-text != "" && root.to-text != "";
                    clicked => { root.apply(root.from-text, root.to-text); }
                }
            }
        }
    }
}

// The amount-range menu, as a small modal with the two bound fields and a reset action.
export component AmountFilterDialog inherits Rectangle {
    in property <string> initial-min;
    in property <string> initial-max;
    in property <string> min-label;
    in property <string> max-label;
    in property <string> error-text;

    callback close;
    callback apply(string, string);
    callback reset;

    property <string> min-text: "";
    property <string> max-text: "";

    init => {
        root.min-text = root.initial-min;
        root.max-text = root.initial-max;
    }

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 420px;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Radius.dialog;

        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: Tr.t("AmountFilterAny");
                color: Theme.text;
                font-size: Type.headline-size;
                font-weight: Type.headline-weight;
            }

            OutlinedField {
                label: root.min-label;
                text <=> root.min-text;
            }

            OutlinedField {
                label: root.max-label;
                text <=> root.max-text;
            }

            if (root.error-text != "") : Text {
                text: root.error-text;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => { root.close(); }
                }

                TextButton {
                    text: Tr.t("Reset");
                    clicked => { root.reset(); }
                }

                PrimaryButton {
                    text: Tr.t("Apply");
                    clicked => { root.apply(root.min-text, root.max-text); }
                }
            }
        }
    }
}
