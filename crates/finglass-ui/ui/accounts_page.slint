import { ListView, ScrollView, Spinner } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    AccountDaysChoice,
    AccountDetailRow,
    AccountsBankCard,
    AccountTypeChoice,
    AccountsFigure,
    AccountTone,
    BankAccountRow,
    BankBadge,
    BankMenuItem,
    CountBadge,
    IconButton,
    OutlinedField,
    PrimaryButton,
    SecondaryButton,
    SegmentedButton,
    SelectPill,
    TextButton,
} from "components.slint";
import { BankSuggestionRow } from "models.slint";

// One entry of a bank card's menu, with a 24 px leading slot and a check mark for the active choice.
component BankMenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> highlighted: false;
    in property <string> icon-name;

    callback picked;

    function icon-source(name: string) -> image {
        if (name == "date_range") { return @image-url("icons/date_range.svg"); }
        if (name == "check") { return @image-url("icons/check.svg"); }
        if (name == "edit") { return @image-url("icons/edit.svg"); }
        if (name == "settings") { return @image-url("icons/settings.svg"); }
        if (name == "delete") { return @image-url("icons/delete.svg"); }
        if (name == "history") { return @image-url("icons/history.svg"); }
        if (name == "lock") { return @image-url("icons/lock.svg"); }
        return @image-url("icons/edit.svg");
    }

    height: max(48px, content.preferred-height + 24px);
    background: root.highlighted && root.enabled ? Theme.selected
            : (touch.has-hover && root.enabled ? Theme.background : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checked: root.checked;

    content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 24px;
            height: 24px;
            background: transparent;

            if (root.icon-name != "" && (root.icon-name != "check" || root.checked)) : Image {
                width: 24px;
                height: 24px;
                source: root.icon-source(root.icon-name);
                colorize: !root.enabled ? Theme.muted-text : (root.danger ? Theme.error : Theme.text);
                // Material dims disabled content to 38 %: the muted colour alone reads as enabled in dark mode.
                opacity: root.enabled ? 1.0 : 0.38;
                accessible-role: none;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: !root.enabled ? Theme.muted-text : (root.danger ? Theme.error : Theme.text);
            // Material dims disabled content to 38 %: the muted colour alone reads as enabled in dark mode.
            opacity: root.enabled ? 1.0 : 0.38;
            font-size: Type.body-size;
            font-weight: Type.body-weight;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.picked();
            }
        }
    }
}

// A labelled group of figures in the page header.
component FigureView inherits VerticalLayout {
    in property <AccountsFigure> figure;

    spacing: 2px;
    alignment: start;

    Text {
        text: root.figure.label;
        color: Theme.muted-text;
        font-size: Type.label-small-size;
        font-weight: Type.label-small-weight;
        overflow: elide;
    }

    // The currencies sit on one line, separated by a middle dot, never stacked.
    HorizontalLayout {
        spacing: 8px;

        for amount[index] in root.figure.values : HorizontalLayout {
            spacing: 8px;

            if (index > 0) : Text {
                text: "·";
                color: Theme.muted-text;
                font-size: Type.amount-size;
                font-weight: Type.amount-weight;
                vertical-alignment: center;
            }

            Text {
                text: amount.text;
                color: root.figure.secondary ? Theme.muted-text
                        : (amount.tone == "negative" ? Theme.alert : Theme.text);
                font-size: Type.amount-size;
                font-weight: Type.amount-weight;
                overflow: elide;
            }
        }
    }
}

// A centred dialog card on a dimmed background.
component ModalCard inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 480px;
    in property <length> dialog-max-height: 688px;

    width: root.dialog-width;
    height: min(content.preferred-height, root.dialog-max-height);
    background: Theme.surface;
    border-radius: Radius.dialog;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;

    ScrollView {
        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
                wrap: word-wrap;
            }

            @children
        }
    }
}

// The account-type drop-down: FinDesk shows it as an outlined pill with the type's own name.
component TypeSelectPill inherits Rectangle {
    in property <[AccountTypeChoice]> choices;
    in property <string> code;
    in property <bool> enabled: true;

    callback chosen(string);

    property <bool> menu-open: false;
    property <int> hover: 0;

    function label-for-code(code: string) -> string {
        if (code == "checking" && root.choices.length > 0) { return root.choices[0].label; }
        if (code == "savings" && root.choices.length > 1) { return root.choices[1].label; }
        if (code == "credit_card" && root.choices.length > 2) { return root.choices[2].label; }
        if (code == "loan" && root.choices.length > 3) { return root.choices[3].label; }
        if (code == "depot" && root.choices.length > 4) { return root.choices[4].label; }
        return code;
    }

    function open-menu() {
        if (root.enabled && root.choices.length > 0) {
            root.hover = 0;
            root.menu-open = true;
            menu.show();
            focus.focus();
        }
    }

    function close-menu() {
        root.menu-open = false;
        menu.close();
    }

    function choose(index: int) {
        if (index >= 0 && index < root.choices.length) {
            root.close-menu();
            root.chosen(root.choices[index].code);
        }
    }

    height: 40px;
    min-width: content.preferred-width;
    border-radius: Radius.control;
    background: touch.has-hover && root.enabled ? Theme.background : Theme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.primary : Theme.divider;
    opacity: root.enabled ? 1.0 : 0.55;
    accessible-role: button;
    accessible-enabled: root.enabled;

    content := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 6px;
        cross-axis-alignment: center;

        Text {
            text: root.label-for-code(root.code);
            color: Theme.text;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            vertical-alignment: center;
            overflow: elide;
        }

        Image {
            width: 18px;
            height: 18px;
            source: @image-url("icons/arrow_drop_down.svg");
            colorize: Theme.muted-text;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.open-menu(); }
    }

    focus := FocusScope {
        enabled <=> root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (!root.menu-open) {
                if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                    root.open-menu();
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.Escape) {
                root.close-menu();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.hover = min(root.hover + 1, root.choices.length - 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.hover = max(root.hover - 1, 0);
                return accept;
            }
            if (event.text == Key.Return) {
                root.choose(root.hover);
                return accept;
            }
            return reject;
        }
    }

    menu := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 220px);
        height: min(max(root.choices.length * 36px, 36px), 320px);

        Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            ListView {
                for choice[index] in root.choices : Rectangle {
                    height: 36px;
                    background: choice.code == root.code || index == root.hover || row-touch.has-hover
                            ? Theme.background : transparent;

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: choice.label;
                        color: choice.code == root.code || index == root.hover ? Theme.primary : Theme.text;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-touch := TouchArea {
                        clicked => { root.choose(index); }
                    }
                }
            }
        }
    }
}

// One clickable bank suggestion, with the BLZ/city/BIC that disambiguate branches.
component BankSuggestionView inherits Rectangle {
    in property <BankSuggestionRow> suggestion;

    callback picked;

    height: suggestion-layout.preferred-height + 12px;
    border-radius: Radius.small;
    background: hover.has-hover ? Theme.selected : transparent;

    suggestion-layout := VerticalLayout {
        padding: 6px;
        spacing: 1px;
        alignment: start;

        Text {
            text: root.suggestion.name;
            color: Theme.text;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            overflow: elide;
        }

        Text {
            text: root.suggestion.detail;
            color: Theme.muted-text;
            font-size: Type.body-small-size;
            overflow: elide;
        }
    }

    hover := TouchArea {
        clicked => {
            root.picked();
        }
    }
}

// One account inside a bank card, with its inline action strip.
component BankAccountView inherits Rectangle {
    in property <BankAccountRow> account;

    callback open-detail;
    callback open-transactions;
    callback rename-account;
    callback edit-balance;
    callback forget-deleted;
    callback delete-account;

    property <bool> menu-open: false;
    property <string> transactions-label: Tr.t("ShowTransactions");
    property <string> more-label: Tr.t("More");

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 52px;
            background: touch.has-hover ? Theme.background : transparent;

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.menu-open = false;
                    root.open-detail();
                }
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                cross-axis-alignment: center;

                BankBadge {
                    logo: root.account.logo;
                    letters: root.account.logo-letters;
                    colour-index: root.account.logo-colour;
                    size: 24px;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.account.name;
                        color: Theme.text;
                        font-size: Type.label-size;
                        font-weight: Type.label-weight;
                        overflow: elide;
                    }

                    Text {
                        text: root.account.subtitle;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        overflow: elide;
                    }
                }

                // The badge has its own column so it can never sit on top of the amount.
                VerticalLayout {
                    width: 20px;
                    alignment: center;

                    CountBadge {
                        count: root.account.new-count;
                        selected: false;
                    }
                }

                Text {
                    text: root.account.balance-text;
                    color: AccountTone.amount-color(root.account.tone);
                    font-size: Type.body-size;
                    font-weight: Type.title-small-weight;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Radius.icon;
                    background: list-icon.has-hover ? Theme.divider : transparent;
                    accessible-role: button;
                    accessible-label: root.transactions-label;

                    Text {
                        text: "☰";
                        color: Theme.muted-text;
                        font-size: Type.body-size;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    list-icon := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.menu-open = false;
                            root.open-transactions();
                        }
                    }

                    Tooltip {
                        text: @markdown("\{root.transactions-label}");
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Radius.icon;
                    background: dot.has-hover ? Theme.divider : transparent;
                    accessible-role: button;
                    accessible-label: root.more-label;

                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/more_vert.svg");
                        colorize: Theme.muted-text;
                        accessible-role: none;
                    }

                    dot := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.menu-open = !root.menu-open;
                        }
                    }

                    Tooltip {
                        text: @markdown("\{root.more-label}");
                    }
                }
            }
        }

        if (root.menu-open) : Rectangle {
            height: actions.preferred-height;
            background: Theme.background;

            actions := HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 10px;
                alignment: start;

                TextButton {
                    text: Tr.t("MenuDetails");
                    clicked => {
                        root.menu-open = false;
                        root.open-detail();
                    }
                }

                TextButton {
                    text: Tr.t("RenameAccount");
                    clicked => {
                        root.menu-open = false;
                        root.rename-account();
                    }
                }

                TextButton {
                    text: Tr.t("EditBalance");
                    clicked => {
                        root.menu-open = false;
                        root.edit-balance();
                    }
                }

                TextButton {
                    text: Tr.t("AllowDeletedAgain");
                    clicked => {
                        root.menu-open = false;
                        root.forget-deleted();
                    }
                }

                TextButton {
                    text: Tr.t("DeleteAccount");
                    clicked => {
                        root.menu-open = false;
                        root.delete-account();
                    }
                }
            }
        }
    }
}

// One bank connection (or the accounts without a bank) with its account rows.
component BankCardView inherits Rectangle {
    in property <AccountsBankCard> card;
    in property <bool> sync-controls-visible: false;

    callback toggle;
    callback add-account;
    callback remove-bank;
    callback sync;
    callback menu-toggle;
    callback menu-anchor(length, length);
    callback open-detail(int);
    callback open-transactions(int);
    callback open-rename(int);
    callback open-balance(int);
    callback forget-deleted(int);
    callback delete-account(int);

    in property <bool> menu-open: false;
    property <string> chevron-label: root.card.collapsed ? Tr.t("Expand") : Tr.t("Collapse");
    height: card-content.preferred-height;
    background: Theme.surface;
    border-radius: Radius.surface;
    border-width: 1px;
    border-color: Theme.divider;

    // The page anchors its floating menu to the real ⋮ button below.
    changed menu-open => {
        if (root.menu-open && root.card.bank-id >= 0) {
            root.menu-anchor(
                menu-button.absolute-position.x + menu-button.width,
                menu-button.absolute-position.y + menu-button.height,
            );
        }
    }

    card-content := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            if (root.card.bank-id < 0) : Rectangle {
                // The accounts-without-a-bank card has no chevron; keep its title aligned with
                // the bank names above by reserving the chevron's slot.
                width: 24px;
                background: transparent;
            }

            if (root.card.bank-id >= 0) : Rectangle {
                width: 24px;
                height: 24px;
                border-radius: Radius.icon;
                background: chevron.has-hover ? Theme.divider : transparent;
                accessible-role: button;
                accessible-label: root.chevron-label;

                Image {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.card.collapsed ? @image-url("icons/keyboard_arrow_right.svg") : @image-url("icons/keyboard_arrow_down.svg");
                    colorize: Theme.muted-text;
                    accessible-role: none;
                }

                chevron := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle();
                    }
                }

                Tooltip {
                    text: @markdown("\{root.chevron-label}");
                }
            }

            BankBadge {
                logo: root.card.logo;
                letters: root.card.logo-letters;
                colour-index: root.card.logo-colour;
                size: 32px;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: root.card.name;
                        color: Theme.text;
                        font-size: Type.title-medium-size;
                        font-weight: Type.title-medium-weight;
                        overflow: elide;
                        // As FinDesk: the count and total follow the name; a long name elides first.
                        min-width: 0px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.card.account-count-text;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        font-weight: Type.body-small-weight;
                        vertical-alignment: center;
                    }

                    for amount in root.card.totals : Text {
                        text: amount.text;
                        color: AccountTone.amount-color(amount.tone);
                        font-size: Type.label-small-size;
                        font-weight: Type.label-small-weight;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                if (root.card.subtitle != "") : Text {
                    text: root.card.subtitle;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    overflow: elide;
                }

                if (root.card.central-blz-hint != "") : Text {
                    text: root.card.central-blz-hint;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    overflow: elide;
                }
            }

            if (root.card.syncing) : Spinner {
                width: 18px;
                height: 18px;
            }

            if (root.card.syncing) : Text {
                text: root.card.sync-step;
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                vertical-alignment: center;
            }

            if (root.card.bank-id >= 0 && !root.card.offline && !root.card.syncing && root.sync-controls-visible) : SecondaryButton {
                text: Tr.t("Sync");
                icon: @image-url("icons/refresh.svg");
                has-icon: true;
                enabled: root.card.sync-enabled;
                tooltip-text: root.card.sync-tooltip;
                clicked => {
                    root.sync();
                }
            }

            if (root.card.bank-id >= 0) : TextButton {
                text: Tr.t("AddAccountShort");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                clicked => {
                    root.add-account();
                }
            }

            menu-button := IconButton {
                visible: root.card.bank-id >= 0;
                icon: @image-url("icons/more_vert.svg");
                label: Tr.t("More");
                tooltip-text: Tr.t("More");
                filled: true;
                clicked => {
                    root.menu-toggle();
                }
            }
        }

        if (!root.card.collapsed) : Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        if (!root.card.collapsed) : VerticalLayout {
            spacing: 0px;

            if (root.card.accounts.length == 0) : Text {
                text: Tr.t("NoAccountsYet");
                color: Theme.muted-text;
                font-size: Type.body-size;
            }

            for account in root.card.accounts : BankAccountView {
                account: account;
                open-detail => {
                    root.open-detail(account.account-id);
                }
                open-transactions => {
                    root.open-transactions(account.account-id);
                }
                rename-account => {
                    root.open-rename(account.account-id);
                }
                edit-balance => {
                    root.open-balance(account.account-id);
                }
                forget-deleted => {
                    root.forget-deleted(account.account-id);
                }
                delete-account => {
                    root.delete-account(account.account-id);
                }
            }
        }
    }
}

// The empty accounts page: no bank and no account yet.
component EmptyAccounts inherits Rectangle {
    callback add-bank;

    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 64px;
                height: 56px;
                background: transparent;

                Path {
                    commands: "M 8 24 L 32 8 L 56 24 Z M 14 24 L 14 48 L 20 48 L 20 24 Z M 26 24 L 26 48 L 32 48 L 32 24 Z M 38 24 L 38 48 L 44 48 L 44 24 Z M 50 24 L 50 48 L 56 48 L 56 24 Z M 8 48 L 56 48 L 56 54 L 8 54 Z";
                    fill: Theme.muted-text;
                }
            }
        }

        Text {
            text: Tr.t("NoBanksYet");
            color: Theme.text;
            font-size: Type.title-large-size;
            font-weight: Type.title-large-weight;
            horizontal-alignment: center;
        }

        Text {
            width: 620px;
            text: Tr.t("NoBanksDescription");
            color: Theme.muted-text;
            font-size: Type.body-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;

            PrimaryButton {
                width: 150px;
                text: Tr.t("AddBank");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                clicked => {
                    root.add-bank();
                }
            }
        }
    }
}

// The Accounts page: the header figures and the bank cards across the full width.
export component AccountsPage inherits Rectangle {
    in property <bool> loading;
    in property <bool> show-content;
    in property <bool> has-content;
    in property <string> error-text;
    in property <string> message-text;
    in property <bool> banking-busy: false;

    in property <[AccountsFigure]> figures;
    in property <[AccountsBankCard]> bank-cards;

    in property <string> sync-all-progress;
    in property <bool> sync-all-visible;
    in property <bool> sync-all-enabled;
    // Whether the per-bank and Sync all buttons are shown; false while online sync is unavailable.
    in property <bool> sync-controls-visible;
    // The neutral note and the disabled Sync tooltip while online sync is not available yet.
    in property <string> online-sync-note;
    in-out property <int> bank-menu-open: -2;

    in property <[AccountTypeChoice]> type-choices;
    in property <[string]> currency-codes;
    in property <[AccountDaysChoice]> days-choices;
    in property <[string]> day-labels;

    in property <string> dialog;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <string> dialog-account-label;
    in property <string> dialog-account-name;
    in property <string> dialog-balance;
    in property <string> dialog-error;
    in property <string> dialog-account-type;
    in property <bool> dialog-offline;
    in-out property <bool> dialog-online;
    in property <int> dialog-bank-id;
    in property <int> dialog-account-id;
    in-out property <string> connection-name;
    in-out property <string> connection-blz;
    in-out property <string> connection-user-id;
    in-out property <string> connection-server-url;
    in property <string> connection-pin-text;
    in property <bool> connection-has-pin;
    in property <bool> connection-syncing;
    in-out property <string> history-date;
    in property <bool> history-has-start;

    in property <bool> detail-open;
    in property <string> detail-title;
    in property <string> detail-logo;
    in property <string> detail-letters;
    in property <int> detail-colour;
    in property <string> detail-subtitle;
    in property <string> detail-balance;
    in property <string> detail-tone;
    in property <int> detail-account-id;
    in property <int> detail-days;
    in property <string> detail-summary;
    in property <string> detail-path;
    in property <string> detail-axis-top;
    in property <string> detail-axis-bottom;
    in property <float> detail-end-x;
    in property <float> detail-end-y;
    in property <string> detail-end-label;
    in property <[AccountDetailRow]> detail-rows;

    callback open-add-bank;
    callback bank-search-changed(string);
    callback pick-bank-suggestion(string, string, string);
    callback bank-blz-changed(string, string, string);
    callback close-dialog;
    callback submit-add-bank(string);
    callback submit-add-online-bank(string, string, string, string, string);
    callback submit-connection(int, string, string, string, string);
    callback forget-pin(int);
    callback submit-history(int, string);
    callback clear-history(int);
    callback sync-all;
    callback bank-menu(int, string);
    callback open-add-account(int);
    callback submit-add-account(int, string, string, string, string, string);
    callback open-balance(int);
    callback submit-balance(int, string, string);
    callback open-rename(int);
    callback submit-rename(int, string);
    callback open-delete-account(int);
    callback confirm-delete-account(int);
    callback open-delete-bank(int);
    callback confirm-delete-bank(int);
    callback close-detail;
    callback select-days(int, int);
    callback toggle-bank(int);
    callback forget-deleted(int);
    callback dismiss-message;
    callback open-detail(int);
    callback open-transactions(int);

    in-out property <string> add-bank-name: "";
    in-out property <string> add-bank-blz: "";
    in-out property <string> add-bank-bic: "";
    in-out property <string> add-bank-search: "";
    in property <[BankSuggestionRow]> add-bank-suggestions;
    in property <string> add-bank-central-note;
    property <string> add-bank-user-id: "";
    property <string> add-bank-server-url: "";
    property <string> add-account-name: "";
    property <string> add-account-identifier: "";
    property <string> add-account-balance: "0";
    property <string> form-type-code: "checking";
    property <string> form-currency: "EUR";
    property <string> balance-input;
    property <string> balance-type-code: "checking";
    property <string> rename-input;

    property <[BankMenuItem]> open-menu-items;
    property <length> bank-menu-x;
    property <length> bank-menu-y;
    property <bool> bank-menu-navigated: false;
    property <int> bank-menu-selected: 0;

    function open-bank-menu(bank_id: int, items: [BankMenuItem], right: length, bottom: length) {
        root.open-menu-items = items;
        root.bank-menu-x = max(0px, min(right - root.absolute-position.x - 300px, root.width - 308px));
        // Prefer below the ⋮ button, flip above when the page is short, then clamp so the whole
        // menu stays inside the page instead of being cut off at the window edge.
        if (bottom - root.absolute-position.y + 4px + (items.length * 48px + 16px) <= root.height) {
            root.bank-menu-y = bottom - root.absolute-position.y + 4px;
        } else if (bottom - root.absolute-position.y - 44px - (items.length * 48px + 16px) >= 0px) {
            root.bank-menu-y = bottom - root.absolute-position.y - 44px - (items.length * 48px + 16px);
        } else {
            root.bank-menu-y = max(0px, root.height - (items.length * 48px + 16px) - 8px);
        }
        root.bank-menu-selected = 0;
        root.bank-menu-navigated = false;
        root.bank-menu-open = bank_id;
        menu-focus.focus();
    }

    function close-bank-menu() {
        root.bank-menu-open = -2;
    }

    function bank-menu-count() -> int {
        return root.open-menu-items.length;
    }

    function bank-menu-item-enabled(index: int) -> bool {
        if (index < 0 || index >= root.open-menu-items.length) {
            return false;
        }
        return root.open-menu-items[index].enabled;
    }

    function activate-bank-menu(index: int) {
        if (!root.bank-menu-item-enabled(index)) {
            return;
        }
        root.bank-menu(root.bank-menu-open, root.open-menu-items[index].action);
        root.close-bank-menu();
    }

    changed dialog => {
        root.add-bank-name = "";
        root.add-bank-blz = "";
        root.add-bank-bic = "";
        root.add-bank-search = "";
        root.add-bank-user-id = "";
        root.add-bank-server-url = "";
        root.add-account-name = "";
        root.add-account-identifier = "";
        root.add-account-balance = "0";
        root.form-type-code = root.dialog-account-type;
        root.form-currency = "EUR";
        root.balance-input = root.dialog-balance;
        root.balance-type-code = root.dialog-account-type;
        root.rename-input = root.dialog-account-name;
    }

    // The adapter sets the values before it opens the dialog; these handlers also fill the forms when a
    // caller sets only the value (for example the screenshot test).
    changed dialog-account-type => {
        root.form-type-code = root.dialog-account-type;
        root.balance-type-code = root.dialog-account-type;
    }

    changed dialog-balance => {
        root.balance-input = root.dialog-balance;
    }

    changed dialog-account-name => {
        root.rename-input = root.dialog-account-name;
    }

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        if (root.show-content) : HorizontalLayout {
            spacing: 32px;

            for figure in root.figures : FigureView {
                figure: figure;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            if (root.sync-all-visible && root.sync-controls-visible) : HorizontalLayout {
                spacing: 12px;
                alignment: center;

                if (root.sync-all-progress != "") : Spinner {
                    width: 18px;
                    height: 18px;
                }

                if (root.sync-all-progress != "") : Text {
                    text: root.sync-all-progress;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    vertical-alignment: center;
                }

                if (root.sync-all-progress == "") : SecondaryButton {
                    text: Tr.t("SyncAll");
                    icon: @image-url("icons/refresh.svg");
                    has-icon: true;
                    enabled: root.sync-all-enabled;
                    tooltip-text: root.online-sync-note;
                    clicked => {
                        root.sync-all();
                    }
                }
            }

            PrimaryButton {
                text: Tr.t("AddBank");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                enabled: !root.banking-busy;
                clicked => {
                    root.open-add-bank();
                }
            }
        }

        if (root.online-sync-note != "") : Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: Theme.divider;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                cross-axis-alignment: center;

                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("icons/info.svg");
                    colorize: Theme.muted-text;
                    accessible-role: none;
                }

                Text {
                    text: root.online-sync-note;
                    color: Theme.muted-text;
                    font-size: Type.body-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        if (root.error-text != "" || root.message-text != "") : Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: root.error-text != "" ? Theme.error : Theme.success;

            HorizontalLayout {
                padding: 12px;
                padding-right: 4px;
                spacing: 12px;

                Image {
                    width: 20px;
                    height: 20px;
                    source: root.error-text != "" ? @image-url("icons/warning.svg") : @image-url("icons/check_circle.svg");
                    colorize: root.error-text != "" ? Theme.error : Theme.success;
                    accessible-role: none;
                }

                Text {
                    text: root.error-text != "" ? root.error-text : root.message-text;
                    color: root.error-text != "" ? Theme.error : Theme.success;
                    font-size: Type.body-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                IconButton {
                    icon: @image-url("icons/close.svg");
                    label: Tr.t("Dismiss");
                    tooltip-text: Tr.t("Dismiss");
                    icon-size: 18px;
                    clicked => {
                        root.dismiss-message();
                    }
                }
            }
        }

        if (root.loading && !root.has-content) : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            Spinner {
                width: 32px;
                height: 32px;
            }
        }

        if (!root.loading && !root.has-content) : EmptyAccounts {
            add-bank => {
                root.open-add-bank();
            }
        }

        if (root.has-content) : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 16px;

                for card in root.bank-cards : BankCardView {
                    card: card;
                    sync-controls-visible: root.sync-controls-visible;
                    menu-open: root.bank-menu-open == card.bank-id;
                    toggle => {
                        root.toggle-bank(card.bank-id);
                    }
                    add-account => {
                        root.open-add-account(card.bank-id);
                    }
                    remove-bank => {
                        root.open-delete-bank(card.bank-id);
                    }
                    sync => {
                        root.bank-menu(card.bank-id, "sync");
                    }
                    menu-toggle => {
                        root.bank-menu-open = root.bank-menu-open == card.bank-id ? -2 : card.bank-id;
                    }
                    menu-anchor(right, bottom) => {
                        root.open-bank-menu(card.bank-id, card.menu, right, bottom);
                    }
                    open-detail(account-id) => {
                        root.open-detail(account-id);
                    }
                    open-transactions(account-id) => {
                        root.open-transactions(account-id);
                    }
                    open-rename(account-id) => {
                        root.open-rename(account-id);
                    }
                    open-balance(account-id) => {
                        root.open-balance(account-id);
                    }
                    forget-deleted(account-id) => {
                        root.forget-deleted(account-id);
                    }
                    delete-account(account-id) => {
                        root.open-delete-account(account-id);
                    }
                }
            }
        }
    }

    // The bank card's floating menu, anchored under the ⋮ button and drawn above the cards.
    if (root.bank-menu-open >= 0) : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => {
                root.close-bank-menu();
            }
        }

        Rectangle {
            x: root.bank-menu-x;
            y: root.bank-menu-y;
            width: 300px;
            height: bank-menu-layout.preferred-height;
            background: Theme.surface;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            bank-menu-layout := VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 0px;

                for item[index] in root.open-menu-items : BankMenuEntry {
                    label: item.label;
                    checked: item.checked;
                    enabled: item.enabled;
                    danger: item.danger;
                    highlighted: root.bank-menu-navigated && root.bank-menu-selected == index;
                    icon-name: item.icon;
                    picked => {
                        root.activate-bank-menu(index);
                    }
                }
            }
        }
    }

    menu-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        enabled: root.bank-menu-open >= 0;
        focus-on-click: false;
        key-pressed(event) => {
            if (root.bank-menu-open < 0) {
                return reject;
            }
            if (event.text == Key.Escape) {
                root.close-bank-menu();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.bank-menu-navigated = true;
                root.bank-menu-selected = root.bank-menu-selected >= root.bank-menu-count() - 1
                        ? 0 : root.bank-menu-selected + 1;
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.bank-menu-navigated = true;
                root.bank-menu-selected = root.bank-menu-selected <= 0
                        ? root.bank-menu-count() - 1 : root.bank-menu-selected - 1;
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activate-bank-menu(root.bank-menu-selected);
                return accept;
            }
            return reject;
        }
    }

    // The account detail panel.
    if (root.detail-open) : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;

        Rectangle {
            width: 780px;
            height: min(detail-content.preferred-height, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-radius: Radius.surface;
            border-width: 1px;
            border-color: Theme.divider;

            ScrollView {
                detail-content := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    // A short detail keeps its booking rows at their natural height.
                    alignment: start;

                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;

                    BankBadge {
                        logo: root.detail-logo;
                        letters: root.detail-letters;
                        colour-index: root.detail-colour;
                        size: 40px;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.detail-title;
                        color: Theme.text;
                        font-size: Type.title-large-size;
                        font-weight: Type.title-large-weight;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: root.detail-subtitle;
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            overflow: elide;
                        }

                        Text {
                            text: root.detail-balance;
                            color: AccountTone.amount-color(root.detail-tone);
                            font-size: Type.headline-size;
                            font-weight: Type.headline-weight;
                        }
                    }

                    SegmentedButton {
                        labels: root.day-labels;
                        selected: root.detail-days == 365 ? 2 : (root.detail-days == 90 ? 1 : 0);
                        select(index) => {
                            root.select-days(root.detail-account-id, root.days-choices[index].days);
                        }
                    }
                }

                Text {
                    text: root.detail-summary;
                    color: Theme.muted-text;
                    font-size: Type.body-size;
                }

                // The axis sits left of the line: highest balance at the top, lowest at the bottom.
                HorizontalLayout {
                    width: 700px;
                    height: 200px;
                    spacing: 8px;

                    VerticalLayout {
                        width: 64px;

                        Text {
                            text: root.detail-axis-top;
                            color: Theme.muted-text;
                            font-size: Type.caption-size;
                            font-weight: Type.caption-weight;
                            horizontal-alignment: right;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        Text {
                            text: root.detail-axis-bottom;
                            color: Theme.muted-text;
                            font-size: Type.caption-size;
                            font-weight: Type.caption-weight;
                            horizontal-alignment: right;
                        }
                    }

                    Rectangle {
                        // The paths keep their 700 × 200 viewbox's aspect ratio and sit centred; the end dot
                        // uses the same fit.
                        property <float> fit: min(self.width / 700px, self.height / 200px);
                        property <length> dot-x: (self.width - 700px * self.fit) / 2 + root.detail-end-x * 1px * self.fit;
                        property <length> dot-y: (self.height - 200px * self.fit) / 2 + root.detail-end-y * 1px * self.fit;

                        horizontal-stretch: 1;
                        background: transparent;

                        Path {
                            commands: root.detail-path;
                            viewbox-width: 700.0;
                            viewbox-height: 200.0;
                            width: 100%;
                            height: 100%;
                            stroke: Theme.primary;
                            stroke-width: 2px;
                            fill: transparent;
                        }

                        Rectangle {
                            // 12 px: an 8 px dot in the line colour inside a 2 px surface ring.
                            x: parent.dot-x - 6px;
                            y: parent.dot-y - 6px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: Theme.primary;
                            border-width: 2px;
                            border-color: Theme.surface;
                        }

                        Text {
                            x: max(0px, parent.dot-x + 6px - self.width);
                            y: parent.dot-y > self.height + 12px ? parent.dot-y - self.height - 8px : parent.dot-y + 8px;
                            text: root.detail-end-label;
                            color: Theme.text;
                            font-size: Type.label-size;
                            font-weight: Type.label-weight;
                        }
                    }
                }

                Text {
                    text: Tr.t("RecentBookings");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                if (root.detail-rows.length == 0) : Text {
                    text: Tr.t("NoneInPeriod");
                    color: Theme.muted-text;
                    font-size: Type.body-size;
                }

                for booking in root.detail-rows : HorizontalLayout {
                    spacing: 12px;

                    Text {
                        text: booking.date-text;
                        width: 90px;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        vertical-alignment: center;
                    }

                    Text {
                        text: booking.title;
                        color: Theme.text;
                        font-size: Type.label-size;
                        font-weight: Type.label-weight;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Text {
                        text: booking.amount-text;
                        color: booking.expense ? Theme.money-out : Theme.money-in;
                        font-size: Type.body-size;
                        font-weight: Type.title-small-weight;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

                Text {
                    text: Tr.t("HistoryReconstructed");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    TextButton {
                        text: Tr.t("RenameAccount");
                        clicked => {
                            root.open-rename(root.detail-account-id);
                        }
                    }

                    TextButton {
                        text: Tr.t("Close");
                        clicked => {
                            root.close-detail();
                        }
                    }
                }
            }
            }
        }
    }

    // The dialogs sit above the detail panel.
    if (root.dialog != "") : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;

        if (root.dialog == "add-bank") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: Tr.t("AddBank");
            dialog-width: 540px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                SegmentedButton {
                    labels: [Tr.t("BankOnlineMode"), Tr.t("BankOfflineMode")];
                    selected: root.dialog-online ? 0 : 1;
                    select(index) => {
                        root.dialog-online = index == 0;
                    }
                }
            }

            if (root.dialog-online) : VerticalLayout {
                spacing: 8px;

                OutlinedField {
                    label: Tr.t("BankSearchHint");
                    text <=> root.add-bank-search;
                    edited(text) => {
                        root.bank-search-changed(text);
                    }
                    accepted(text) => {
                        root.bank-search-changed(text);
                    }
                }

                if (root.add-bank-search != "") : VerticalLayout {
                    spacing: 2px;

                    if (root.add-bank-suggestions.length == 0) : Text {
                        text: Tr.t("BankSearchNoMatch");
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                    }

                    if (root.add-bank-suggestions.length > 0) : Rectangle {
                        height: min(suggestions-layout.preferred-height, 100px);
                        background: transparent;

                        ScrollView {
                            suggestions-layout := VerticalLayout {
                                spacing: 2px;

                                for suggestion in root.add-bank-suggestions : BankSuggestionView {
                                    suggestion: suggestion;
                                    picked => {
                                        root.pick-bank-suggestion(
                                            suggestion.name,
                                            suggestion.blz,
                                            suggestion.bic,
                                        );
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: Tr.t("BankManualEntry");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
            }

            OutlinedField {
                label: Tr.t("BankName");
                text <=> root.add-bank-name;
                accepted(text) => {
                    if (text != "" && !root.dialog-online) {
                        root.submit-add-bank(text);
                    }
                }
            }

            if (root.dialog-online) : VerticalLayout {
                spacing: 8px;

                OutlinedField {
                    label: Tr.t("BlzDigits");
                    text <=> root.add-bank-blz;
                    edited(text) => {
                        root.bank-blz-changed(root.add-bank-name, text, root.add-bank-bic);
                    }
                }

                if (root.add-bank-central-note != "") : Text {
                    text: root.add-bank-central-note;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                OutlinedField {
                    label: Tr.t("BicOptional");
                    text <=> root.add-bank-bic;
                }

                OutlinedField {
                    label: Tr.t("UserIdLogin");
                    text <=> root.add-bank-user-id;
                }

                OutlinedField {
                    label: Tr.t("FintsServerUrl");
                    text <=> root.add-bank-server-url;
                }

                Text {
                    text: Tr.t("AskBankForFints");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                PrimaryButton {
                    text: Tr.t("Add");
                    enabled: root.add-bank-name != "";
                    clicked => {
                        if (root.dialog-online) {
                            root.submit-add-online-bank(
                                root.add-bank-name,
                                root.add-bank-blz,
                                root.add-bank-bic,
                                root.add-bank-user-id,
                                root.add-bank-server-url,
                            );
                        } else {
                            root.submit-add-bank(root.add-bank-name);
                        }
                    }
                }
            }
        }

        if (root.dialog == "add-account") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;
            dialog-width: 540px;

            OutlinedField {
                label: Tr.t("AccountName");
                text <=> root.add-account-name;
            }

            OutlinedField {
                label: root.dialog-offline ? Tr.t("IbanOrCardLast4") : Tr.t("Iban");
                text <=> root.add-account-identifier;
            }

            HorizontalLayout {
                alignment: start;

                TypeSelectPill {
                    choices: root.type-choices;
                    code: root.form-type-code;
                    chosen(code) => { root.form-type-code = code; }
                }
            }

            HorizontalLayout {
                alignment: start;

                SelectPill {
                    label-prefix: Tr.t("ColCurrency") + ": ";
                    value: root.form-currency;
                    options: root.currency-codes;
                    value-chosen(value) => { root.form-currency = value; }
                }
            }

            OutlinedField {
                label: Tr.t("ColBalance");
                text <=> root.add-account-balance;
            }

            if (root.form-type-code == "loan") : Text {
                text: Tr.t("LoanBalanceHint");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                PrimaryButton {
                    text: Tr.t("Add");
                    enabled: root.add-account-identifier != "" && root.add-account-balance != "";
                    clicked => {
                        root.submit-add-account(
                            root.dialog-bank-id,
                            root.add-account-name,
                            root.add-account-identifier,
                            root.form-type-code,
                            root.form-currency,
                            root.add-account-balance,
                        );
                    }
                }
            }
        }

        if (root.dialog == "balance") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: Tr.t("UpdateBalance");

            Text {
                text: root.dialog-account-label;
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: start;

                TypeSelectPill {
                    choices: root.type-choices;
                    code: root.balance-type-code;
                    chosen(code) => { root.balance-type-code = code; }
                }
            }

            OutlinedField {
                label: Tr.t("ColBalance");
                text <=> root.balance-input;
                accepted(text) => {
                    if (text != "") {
                        root.submit-balance(root.dialog-account-id, text, root.balance-type-code);
                    }
                }
            }

            if (root.balance-type-code == "loan") : Text {
                text: Tr.t("LoanBalanceHint");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                PrimaryButton {
                    text: Tr.t("Save");
                    enabled: root.balance-input != "";
                    clicked => {
                        root.submit-balance(root.dialog-account-id, root.balance-input, root.balance-type-code);
                    }
                }
            }
        }

        if (root.dialog == "rename") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: Tr.t("RenameAccount");

            OutlinedField {
                label: Tr.t("AccountName");
                text <=> root.rename-input;
                accepted(text) => {
                    root.submit-rename(root.dialog-account-id, text);
                }
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                PrimaryButton {
                    text: Tr.t("Save");
                    clicked => {
                        root.submit-rename(root.dialog-account-id, root.rename-input);
                    }
                }
            }
        }

        if (root.dialog == "connection") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;
            dialog-width: 520px;

            OutlinedField {
                label: Tr.t("ConnectionName");
                text <=> root.connection-name;
            }

            Text {
                text: Tr.t("ConnectionNameHint");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            if (!root.dialog-offline) : VerticalLayout {
                spacing: 8px;

                OutlinedField {
                    label: Tr.t("BlzDigits");
                    text <=> root.connection-blz;
                }

                OutlinedField {
                    label: Tr.t("UserIdLogin");
                    text <=> root.connection-user-id;
                }

                OutlinedField {
                    label: Tr.t("FintsServerUrl");
                    text <=> root.connection-server-url;
                }

                if (root.connection-pin-text != "") : Text {
                    text: root.connection-pin-text;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                if (root.connection-has-pin) : TextButton {
                    text: Tr.t("ForgetPin");
                    enabled: !root.connection-syncing;
                    clicked => {
                        root.forget-pin(root.dialog-bank-id);
                    }
                }
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                PrimaryButton {
                    text: Tr.t("Save");
                    enabled: root.connection-name != "" && !root.connection-syncing;
                    clicked => {
                        root.submit-connection(
                            root.dialog-bank-id,
                            root.connection-name,
                            root.connection-blz,
                            root.connection-user-id,
                            root.connection-server-url,
                        );
                    }
                }
            }
        }

        if (root.dialog == "history") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;
            dialog-width: 500px;

            OutlinedField {
                label: Tr.t("FetchHistoryDate");
                text <=> root.history-date;
                error: root.dialog-error != "";
                supporting-text: root.dialog-error != "" ? root.dialog-error : Tr.t("FetchHistoryHint");
                accepted(text) => {
                    root.submit-history(root.dialog-bank-id, text);
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                if (root.history-has-start) : TextButton {
                    text: Tr.t("ClearHistoryStart");
                    clicked => {
                        root.clear-history(root.dialog-bank-id);
                    }
                }

                PrimaryButton {
                    text: Tr.t("Fetch");
                    enabled: root.history-date != "";
                    clicked => {
                        root.submit-history(root.dialog-bank-id, root.history-date);
                    }
                }
            }
        }

        if (root.dialog == "delete-account") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;

            Text {
                text: root.dialog-text;
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                PrimaryButton {
                    text: Tr.t("Delete");
                    destructive: true;
                    clicked => {
                        root.confirm-delete-account(root.dialog-account-id);
                    }
                }
            }
        }

        if (root.dialog == "delete-bank") : ModalCard {
            dialog-max-height: parent.height - 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;

            Text {
                text: root.dialog-text;
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }

                PrimaryButton {
                    text: Tr.t("RemoveBank");
                    destructive: true;
                    clicked => {
                        root.confirm-delete-bank(root.dialog-bank-id);
                    }
                }
            }
        }
    }
}
