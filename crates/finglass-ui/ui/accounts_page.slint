import { ComboBox, LineEdit, ScrollView, Spinner } from "std-widgets.slint";
import { Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    AccountDaysChoice,
    AccountDetailRow,
    AccountsBankCard,
    AccountTypeChoice,
    AccountsFigure,
    AccountTone,
    BankAccountRow,
    ChoiceChip,
    CountBadge,
    IconButton,
    PrimaryButton,
    SecondaryButton,
    SegmentedButton,
    TextButton,
} from "components.slint";
import { BankSuggestionRow } from "models.slint";

// One entry of a bank card's menu, with a check mark for the active choice.
component BankMenuEntry inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;

    callback picked;

    height: 28px;
    background: touch.has-hover && root.enabled ? Theme.background : transparent;
    accessible-role: button;
    accessible-label: root.label;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        cross-axis-alignment: center;

        if (root.checked) : Image {
            width: 18px;
            height: 18px;
            source: @image-url("icons/check.svg");
            colorize: root.enabled ? Theme.on-selected : Theme.muted-text;
            accessible-role: none;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.enabled ? Theme.text : Theme.muted-text;
            font-size: Type.body-size;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.picked();
            }
        }
    }
}

// A labelled group of figures in the page header.
component FigureView inherits VerticalLayout {
    in property <AccountsFigure> figure;

    spacing: 2px;
    alignment: start;

    Text {
        text: root.figure.label;
        color: Theme.muted-text;
        font-size: Type.label-small-size;
        font-weight: Type.label-small-weight;
        overflow: elide;
    }

    for amount in root.figure.values : Text {
        text: amount.text;
        color: root.figure.secondary ? Theme.muted-text : AccountTone.amount-color(amount.tone);
        font-size: root.figure.secondary ? 18px : 24px;
        font-weight: root.figure.secondary ? Type.body-weight : Type.headline-weight;
        overflow: elide;
    }
}

// A centred dialog card on a dimmed background.
component ModalCard inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 480px;

    width: root.dialog-width;
    height: content.preferred-height;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.divider;

    content := VerticalLayout {
        padding: 24px;
        spacing: 10px;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Type.title-medium-size;
            font-weight: Type.title-medium-weight;
            wrap: word-wrap;
        }

        @children
    }
}

// One clickable bank suggestion, with the BLZ/city/BIC that disambiguate branches.
component BankSuggestionView inherits Rectangle {
    in property <BankSuggestionRow> suggestion;

    callback picked;

    height: suggestion-layout.preferred-height + 12px;
    border-radius: 6px;
    background: hover.has-hover ? Theme.selected : transparent;

    suggestion-layout := VerticalLayout {
        padding: 6px;
        spacing: 1px;
        alignment: start;

        Text {
            text: root.suggestion.name;
            color: Theme.text;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            overflow: elide;
        }

        Text {
            text: root.suggestion.detail;
            color: Theme.muted-text;
            font-size: Type.body-small-size;
            overflow: elide;
        }
    }

    hover := TouchArea {
        clicked => {
            root.picked();
        }
    }
}

// One account inside a bank card, with its inline action strip.
component BankAccountView inherits Rectangle {
    in property <BankAccountRow> account;

    callback open-detail;
    callback open-transactions;
    callback rename-account;
    callback edit-balance;
    callback forget-deleted;
    callback delete-account;

    property <bool> menu-open: false;

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 52px;
            background: touch.has-hover ? Theme.background : transparent;

            touch := TouchArea {
                clicked => {
                    root.menu-open = false;
                    root.open-detail();
                }
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                cross-axis-alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.account.name;
                        color: Theme.text;
                        font-size: Type.title-small-size;
                        font-weight: root.account.new-count > 0 ? Type.title-small-weight : Type.title-small-weight;
                        overflow: elide;
                    }

                    Text {
                        text: root.account.subtitle;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        overflow: elide;
                    }
                }

                // The badge has its own column so it can never sit on top of the amount.
                VerticalLayout {
                    width: 20px;
                    alignment: center;

                    CountBadge {
                        count: root.account.new-count;
                        selected: false;
                    }
                }

                Text {
                    text: root.account.balance-text;
                    color: AccountTone.amount-color(root.account.tone);
                    font-size: Type.title-medium-size;
                    font-weight: Type.title-medium-weight;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: list-icon.has-hover ? Theme.divider : transparent;

                    Text {
                        text: "☰";
                        color: Theme.muted-text;
                        font-size: Type.body-size;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    list-icon := TouchArea {
                        clicked => {
                            root.menu-open = false;
                            root.open-transactions();
                        }
                    }
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: dot.has-hover ? Theme.divider : transparent;

                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/more_vert.svg");
                        colorize: Theme.muted-text;
                        accessible-role: none;
                    }

                    dot := TouchArea {
                        clicked => {
                            root.menu-open = !root.menu-open;
                        }
                    }
                }
            }
        }

        if (root.menu-open) : Rectangle {
            height: actions.preferred-height;
            background: Theme.background;

            actions := HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 10px;
                alignment: start;

                TextButton {
                    text: Tr.t("MenuDetails");
                    clicked => {
                        root.menu-open = false;
                        root.open-detail();
                    }
                }

                TextButton {
                    text: Tr.t("RenameAccount");
                    clicked => {
                        root.menu-open = false;
                        root.rename-account();
                    }
                }

                TextButton {
                    text: Tr.t("EditBalance");
                    clicked => {
                        root.menu-open = false;
                        root.edit-balance();
                    }
                }

                TextButton {
                    text: Tr.t("AllowDeletedAgain");
                    clicked => {
                        root.menu-open = false;
                        root.forget-deleted();
                    }
                }

                TextButton {
                    text: Tr.t("DeleteAccount");
                    clicked => {
                        root.menu-open = false;
                        root.delete-account();
                    }
                }
            }
        }
    }
}

// One bank connection (or the accounts without a bank) with its account rows.
component BankCardView inherits Rectangle {
    in property <AccountsBankCard> card;

    callback toggle;
    callback add-account;
    callback remove-bank;
    callback sync;
    callback menu-action(string);
    callback open-detail(int);
    callback open-transactions(int);
    callback open-rename(int);
    callback open-balance(int);
    callback forget-deleted(int);
    callback delete-account(int);

    property <bool> menu-open: false;
    height: card-content.preferred-height;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.divider;

    card-content := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            if (root.card.bank-id >= 0) : Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: chevron.has-hover ? Theme.divider : transparent;

                Image {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.card.collapsed ? @image-url("icons/keyboard_arrow_right.svg") : @image-url("icons/keyboard_arrow_down.svg");
                    colorize: Theme.muted-text;
                    accessible-role: none;
                }

                chevron := TouchArea {
                    clicked => {
                        root.toggle();
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: root.card.name;
                        color: Theme.text;
                        font-size: Type.title-medium-size;
                        font-weight: Type.title-medium-weight;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if (root.card.collapsed) : Text {
                        text: root.card.account-count-text;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        vertical-alignment: center;
                    }

                    if (root.card.collapsed) : VerticalLayout {
                        spacing: 0px;
                        alignment: end;

                        for amount in root.card.totals : Text {
                            text: amount.text;
                            color: AccountTone.amount-color(amount.tone);
                            font-size: Type.label-small-size;
                            font-weight: Type.label-small-weight;
                            horizontal-alignment: right;
                        }
                    }
                }

                if (root.card.subtitle != "") : Text {
                    text: root.card.subtitle;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    overflow: elide;
                }

                if (root.card.central-blz-hint != "") : Text {
                    text: root.card.central-blz-hint;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    overflow: elide;
                }

                if (!root.card.offline && root.card.pin-text != "") : Text {
                    text: root.card.pin-text;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    overflow: elide;
                }
            }

            if (root.card.syncing) : Spinner {
                width: 18px;
                height: 18px;
            }

            if (root.card.syncing) : Text {
                text: root.card.sync-step;
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                vertical-alignment: center;
            }

            if (root.card.bank-id >= 0 && !root.card.offline && !root.card.syncing) : SecondaryButton {
                text: Tr.t("Sync");
                icon: @image-url("icons/sync.svg");
                has-icon: true;
                enabled: root.card.sync-enabled;
                clicked => {
                    root.sync();
                }
            }

            if (root.card.bank-id >= 0) : TextButton {
                text: Tr.t("AddAccountShort");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                clicked => {
                    root.add-account();
                }
            }

            if (root.card.bank-id >= 0) : IconButton {
                icon: @image-url("icons/more_vert.svg");
                label: Tr.t("More");
                outlined: true;
                clicked => {
                    root.menu-open = !root.menu-open;
                }
            }
        }

        if (root.menu-open && root.card.bank-id >= 0) : Rectangle {
            height: menu-items.preferred-height;
            background: Theme.background;
            border-radius: 8px;

            menu-items := VerticalLayout {
                padding: 6px;
                spacing: 2px;

                for item in root.card.menu : BankMenuEntry {
                    label: item.label;
                    checked: item.checked;
                    enabled: item.enabled;
                    picked => {
                        root.menu-open = false;
                        root.menu-action(item.action);
                    }
                }
            }
        }

        if (!root.card.collapsed) : Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        if (!root.card.collapsed) : VerticalLayout {
            spacing: 0px;

            if (root.card.accounts.length == 0) : Text {
                text: Tr.t("NoAccountsYet");
                color: Theme.muted-text;
                font-size: Type.body-size;
            }

            for account in root.card.accounts : BankAccountView {
                account: account;
                open-detail => {
                    root.open-detail(account.account-id);
                }
                open-transactions => {
                    root.open-transactions(account.account-id);
                }
                rename-account => {
                    root.open-rename(account.account-id);
                }
                edit-balance => {
                    root.open-balance(account.account-id);
                }
                forget-deleted => {
                    root.forget-deleted(account.account-id);
                }
                delete-account => {
                    root.delete-account(account.account-id);
                }
            }
        }
    }
}

// The empty accounts page: no bank and no account yet.
component EmptyAccounts inherits Rectangle {
    callback add-bank;

    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 64px;
                height: 56px;
                background: transparent;

                Path {
                    commands: "M 8 24 L 32 8 L 56 24 Z M 14 24 L 14 48 L 20 48 L 20 24 Z M 26 24 L 26 48 L 32 48 L 32 24 Z M 38 24 L 38 48 L 44 48 L 44 24 Z M 50 24 L 50 48 L 56 48 L 56 24 Z M 8 48 L 56 48 L 56 54 L 8 54 Z";
                    fill: Theme.muted-text;
                }
            }
        }

        Text {
            text: Tr.t("NoBanksYet");
            color: Theme.text;
            font-size: Type.title-large-size;
            font-weight: Type.title-large-weight;
            horizontal-alignment: center;
        }

        Text {
            width: 620px;
            text: Tr.t("NoBanksDescription");
            color: Theme.muted-text;
            font-size: Type.body-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;

            PrimaryButton {
                width: 150px;
                text: Tr.t("AddBank");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                clicked => {
                    root.add-bank();
                }
            }
        }
    }
}

// The Accounts page: the header figures and the bank cards across the full width.
export component AccountsPage inherits Rectangle {
    in property <bool> loading;
    in property <bool> show-content;
    in property <bool> has-content;
    in property <string> error-text;
    in property <string> message-text;
    in property <bool> banking-busy: false;

    in property <[AccountsFigure]> figures;
    in property <[AccountsBankCard]> bank-cards;

    in property <string> sync-all-progress;
    in property <bool> sync-all-visible;
    in property <bool> sync-all-enabled;

    in property <[AccountTypeChoice]> type-choices;
    in property <[string]> currency-codes;
    in property <[AccountDaysChoice]> days-choices;
    in property <[string]> day-labels;

    in property <string> dialog;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <string> dialog-account-label;
    in property <string> dialog-account-name;
    in property <string> dialog-balance;
    in property <string> dialog-error;
    in property <string> dialog-account-type;
    in property <bool> dialog-offline;
    in-out property <bool> dialog-online;
    in property <int> dialog-bank-id;
    in property <int> dialog-account-id;
    in-out property <string> connection-name;
    in-out property <string> connection-blz;
    in-out property <string> connection-user-id;
    in-out property <string> connection-server-url;
    in property <string> connection-pin-text;
    in property <bool> connection-has-pin;
    in property <bool> connection-syncing;
    in-out property <string> history-date;
    in property <bool> history-has-start;

    in property <bool> detail-open;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-balance;
    in property <string> detail-tone;
    in property <int> detail-account-id;
    in property <int> detail-days;
    in property <string> detail-summary;
    in property <string> detail-path;
    in property <string> detail-axis-top;
    in property <string> detail-axis-bottom;
    in property <[AccountDetailRow]> detail-rows;

    callback open-add-bank;
    callback bank-search-changed(string);
    callback pick-bank-suggestion(string, string, string);
    callback bank-blz-changed(string, string, string);
    callback close-dialog;
    callback submit-add-bank(string);
    callback submit-add-online-bank(string, string, string, string, string);
    callback submit-connection(int, string, string, string, string);
    callback forget-pin(int);
    callback submit-history(int, string);
    callback clear-history(int);
    callback sync-all;
    callback bank-menu(int, string);
    callback open-add-account(int);
    callback submit-add-account(int, string, string, string, string, string);
    callback open-balance(int);
    callback submit-balance(int, string, string);
    callback open-rename(int);
    callback submit-rename(int, string);
    callback open-delete-account(int);
    callback confirm-delete-account(int);
    callback open-delete-bank(int);
    callback confirm-delete-bank(int);
    callback close-detail;
    callback select-days(int, int);
    callback toggle-bank(int);
    callback forget-deleted(int);
    callback dismiss-message;
    callback open-detail(int);
    callback open-transactions(int);

    in-out property <string> add-bank-name: "";
    in-out property <string> add-bank-blz: "";
    in-out property <string> add-bank-bic: "";
    in-out property <string> add-bank-search: "";
    in property <[BankSuggestionRow]> add-bank-suggestions;
    in property <string> add-bank-central-note;
    property <string> add-bank-user-id: "";
    property <string> add-bank-server-url: "";
    property <string> add-account-name: "";
    property <string> add-account-identifier: "";
    property <string> add-account-balance: "0";
    property <string> form-type-code: "checking";
    property <string> form-currency: "EUR";
    property <string> balance-input;
    property <string> balance-type-code: "checking";
    property <string> rename-input;


    changed dialog => {
        root.add-bank-name = "";
        root.add-bank-blz = "";
        root.add-bank-bic = "";
        root.add-bank-search = "";
        root.add-bank-user-id = "";
        root.add-bank-server-url = "";
        root.add-account-name = "";
        root.add-account-identifier = "";
        root.add-account-balance = "0";
        root.form-type-code = root.dialog-account-type;
        root.form-currency = "EUR";
        root.balance-input = root.dialog-balance;
        root.balance-type-code = root.dialog-account-type;
        root.rename-input = root.dialog-account-name;
    }

    // The adapter sets the values before it opens the dialog; these handlers also fill the forms when a
    // caller sets only the value (for example the screenshot test).
    changed dialog-account-type => {
        root.form-type-code = root.dialog-account-type;
        root.balance-type-code = root.dialog-account-type;
    }

    changed dialog-balance => {
        root.balance-input = root.dialog-balance;
    }

    changed dialog-account-name => {
        root.rename-input = root.dialog-account-name;
    }

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        if (root.show-content) : HorizontalLayout {
            spacing: 32px;

            for figure in root.figures : FigureView {
                figure: figure;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            if (root.sync-all-visible) : HorizontalLayout {
                spacing: 12px;
                alignment: center;

                if (root.sync-all-progress != "") : Spinner {
                    width: 18px;
                    height: 18px;
                }

                if (root.sync-all-progress != "") : Text {
                    text: root.sync-all-progress;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    vertical-alignment: center;
                }

                if (root.sync-all-progress == "") : TextButton {
                    text: Tr.t("SyncAll");
                    enabled: root.sync-all-enabled;
                    clicked => {
                        root.sync-all();
                    }
                }
            }

            PrimaryButton {
                text: Tr.t("AddBank");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                enabled: !root.banking-busy;
                clicked => {
                    root.open-add-bank();
                }
            }
        }

        if (root.error-text != "" || root.message-text != "") : Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.error-text != "" ? Theme.error : Theme.success;

            HorizontalLayout {
                padding: 12px;
                padding-right: 4px;
                spacing: 12px;

                Image {
                    width: 20px;
                    height: 20px;
                    source: root.error-text != "" ? @image-url("icons/warning.svg") : @image-url("icons/check_circle.svg");
                    colorize: root.error-text != "" ? Theme.error : Theme.success;
                    accessible-role: none;
                }

                Text {
                    text: root.error-text != "" ? root.error-text : root.message-text;
                    color: root.error-text != "" ? Theme.error : Theme.success;
                    font-size: Type.body-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                IconButton {
                    icon: @image-url("icons/close.svg");
                    label: Tr.t("Dismiss");
                    icon-size: 18px;
                    clicked => {
                        root.dismiss-message();
                    }
                }
            }
        }

        if (root.loading && !root.has-content) : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            Spinner {
                width: 32px;
                height: 32px;
            }
        }

        if (!root.loading && !root.has-content) : EmptyAccounts {
            add-bank => {
                root.open-add-bank();
            }
        }

        if (root.has-content) : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 16px;

                for card in root.bank-cards : BankCardView {
                    card: card;
                    toggle => {
                        root.toggle-bank(card.bank-id);
                    }
                    add-account => {
                        root.open-add-account(card.bank-id);
                    }
                    remove-bank => {
                        root.open-delete-bank(card.bank-id);
                    }
                    sync => {
                        root.bank-menu(card.bank-id, "sync");
                    }
                    menu-action(action) => {
                        root.bank-menu(card.bank-id, action);
                    }
                    open-detail(account-id) => {
                        root.open-detail(account-id);
                    }
                    open-transactions(account-id) => {
                        root.open-transactions(account-id);
                    }
                    open-rename(account-id) => {
                        root.open-rename(account-id);
                    }
                    open-balance(account-id) => {
                        root.open-balance(account-id);
                    }
                    forget-deleted(account-id) => {
                        root.forget-deleted(account-id);
                    }
                    delete-account(account-id) => {
                        root.open-delete-account(account-id);
                    }
                }
            }
        }
    }

    // The account detail panel.
    if (root.detail-open) : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        Rectangle {
            width: 780px;
            height: min(detail-content.preferred-height, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.divider;

            ScrollView {
                detail-content := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                Text {
                    text: root.detail-title;
                    color: Theme.text;
                    font-size: Type.title-large-size;
                    font-weight: Type.title-large-weight;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: root.detail-subtitle;
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            overflow: elide;
                        }

                        Text {
                            text: root.detail-balance;
                            color: AccountTone.amount-color(root.detail-tone);
                            font-size: Type.headline-size;
                            font-weight: Type.headline-weight;
                        }
                    }

                    SegmentedButton {
                        labels: root.day-labels;
                        selected: root.detail-days == 365 ? 2 : (root.detail-days == 90 ? 1 : 0);
                        select(index) => {
                            root.select-days(root.detail-account-id, root.days-choices[index].days);
                        }
                    }
                }

                Text {
                    text: root.detail-summary;
                    color: Theme.muted-text;
                    font-size: Type.body-size;
                }

                // The axis sits left of the line: highest balance at the top, lowest at the bottom.
                HorizontalLayout {
                    width: 700px;
                    height: 200px;
                    spacing: 8px;

                    VerticalLayout {
                        width: 64px;

                        Text {
                            text: root.detail-axis-top;
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            horizontal-alignment: right;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                        }

                        Text {
                            text: root.detail-axis-bottom;
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            horizontal-alignment: right;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        Path {
                            commands: root.detail-path;
                            stroke: Theme.primary;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                    }
                }

                Text {
                    text: Tr.t("RecentBookings");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                if (root.detail-rows.length == 0) : Text {
                    text: Tr.t("NoneInPeriod");
                    color: Theme.muted-text;
                    font-size: Type.body-size;
                }

                for booking in root.detail-rows : HorizontalLayout {
                    spacing: 12px;

                    Text {
                        text: booking.date-text;
                        width: 90px;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        vertical-alignment: center;
                    }

                    Text {
                        text: booking.title;
                        color: Theme.text;
                        font-size: Type.body-small-size;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Text {
                        text: booking.amount-text;
                        color: booking.expense ? Theme.error : Theme.success;
                        font-size: Type.label-small-size;
                        font-weight: Type.label-small-weight;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

                Text {
                    text: Tr.t("HistoryReconstructed");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    TextButton {
                        text: Tr.t("RenameAccount");
                        clicked => {
                            root.open-rename(root.detail-account-id);
                        }
                    }

                    TextButton {
                        text: Tr.t("Close");
                        clicked => {
                            root.close-detail();
                        }
                    }
                }
            }
            }
        }
    }

    // The dialogs sit above the detail panel.
    if (root.dialog != "") : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        if (root.dialog == "add-bank") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: Tr.t("AddBank");
            dialog-width: 540px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                SegmentedButton {
                    labels: [Tr.t("BankOnlineMode"), Tr.t("BankOfflineMode")];
                    selected: root.dialog-online ? 0 : 1;
                    select(index) => {
                        root.dialog-online = index == 0;
                    }
                }
            }

            if (root.dialog-online) : VerticalLayout {
                spacing: 8px;

                Text {
                    text: Tr.t("BankSearchHint");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.add-bank-search;
                    edited(text) => {
                        root.bank-search-changed(text);
                    }
                    accepted(text) => {
                        root.bank-search-changed(text);
                    }
                }

                if (root.add-bank-search != "") : VerticalLayout {
                    spacing: 2px;

                    if (root.add-bank-suggestions.length == 0) : Text {
                        text: Tr.t("BankSearchNoMatch");
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                    }

                    if (root.add-bank-suggestions.length > 0) : Rectangle {
                        height: min(suggestions-layout.preferred-height, 100px);
                        background: transparent;

                        ScrollView {
                            suggestions-layout := VerticalLayout {
                                spacing: 2px;

                                for suggestion in root.add-bank-suggestions : BankSuggestionView {
                                    suggestion: suggestion;
                                    picked => {
                                        root.pick-bank-suggestion(
                                            suggestion.name,
                                            suggestion.blz,
                                            suggestion.bic,
                                        );
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: Tr.t("BankManualEntry");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
            }

            Text {
                text: Tr.t("BankName");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.add-bank-name;
                accepted(text) => {
                    if (text != "" && !root.dialog-online) {
                        root.submit-add-bank(text);
                    }
                }
            }

            if (root.dialog-online) : VerticalLayout {
                spacing: 8px;

                Text {
                    text: Tr.t("BlzDigits");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.add-bank-blz;
                    edited(text) => {
                        root.bank-blz-changed(root.add-bank-name, text, root.add-bank-bic);
                    }
                }

                if (root.add-bank-central-note != "") : Text {
                    text: root.add-bank-central-note;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                Text {
                    text: Tr.t("BicOptional");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.add-bank-bic;
                }

                Text {
                    text: Tr.t("UserIdLogin");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.add-bank-user-id;
                }

                Text {
                    text: Tr.t("FintsServerUrl");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.add-bank-server-url;
                }

                Text {
                    text: Tr.t("AskBankForFints");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("Add");
                    enabled: root.add-bank-name != "";
                    clicked => {
                        if (root.dialog-online) {
                            root.submit-add-online-bank(
                                root.add-bank-name,
                                root.add-bank-blz,
                                root.add-bank-bic,
                                root.add-bank-user-id,
                                root.add-bank-server-url,
                            );
                        } else {
                            root.submit-add-bank(root.add-bank-name);
                        }
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }

        if (root.dialog == "add-account") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;
            dialog-width: 540px;

            Text {
                text: Tr.t("AccountName");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.add-account-name;
            }

            Text {
                text: root.dialog-offline ? Tr.t("IbanOrCardLast4") : Tr.t("Iban");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.add-account-identifier;
            }

            Text {
                text: Tr.t("AccountTypeLabel");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            HorizontalLayout {
                spacing: 6px;

                for choice in root.type-choices : ChoiceChip {
                    label: choice.label;
                    selected: root.form-type-code == choice.code;
                    clicked => {
                        root.form-type-code = choice.code;
                    }
                }
            }

            Text {
                text: Tr.t("ColCurrency");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            ComboBox {
                model: root.currency-codes;
                current-value <=> root.form-currency;
            }

            Text {
                text: Tr.t("ColBalance");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.add-account-balance;
            }

            if (root.form-type-code == "loan") : Text {
                text: Tr.t("LoanBalanceHint");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("Add");
                    enabled: root.add-account-identifier != "" && root.add-account-balance != "";
                    clicked => {
                        root.submit-add-account(
                            root.dialog-bank-id,
                            root.add-account-name,
                            root.add-account-identifier,
                            root.form-type-code,
                            root.form-currency,
                            root.add-account-balance,
                        );
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }

        if (root.dialog == "balance") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: Tr.t("UpdateBalance");

            Text {
                text: root.dialog-account-label;
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                overflow: elide;
            }

            Text {
                text: Tr.t("AccountTypeLabel");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            HorizontalLayout {
                spacing: 6px;

                for choice in root.type-choices : ChoiceChip {
                    label: choice.label;
                    selected: root.balance-type-code == choice.code;
                    clicked => {
                        root.balance-type-code = choice.code;
                    }
                }
            }

            Text {
                text: Tr.t("ColBalance");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.balance-input;
                accepted(text) => {
                    if (text != "") {
                        root.submit-balance(root.dialog-account-id, text, root.balance-type-code);
                    }
                }
            }

            if (root.balance-type-code == "loan") : Text {
                text: Tr.t("LoanBalanceHint");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("Save");
                    enabled: root.balance-input != "";
                    clicked => {
                        root.submit-balance(root.dialog-account-id, root.balance-input, root.balance-type-code);
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }

        if (root.dialog == "rename") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: Tr.t("RenameAccount");

            Text {
                text: Tr.t("AccountName");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.rename-input;
                accepted(text) => {
                    root.submit-rename(root.dialog-account-id, text);
                }
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("Save");
                    clicked => {
                        root.submit-rename(root.dialog-account-id, root.rename-input);
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }

        if (root.dialog == "connection") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;
            dialog-width: 520px;

            Text {
                text: Tr.t("ConnectionName");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.connection-name;
            }

            Text {
                text: Tr.t("ConnectionNameHint");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            if (!root.dialog-offline) : VerticalLayout {
                spacing: 8px;

                Text {
                    text: Tr.t("BlzDigits");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.connection-blz;
                }

                Text {
                    text: Tr.t("UserIdLogin");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.connection-user-id;
                }

                Text {
                    text: Tr.t("FintsServerUrl");
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                }

                LineEdit {
                    text <=> root.connection-server-url;
                }

                if (root.connection-pin-text != "") : Text {
                    text: root.connection-pin-text;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                if (root.connection-has-pin) : TextButton {
                    text: Tr.t("ForgetPin");
                    enabled: !root.connection-syncing;
                    clicked => {
                        root.forget-pin(root.dialog-bank-id);
                    }
                }
            }

            if (root.dialog-error != "") : Text {
                text: root.dialog-error;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("Save");
                    enabled: root.connection-name != "" && !root.connection-syncing;
                    clicked => {
                        root.submit-connection(
                            root.dialog-bank-id,
                            root.connection-name,
                            root.connection-blz,
                            root.connection-user-id,
                            root.connection-server-url,
                        );
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }

        if (root.dialog == "history") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;
            dialog-width: 500px;

            Text {
                text: Tr.t("FetchHistoryDate");
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
            }

            LineEdit {
                text <=> root.history-date;
                accepted(text) => {
                    root.submit-history(root.dialog-bank-id, text);
                }
            }

            Text {
                text: root.dialog-error != "" ? root.dialog-error : Tr.t("FetchHistoryHint");
                color: root.dialog-error != "" ? Theme.error : Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("Fetch");
                    enabled: root.history-date != "";
                    clicked => {
                        root.submit-history(root.dialog-bank-id, root.history-date);
                    }
                }

                if (root.history-has-start) : TextButton {
                    text: Tr.t("ClearHistoryStart");
                    clicked => {
                        root.clear-history(root.dialog-bank-id);
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }

        if (root.dialog == "delete-account") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;

            Text {
                text: root.dialog-text;
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("Delete");
                    clicked => {
                        root.confirm-delete-account(root.dialog-account-id);
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }

        if (root.dialog == "delete-bank") : ModalCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;

            Text {
                text: root.dialog-text;
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("RemoveBank");
                    clicked => {
                        root.confirm-delete-bank(root.dialog-bank-id);
                    }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => {
                        root.close-dialog();
                    }
                }
            }
        }
    }
}
