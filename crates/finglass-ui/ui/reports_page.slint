import { ScrollView, Spinner } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    Checkbox,
    DashboardCategoryRow,
    MessageBanner,
    ReportAmountRow,
    ReportMonthlyRow,
    ReportRecurringRow,
    ReportSuggestionRow,
    ReportTaxRow,
    ReportVendorRow,
    IconButton,
    PrimaryButton,
    SecondaryButton,
    SegmentedButton,
    TextButton,
} from "components.slint";
import { CategorySplit } from "charts.slint";

// One tab of the Reports page's tab bar.
component ReportTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;

    callback clicked;

    height: 44px;
    horizontal-stretch: 1;
    background: transparent;

    Text {
        text: root.text;
        color: root.selected ? Theme.primary : Theme.muted-text;
        font-size: Type.label-size;
        font-weight: Type.label-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 2px;
        background: root.selected ? Theme.primary : transparent;
    }

    TouchArea {
        clicked => root.clicked();
    }
}

// A compact date field with its label as the placeholder.
component DateField inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;

    callback edited(string);

    width: 128px;
    height: 34px;
    border-radius: Radius.small;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : Theme.divider;

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: Type.body-size;
        vertical-alignment: center;
        single-line: true;
        enabled: root.enabled;
        edited => { root.edited(input.text); }
        accepted => { root.edited(input.text); }
    }

    if (input.text == "") : Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: Theme.muted-text;
        font-size: Type.body-small-size;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A headline figure with a coloured accent and an optional second line.
component ReportStat inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> subtitle;
    in property <color> accent;
    in property <image> icon;
    in property <color> value-color: Theme.text;
    in property <bool> interactive: false;
    // Set on narrow windows, where four cards share little width.
    in property <bool> compact: false;

    callback clicked;

    min-height: 104px;
    // Equal widths in a row: stretch would otherwise share out space from each value's own width.
    preferred-width: 0px;
    min-width: 0px;
    border-radius: Radius.surface;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.divider;

    VerticalLayout {
        padding: root.compact ? 12px : 16px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            Text {
                text: root.title;
                color: Theme.muted-text;
                font-size: Type.body-size;
                font-weight: Type.body-weight;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            Image {
                width: 24px;
                height: 24px;
                source: root.icon;
                colorize: root.accent;
                accessible-role: none;
            }
        }

        Text {
            text: root.value;
            color: root.value-color;
            // FinDesk shrinks the value (TextAutoSize) in narrow cards; Slint can't size text to its
            // box, so narrow windows step down once and the value elides rather than push the row
            // past the page.
            font-size: root.compact ? 18px : Type.headline-size;
            font-weight: Type.amount-weight;
            overflow: elide;
        }

        if (root.subtitle != "") : Text {
            text: root.subtitle;
            color: Theme.muted-text;
            font-size: Type.body-small-size;
            wrap: word-wrap;
        }
    }

    TouchArea {
        enabled: root.interactive;
        clicked => {
            if (root.interactive) {
                root.clicked();
            }
        }
    }
}

// A card with a heading.
component SectionCard inherits Rectangle {
    in property <string> title;

    border-radius: Radius.surface;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.divider;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        if (root.title != "") : Text {
            text: root.title;
            color: Theme.text;
            font-size: Type.title-medium-size;
            font-weight: Type.title-medium-weight;
            overflow: elide;
        }

        @children
    }
}

// A centred empty state with a simple document-like icon.
component ReportEmpty inherits Rectangle {
    in property <string> title;
    in property <string> hint;

    background: transparent;

    VerticalLayout {
        padding: 40px;
        spacing: 10px;
        alignment: center;

        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: Radius.panel;
            border-width: 2px;
            border-color: Theme.muted-text;
            background: transparent;

            Rectangle {
                x: 12px;
                y: 12px;
                width: 8px;
                height: 18px;
                border-radius: Radius.hairline;
                background: Theme.muted-text;
            }
            Rectangle {
                x: 23px;
                y: 18px;
                width: 8px;
                height: 12px;
                border-radius: Radius.hairline;
                background: Theme.muted-text;
            }
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Type.title-medium-size;
            font-weight: Type.title-medium-weight;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.hint;
            color: Theme.muted-text;
            font-size: Type.body-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// The shared column widths of the recurring payments table, so every row lines up with the header.
global RecurringLayout {
    out property <length> every-width: 110px;
    out property <length> next-width: 100px;
    out property <length> amount-width: 130px;
    out property <length> yearly-width: 130px;
}

// One entry of the Reports page's Export menu.
export component ReportMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> highlighted: false;

    callback picked;

    height: 36px;
    border-radius: Radius.small;
    background: root.highlighted && root.enabled ? Theme.selected : (touch.has-hover && root.enabled ? Theme.background : transparent);

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        color: !root.enabled ? Theme.muted-text : (root.highlighted ? Theme.on-selected : Theme.text);
        font-size: Type.body-size;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.picked();
            }
        }
    }
}

// The Reports page, ported from FinDesk's ReportsScreen: period controls, exports, five tabs, tax
// bookings with keyword suggestions and recurring payments.
export component ReportsPage inherits Rectangle {
    // Narrow window: the stat cards use a smaller value size.
    in property <bool> compact: false;
    in property <string> tab: "summary";

    in property <string> year-label;
    in property <bool> custom;
    in property <string> range-from;
    in property <string> range-to;
    in property <string> range-error;
    in property <bool> loading;
    in property <bool> exporting;
    in property <bool> has-report;
    in property <bool> empty;
    in property <string> empty-title;
    in property <string> empty-hint;
    in property <string> error-text;
    in property <string> message-text;
    in property <bool> can-export-report;
    in property <bool> can-export-tax;
    in property <string> export-disabled-reason;
    in-out property <bool> export-menu-open: false;
    in property <bool> linkable;

    in property <string> other-currency-hint;
    in property <string> income-value;
    in property <string> expenses-value;
    in property <string> net-value;
    in property <string> tax-value;
    in property <string> net-tone;
    in property <[ReportAmountRow]> tax-relevant-rows;
    in property <string> tax-relevant-empty;
    in property <string> stat-transactions;
    in property <string> stat-categories;
    in property <string> stat-average;
    in property <string> stat-highest;

    in property <string> monthly-title;
    in property <[ReportMonthlyRow]> monthly-rows;
    in property <string> monthly-total-income;
    in property <string> monthly-total-expenses;
    in property <string> monthly-total-net;
    in property <string> monthly-total-tone;
    in property <bool> monthly-total-income-zero;
    in property <bool> monthly-total-expenses-zero;
    in property <bool> monthly-total-net-zero;

    in property <[DashboardCategoryRow]> category-rows;
    in property <string> transfers-note;
    in property <[ReportVendorRow]> vendor-rows;

    in property <bool> recurring-empty;
    in property <string> recurring-count;
    in property <string> recurring-yearly;
    in property <string> recurring-monthly;
    in property <[ReportRecurringRow]> recurring-rows;

    in property <bool> has-tax;
    in property <bool> tax-empty;
    in property <string> tax-income-value;
    in property <string> tax-deduction-value;
    in property <string> tax-net-value;
    in property <string> tax-net-tone;
    in property <string> tax-receipts-value;
    in property <string> tax-receipts-subtitle;
    in property <bool> tax-receipts-missing;
    in property <string> tax-other-hint;
    in property <string> tax-suggestions-title;
    in property <string> tax-suggestions-hint;
    in property <[ReportSuggestionRow]> tax-suggestions;
    in property <bool> missing-receipts-only;
    in property <string> tax-empty-title;
    in property <string> tax-empty-hint;
    in property <[ReportTaxRow]> tax-rows;

    property <bool> custom-edit: root.custom;
    property <string> from-edit: root.range-from;
    property <string> to-edit: root.range-to;
    callback select-tab(string);
    callback set-custom(bool);
    callback change-year(int);
    callback apply-range(string, string);
    callback export-report-pdf;
    callback export-csv;
    callback export-tax-xlsx;
    callback export-tax-pdf;
    callback print-tax;
    callback set-missing-only(bool);
    callback accept-suggestion(int);
    callback dismiss-suggestion(int);
    callback mark-not-tax-relevant(int);
    callback reset-tax-automatic(int);
    callback open-category(int);
    callback dismiss;

    property <bool> busy: root.loading || root.exporting;
    property <int> menu-selected: 0;
    property <bool> menu-navigated: false;

    changed custom => { root.custom-edit = root.custom; }
    changed range-from => { root.from-edit = root.range-from; }
    changed range-to => { root.to-edit = root.range-to; }
    changed tab => { root.export-menu-open = false; }

    function menu-count() -> int {
        return root.tab == "tax" ? 5 : 2;
    }

    function menu-item-enabled(index: int) -> bool {
        if (root.tab == "tax" && index < 3) {
            return root.can-export-tax && !root.busy;
        }
        return root.can-export-report && !root.busy;
    }

    function open-export-menu() {
        root.menu-selected = 0;
        root.menu-navigated = false;
        root.export-menu-open = true;
        menu-focus.focus();
    }

    function close-export-menu() {
        root.export-menu-open = false;
    }

    function activate-menu-item(index: int) {
        if (!root.menu-item-enabled(index)) {
            return;
        }
        root.close-export-menu();
        if (root.tab == "tax") {
            if (index == 0) {
                root.export-tax-xlsx();
            } else if (index == 1) {
                root.export-tax-pdf();
            } else if (index == 2) {
                root.print-tax();
            } else if (index == 3) {
                root.export-report-pdf();
            } else {
                root.export-csv();
            }
        } else if (index == 0) {
            root.export-report-pdf();
        } else {
            root.export-csv();
        }
    }

    background: Theme.background;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        // One header row, as FinDesk has it: the period controls, a flexible gap and the Export menu.
        HorizontalLayout {
            spacing: 16px;
            cross-axis-alignment: center;

            if (root.tab != "recurring") : SegmentedButton {
                labels: [Tr.t("TaxYear"), Tr.t("CustomRange")];
                selected: root.custom-edit ? 1 : 0;
                select(index) => {
                    root.custom-edit = index == 1;
                    root.set-custom(index == 1);
                }
            }

            if (root.tab != "recurring" && !root.custom-edit) : HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                // Outlined round buttons, so the year switcher reads as navigation. They stay enabled
                // while a year loads (a click then is ignored in Rust), so nothing flickers.
                IconButton {
                    icon: @image-url("icons/keyboard_arrow_left.svg");
                    icon-color: Theme.primary;
                    outlined: true;
                    label: Tr.t("PreviousYear");
                    tooltip-text: Tr.t("PreviousYear");
                    enabled: !root.exporting;
                    clicked => { root.change-year(-1); }
                }
                // A fixed width: proportional digits would move the arrows from year to year.
                Text {
                    width: 76px;
                    text: root.year-label;
                    color: Theme.text;
                    font-size: Type.headline-size;
                    font-weight: Type.headline-weight;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: @image-url("icons/keyboard_arrow_right.svg");
                    icon-color: Theme.primary;
                    outlined: true;
                    label: Tr.t("NextYear");
                    tooltip-text: Tr.t("NextYear");
                    enabled: !root.exporting;
                    clicked => { root.change-year(1); }
                }
            }

            if (root.tab != "recurring" && root.custom-edit) : HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                DateField {
                    label: Tr.t("FromDate");
                    text: root.from-edit;
                    enabled: !root.busy;
                    edited(value) => { root.from-edit = value; }
                }
                DateField {
                    label: Tr.t("ToDate");
                    text: root.to-edit;
                    enabled: !root.busy;
                    edited(value) => { root.to-edit = value; }
                }
                SecondaryButton {
                    text: Tr.t("Apply");
                    enabled: !root.busy;
                    clicked => { root.apply-range(root.from-edit, root.to-edit); }
                }
            }

            // The spinner's place is always reserved, so starting a load doesn't shift the row.
            Rectangle {
                width: 20px;
                height: 20px;

                if (root.tab != "recurring" && root.loading) : Spinner {
                    width: 20px;
                    height: 20px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            if (root.exporting) : Spinner {
                width: 20px;
                height: 20px;
            }

            export-anchor := PrimaryButton {
                text: Tr.t("Export");
                icon: @image-url("icons/file_download.svg");
                has-icon: true;
                tooltip-text: root.export-disabled-reason;
                enabled: root.can-export-report && !root.busy;
                clicked => { root.open-export-menu(); }
            }
        }

        if (root.range-error != "") : Text {
            text: root.range-error;
            color: Theme.error;
            font-size: Type.body-small-size;
        }

        if (root.message-text != "" || root.error-text != "") : MessageBanner {
            text: root.error-text != "" ? root.error-text : root.message-text;
            is-error: root.error-text != "";
            dismissed => { root.dismiss(); }
        }

        Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: Theme.divider;

            HorizontalLayout {
                spacing: 0px;

                ReportTab {
                    text: Tr.t("TabTaxSummary");
                    selected: root.tab == "summary";
                    clicked => { root.select-tab("summary"); }
                }
                ReportTab {
                    text: Tr.t("TabTaxBookings");
                    selected: root.tab == "tax";
                    clicked => { root.select-tab("tax"); }
                }
                ReportTab {
                    text: Tr.t("TabMonthlyBreakdown");
                    selected: root.tab == "monthly";
                    clicked => { root.select-tab("monthly"); }
                }
                ReportTab {
                    text: Tr.t("TabCategoryAnalysis");
                    selected: root.tab == "category";
                    clicked => { root.select-tab("category"); }
                }
                ReportTab {
                    text: Tr.t("TabRecurring");
                    selected: root.tab == "recurring";
                    clicked => { root.select-tab("recurring"); }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 16px;
                alignment: start;

                if (root.tab == "recurring") : VerticalLayout {
                    spacing: 16px;

                    if (root.recurring-empty) : ReportEmpty {
                        title: Tr.t("NoRecurringFound");
                        hint: Tr.t("RecurringHint");
                    }

                    if (!root.recurring-empty) : VerticalLayout {
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 16px;

                            ReportStat {
                            compact: root.compact;
                                horizontal-stretch: 1;
                                title: Tr.t("RecurringPayments");
                                value: root.recurring-count;
                                icon: @image-url("icons/refresh.svg");
                                accent: Theme.primary;
                            }
                            ReportStat {
                            compact: root.compact;
                                horizontal-stretch: 1;
                                title: Tr.t("CostPerYear");
                                value: root.recurring-yearly;
                                icon: @image-url("icons/remove_circle_outline.svg");
                                accent: Theme.error;
                                value-color: Theme.error;
                            }
                            ReportStat {
                            compact: root.compact;
                                horizontal-stretch: 1;
                                title: Tr.t("PerMonth");
                                value: root.recurring-monthly;
                                icon: @image-url("icons/date_range.svg");
                                accent: Theme.warning;
                                value-color: Theme.error;
                            }
                        }

                        SectionCard {
                            title: Tr.t("SubscriptionsTitle");

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Text {
                                    text: Tr.t("ColName");
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    color: Theme.muted-text;
                                    font-size: Type.label-size;
                                    font-weight: Type.label-weight;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: Tr.t("ColEvery");
                                    width: RecurringLayout.every-width;
                                    color: Theme.muted-text;
                                    font-size: Type.label-size;
                                    font-weight: Type.label-weight;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: Tr.t("ColNext");
                                    width: RecurringLayout.next-width;
                                    color: Theme.muted-text;
                                    font-size: Type.label-size;
                                    font-weight: Type.label-weight;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: Tr.t("ColAmount");
                                    width: RecurringLayout.amount-width;
                                    color: Theme.muted-text;
                                    font-size: Type.label-size;
                                    font-weight: Type.label-weight;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: Tr.t("ColPerYear");
                                    width: RecurringLayout.yearly-width;
                                    color: Theme.muted-text;
                                    font-size: Type.label-size;
                                    font-weight: Type.label-weight;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            for row in root.recurring-rows : Rectangle {
                                height: 52px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: row.name;
                                            color: Theme.text;
                                            font-size: Type.label-size;
                                            font-weight: Type.label-weight;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.meta;
                                            color: Theme.muted-text;
                                            font-size: Type.body-small-size;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: row.cadence;
                                        width: RecurringLayout.every-width;
                                        color: Theme.text;
                                        font-size: Type.body-size;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.next-text;
                                        width: RecurringLayout.next-width;
                                        color: Theme.text;
                                        font-size: Type.body-size;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.amount-text;
                                        width: RecurringLayout.amount-width;
                                        color: row.income ? Theme.success : Theme.error;
                                        font-size: Type.body-size;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.yearly-text;
                                        width: RecurringLayout.yearly-width;
                                        color: Theme.text;
                                        font-size: Type.body-size;
                                        font-weight: Type.title-medium-weight;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    y: parent.height - self.height;
                                    height: 1px;
                                    background: Theme.divider;
                                }
                            }
                        }
                    }
                }

                if (root.tab != "recurring" && !root.has-report) : VerticalLayout {
                    padding: 40px;
                    alignment: center;

                    Spinner {
                        width: 24px;
                        height: 24px;
                    }
                }

                if (root.tab != "recurring" && root.has-report && root.empty) : ReportEmpty {
                    title: root.empty-title;
                    hint: root.empty-hint;
                }

                if (root.tab == "summary" && root.has-report && !root.empty) : VerticalLayout {
                    spacing: 16px;

                    if (root.other-currency-hint != "") : Text {
                        text: root.other-currency-hint;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("TotalIncome");
                            value: root.income-value;
                            icon: @image-url("icons/add_circle_outline.svg");
                            accent: Theme.success;
                            value-color: Theme.success;
                        }
                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("TotalExpenses");
                            value: root.expenses-value;
                            icon: @image-url("icons/remove_circle_outline.svg");
                            accent: Theme.error;
                            value-color: Theme.error;
                        }
                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("NetIncome");
                            icon: @image-url("icons/reports.svg");
                            value: root.net-value;
                            accent: Theme.primary;
                            value-color: root.net-tone == "negative" ? Theme.error : (root.net-tone == "positive" ? Theme.success : Theme.text);
                        }
                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("TaxRelevantAmount");
                            value: root.tax-value;
                            icon: @image-url("icons/info.svg");
                            accent: Theme.warning;
                        }
                    }

                    SectionCard {
                        title: Tr.t("TaxRelevantByCategory");

                        if (root.tax-relevant-empty != "") : Text {
                            text: root.tax-relevant-empty;
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                            wrap: word-wrap;
                        }

                        for row in root.tax-relevant-rows : HorizontalLayout {
                            height: 28px;
                            spacing: 8px;

                            Text {
                                text: row.label;
                                horizontal-stretch: 1;
                                color: Theme.text;
                                font-size: Type.body-size;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.amount-text;
                                color: Theme.text;
                                font-size: Type.label-size;
                                font-weight: Type.label-weight;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("StatTransactions");
                            value: root.stat-transactions;
                            icon: @image-url("icons/transactions.svg");
                            accent: Theme.primary;
                        }
                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("CategoriesUsed");
                            value: root.stat-categories;
                            icon: @image-url("icons/transactions.svg");
                            accent: Theme.primary;
                        }
                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("AvgMonthlyExpenses");
                            value: root.stat-average;
                            icon: @image-url("icons/date_range.svg");
                            accent: Theme.primary;
                            value-color: Theme.error;
                        }
                        ReportStat {
                            compact: root.compact;
                            horizontal-stretch: 1;
                            title: Tr.t("HighestMonth");
                            value: root.stat-highest;
                            icon: @image-url("icons/reports.svg");
                            accent: Theme.primary;
                        }
                    }
                }

                if (root.tab == "monthly" && root.has-report && !root.empty) : SectionCard {
                    title: root.monthly-title;

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            text: Tr.t("ColMonth");
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: Theme.muted-text;
                            font-size: Type.label-size;
                            font-weight: Type.label-weight;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Tr.t("ColIncome");
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: Theme.muted-text;
                            font-size: Type.label-size;
                            font-weight: Type.label-weight;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Tr.t("ColExpenses");
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: Theme.muted-text;
                            font-size: Type.label-size;
                            font-weight: Type.label-weight;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: Tr.t("ColNet");
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: Theme.muted-text;
                            font-size: Type.label-size;
                            font-weight: Type.label-weight;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    for row in root.monthly-rows : Rectangle {
                        height: 40px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Text {
                                text: row.month;
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                min-width: 0px;
                                color: Theme.text;
                                font-size: Type.body-size;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.income-text;
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                min-width: 0px;
                                color: row.income-zero ? Theme.text : Theme.success;
                                font-size: Type.body-size;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.expenses-text;
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                min-width: 0px;
                                color: row.expenses-zero ? Theme.text : Theme.error;
                                font-size: Type.body-size;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.net-text;
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                min-width: 0px;
                                color: row.net-zero ? Theme.text : (row.net-tone == "negative" ? Theme.error : Theme.success);
                                font-size: Type.body-size;
                                font-weight: row.net-zero ? Type.body-weight : Type.title-medium-weight;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            y: parent.height - self.height;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }

                    HorizontalLayout {
                        height: 40px;
                        horizontal-stretch: 1;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text {
                            text: Tr.t("ReportTotal");
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: Theme.text;
                            font-size: Type.label-size;
                            font-weight: Type.title-medium-weight;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.monthly-total-income;
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: root.monthly-total-income-zero ? Theme.text : Theme.success;
                            font-size: Type.label-size;
                            font-weight: Type.title-medium-weight;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.monthly-total-expenses;
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: root.monthly-total-expenses-zero ? Theme.text : Theme.error;
                            font-size: Type.label-size;
                            font-weight: Type.title-medium-weight;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.monthly-total-net;
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            color: root.monthly-total-net-zero ? Theme.text : (root.monthly-total-tone == "negative" ? Theme.error : Theme.success);
                            font-size: Type.label-size;
                            font-weight: Type.title-medium-weight;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }
                }

                if (root.tab == "category" && root.has-report && !root.empty) : VerticalLayout {
                    spacing: 16px;

                    SectionCard {
                        title: Tr.t("SpendingByCategory");

                        CategorySplit {
                            rows: root.category-rows;
                            transfers-note: root.transfers-note;
                            selectable: root.linkable;
                            select(id) => { root.open-category(id); }
                        }
                    }

                    SectionCard {
                        title: Tr.t("TopVendors");

                        for row[index] in root.vendor-rows : Rectangle {
                            height: 40px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Text {
                                    text: row.rank;
                                    width: 28px;
                                    color: Theme.muted-text;
                                    font-size: Type.body-size;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: row.name;
                                    horizontal-stretch: 1;
                                    color: Theme.text;
                                    font-size: Type.body-size;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.amount-text;
                                    color: Theme.text;
                                    font-size: Type.label-size;
                                    font-weight: Type.title-medium-weight;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            if (index < root.vendor-rows.length - 1) : Rectangle {
                                y: parent.height - self.height;
                                height: 1px;
                                background: Theme.divider;
                            }
                        }
                    }
                }

                if (root.tab == "tax" && root.has-report && !root.empty) : VerticalLayout {
                    spacing: 16px;

                    if (root.has-tax) : VerticalLayout {
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 16px;

                            ReportStat {
                            compact: root.compact;
                                horizontal-stretch: 1;
                                title: Tr.t("TaxIncomeTotal");
                                value: root.tax-income-value;
                                icon: @image-url("icons/add_circle_outline.svg");
                                accent: Theme.success;
                                value-color: Theme.success;
                            }
                            ReportStat {
                            compact: root.compact;
                                horizontal-stretch: 1;
                                title: Tr.t("TaxDeductionTotal");
                                value: root.tax-deduction-value;
                                icon: @image-url("icons/remove_circle_outline.svg");
                                accent: Theme.error;
                                value-color: Theme.error;
                            }
                            ReportStat {
                            compact: root.compact;
                                horizontal-stretch: 1;
                                title: Tr.t("NetIncome");
                                icon: @image-url("icons/reports.svg");
                                value: root.tax-net-value;
                                accent: Theme.primary;
                                value-color: root.tax-net-tone == "negative" ? Theme.error : (root.tax-net-tone == "positive" ? Theme.success : Theme.text);
                            }
                            ReportStat {
                            compact: root.compact;
                                horizontal-stretch: 1;
                                title: Tr.t("TaxReceipts");
                                value: root.tax-receipts-value;
                                subtitle: root.tax-receipts-subtitle;
                                icon: root.tax-receipts-missing ? @image-url("icons/warning.svg") : @image-url("icons/check_circle.svg");
                                accent: root.tax-receipts-missing ? Theme.warning : Theme.success;
                                value-color: root.tax-receipts-missing ? Theme.text : Theme.success;
                                interactive: root.tax-receipts-missing;
                                clicked => { root.set-missing-only(true); }
                            }
                        }

                        if (root.tax-other-hint != "") : Text {
                            text: root.tax-other-hint;
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            wrap: word-wrap;
                        }

                        if (root.tax-suggestions.length > 0) : SectionCard {
                            title: root.tax-suggestions-title;

                            Text {
                                text: root.tax-suggestions-hint;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }

                            for suggestion in root.tax-suggestions : Rectangle {
                                height: 56px;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: suggestion.date-text;
                                        width: 88px;
                                        color: Theme.text;
                                        font-size: Type.body-size;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: suggestion.title;
                                            color: Theme.text;
                                            font-size: Type.body-size;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: suggestion.keyword-text;
                                            color: Theme.muted-text;
                                            font-size: Type.body-small-size;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: suggestion.amount-text;
                                        width: 110px;
                                        color: suggestion.expense ? Theme.error : Theme.success;
                                        font-size: Type.label-size;
                                        font-weight: Type.title-medium-weight;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    TextButton {
                                        text: Tr.t("Accept");
                                        enabled: !root.busy;
                                        clicked => { root.accept-suggestion(suggestion.id); }
                                    }
                                    TextButton {
                                        text: Tr.t("DismissSuggestion");
                                        enabled: !root.busy;
                                        clicked => { root.dismiss-suggestion(suggestion.id); }
                                    }
                                }

                                Rectangle {
                                    y: parent.height - self.height;
                                    height: 1px;
                                    background: Theme.divider;
                                }
                            }
                        }

                        check := Checkbox {
                            text: Tr.t("MissingReceiptsOnly");
                            checked: root.missing-receipts-only;
                            enabled: !root.busy;
                            toggled => { root.set-missing-only(check.checked); }
                        }

                        if (root.tax-empty) : ReportEmpty {
                            title: root.tax-empty-title;
                            hint: root.tax-empty-hint;
                        }

                        if (!root.tax-empty) : VerticalLayout {
                            spacing: 8px;

                            for row in root.tax-rows : VerticalLayout {
                                spacing: 0px;

                                if (row.kind == "section") : Text {
                                    height: 32px;
                                    text: row.title;
                                    color: Theme.text;
                                    font-size: Type.title-medium-size;
                                    font-weight: Type.title-medium-weight;
                                    vertical-alignment: bottom;
                                }

                                if (row.kind == "group") : Rectangle {
                                    height: 52px;
                                    border-radius: Radius.panel;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.divider;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 12px;
                                        cross-axis-alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 12px;
                                                height: 12px;
                                                border-radius: Radius.small;
                                                background: row.colour;
                                            }
                                        }
                                        Text {
                                            text: row.title;
                                            horizontal-stretch: 1;
                                            color: Theme.text;
                                            font-size: Type.title-medium-size;
                                            font-weight: Type.title-medium-weight;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.summary;
                                            color: Theme.text;
                                            font-size: Type.body-size;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if (row.kind == "booking") : Rectangle {
                                    border-radius: Radius.panel;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.divider;

                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: row.date-text;
                                            width: 88px;
                                            color: Theme.text;
                                            font-size: Type.body-size;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            alignment: center;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                cross-axis-alignment: center;

                                                Text {
                                                    text: row.title;
                                                    horizontal-stretch: 1;
                                                    color: Theme.text;
                                                    font-size: Type.body-size;
                                                    font-weight: Type.label-weight;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                if (row.account-text != "") : Text {
                                                    text: row.account-text;
                                                    color: Theme.muted-text;
                                                    font-size: Type.body-small-size;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                cross-axis-alignment: center;

                                                Text {
                                                    text: row.subtitle;
                                                    horizontal-stretch: 1;
                                                    color: Theme.muted-text;
                                                    font-size: Type.body-small-size;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                if (row.has-receipt) : Rectangle {
                                                    width: 14px;
                                                    height: 16px;
                                                    border-radius: Radius.dot;
                                                    border-width: 1px;
                                                    border-color: Theme.primary;
                                                    background: transparent;

                                                    Rectangle {
                                                        x: 3px;
                                                        y: 4px;
                                                        width: parent.width - 6px;
                                                        height: 2px;
                                                        background: Theme.primary;
                                                    }
                                                    Rectangle {
                                                        x: 3px;
                                                        y: 8px;
                                                        width: parent.width - 6px;
                                                        height: 2px;
                                                        background: Theme.primary;
                                                    }
                                                }
                                                if (row.missing-receipt) : Text {
                                                    text: Tr.t("NoReceipt");
                                                    color: Theme.muted-text;
                                                    font-size: Type.body-small-size;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Text {
                                            text: row.amount-text;
                                            width: 110px;
                                            color: row.expense ? Theme.error : Theme.success;
                                            font-size: Type.label-size;
                                            font-weight: Type.title-medium-weight;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            width: 180px;
                                            spacing: 0px;

                                            TextButton {
                                                text: Tr.t("MarkNotTaxRelevant");
                                                min-width: 0px;
                                                enabled: !root.busy;
                                                clicked => { root.mark-not-tax-relevant(row.id); }
                                            }
                                            if (row.can-reset) : TextButton {
                                                text: Tr.t("ResetTaxAutomatic");
                                                min-width: 0px;
                                                enabled: !root.busy;
                                                clicked => { root.reset-tax-automatic(row.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if (!root.has-tax) : ReportEmpty {
                        title: root.tax-empty-title;
                        hint: root.tax-empty-hint;
                    }
                }
            }
        }
    }

    // The Export menu, anchored under the header's button. The backdrop closes it on an outside click.
    if (root.export-menu-open) : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => { root.close-export-menu(); }
        }

        Rectangle {
            x: max(0px, export-anchor.absolute-position.x - root.absolute-position.x + export-anchor.width - self.width);
            y: export-anchor.absolute-position.y - root.absolute-position.y + export-anchor.height + 4px;
            width: 220px;
            height: root.tab == "tax" ? 189px : 80px;
            background: Theme.surface;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                if (root.tab == "tax") : ReportMenuItem {
                    text: Tr.t("ExportExcel");
                    enabled: root.menu-item-enabled(0);
                    highlighted: root.menu-navigated && root.menu-selected == 0;
                    picked => { root.activate-menu-item(0); }
                }
                if (root.tab == "tax") : ReportMenuItem {
                    text: Tr.t("ExportPdf");
                    enabled: root.menu-item-enabled(1);
                    highlighted: root.menu-navigated && root.menu-selected == 1;
                    picked => { root.activate-menu-item(1); }
                }
                if (root.tab == "tax") : ReportMenuItem {
                    text: Tr.t("Print");
                    enabled: root.menu-item-enabled(2);
                    highlighted: root.menu-navigated && root.menu-selected == 2;
                    picked => { root.activate-menu-item(2); }
                }
                if (root.tab == "tax") : Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }

                ReportMenuItem {
                    text: Tr.t("ExportReport");
                    enabled: root.menu-item-enabled(root.tab == "tax" ? 3 : 0);
                    highlighted: root.menu-navigated && root.menu-selected == (root.tab == "tax" ? 3 : 0);
                    picked => { root.activate-menu-item(root.tab == "tax" ? 3 : 0); }
                }
                ReportMenuItem {
                    text: Tr.t("ExportCsv");
                    enabled: root.menu-item-enabled(root.tab == "tax" ? 4 : 1);
                    highlighted: root.menu-navigated && root.menu-selected == (root.tab == "tax" ? 4 : 1);
                    picked => { root.activate-menu-item(root.tab == "tax" ? 4 : 1); }
                }
            }
        }
    }

    menu-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        enabled: root.export-menu-open;
        // The menu entries' TouchAreas handle the mouse; without this a click would be taken for focus.
        focus-on-click: false;
        key-pressed(event) => {
            if (!root.export-menu-open) {
                return reject;
            }
            if (event.text == Key.Escape) {
                root.close-export-menu();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.menu-navigated = true;
                root.menu-selected = root.menu-selected <= 0 ? root.menu-count() - 1 : root.menu-selected - 1;
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.menu-navigated = true;
                root.menu-selected = root.menu-selected >= root.menu-count() - 1 ? 0 : root.menu-selected + 1;
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activate-menu-item(root.menu-selected);
                return accept;
            }
            return reject;
        }
    }
}
