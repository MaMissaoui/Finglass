import { ListView, ScrollView, Spinner } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    DashboardBudgetRow,
    DashboardCategoryRow,
    DashboardMonthBar,
    DashboardStatementLine,
    DashboardTaxSlice,
    DashboardTransactionRow,
    DashboardUpcomingRow,
    IconButton,
    PeriodNavigator,
    PrimaryButton,
    TextButton,
} from "components.slint";
import { CategorySplit, IncomeExpenseChart, TaxDonut } from "charts.slint";

// A dashboard card: a surface with a hairline outline and a heading.
component Card inherits Rectangle {
    in property <string> title;
    in property <bool> show-title: true;
    in property <bool> interactive: false;
    /// An optional text action right-aligned in the title row.
    in property <string> action-label: "";

    callback clicked;
    callback action-clicked;

    background: Theme.surface;
    border-radius: Radius.surface;
    border-width: 1px;
    border-color: Theme.divider;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        if (root.show-title) : HorizontalLayout {
            cross-axis-alignment: center;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title-medium-size;
                font-weight: Type.title-medium-weight;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if (root.action-label != "") : TextButton {
                text: root.action-label;
                clicked => { root.action-clicked(); }
            }
        }

        @children
    }

    TouchArea {
        enabled: root.interactive;
        clicked => {
            root.clicked();
        }
    }
}

// One line of the month statement: a label, a fixed amount column and, above the
// result, a hairline over the amount column only.
component StatementRow inherits Rectangle {
    in property <DashboardStatementLine> line;
    in property <bool> negative;
    in property <length> amount-width: 200px;

    height: root.line.kind == "result" ? 48px : 26px;
    background: transparent;

    if (root.line.kind == "result") : Rectangle {
        x: parent.width - root.amount-width;
        y: 0px;
        width: root.amount-width;
        height: 1px;
        background: Theme.text;
    }

    HorizontalLayout {
        spacing: 12px;
        padding-top: root.line.kind == "result" ? 10px : 0px;

        Text {
            text: root.line.label;
            color: (root.line.kind == "carry" || root.line.kind == "movement") ? Theme.muted-text : Theme.text;
            font-size: root.line.kind == "result" ? Type.title-medium-size : Type.body-size;
            font-weight: root.line.kind == "result" ? Type.title-medium-weight : Type.body-weight;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.line.amount-text;
            width: root.amount-width;
            horizontal-alignment: right;
            color: root.line.kind == "in" ? Theme.money-in
                 : root.line.kind == "out" ? Theme.money-out
                 : (root.line.kind == "result" && root.negative) ? Theme.alert
                 : Theme.text;
            font-size: root.line.kind == "result" ? Type.amount-size : Type.body-size;
            font-weight: root.line.kind == "result" ? Type.amount-weight : Type.body-weight;
            vertical-alignment: center;
        }
    }
}

// The left part of the statement: the month as section title, the lines and the notes.
component StatementPanel inherits Rectangle {
    in property <string> month-label;
    in property <[DashboardStatementLine]> lines;
    in property <string> notes;
    in property <string> tone;

    max-width: 560px;
    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        Text {
            text: root.month-label;
            color: Theme.text;
            font-size: Type.title-medium-size;
            font-weight: Type.title-medium-weight;
        }

        VerticalLayout {
            spacing: 2px;
            alignment: start;

            for line in root.lines : StatementRow {
                line: line;
                negative: root.tone == "negative";
                amount-width: 200px;
            }
        }

        if (root.notes != "") : Text {
            text: root.notes;
            color: Theme.muted-text;
            font-size: Type.body-small-size;
            wrap: word-wrap;
        }
    }
}

// The right part of the statement: open tasks, one click away from the uncategorized list.
component PendingPanel inherits Rectangle {
    in property <string> title;
    in property <string> count-text;
    in property <[string]> detail-lines;
    in property <bool> enabled;

    callback clicked;

    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Type.title-medium-size;
            font-weight: Type.title-medium-weight;
            overflow: elide;
        }

        Text {
            text: root.count-text;
            color: root.enabled ? Theme.caution : Theme.muted-text;
            font-size: Type.amount-size;
            font-weight: Type.amount-weight;
        }

        if (root.enabled && root.detail-lines.length > 0) : VerticalLayout {
            spacing: 0px;

            for detail in root.detail-lines : HorizontalLayout {
                height: 28px;
                spacing: 4px;

                Text {
                    text: detail;
                    color: Theme.text;
                    font-size: Type.body-size;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/keyboard_arrow_right.svg");
                        colorize: Theme.muted-text;
                        accessible-role: none;
                    }
                }
            }
        }

        if (!root.enabled && root.detail-lines.length > 0) : HorizontalLayout {
            height: 28px;
            spacing: 6px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("icons/check_circle.svg");
                    colorize: Theme.success;
                    accessible-role: none;
                }
            }

            Text {
                text: root.detail-lines[0];
                color: Theme.text;
                font-size: Type.body-size;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One booking in a dashboard list: date, title and meta, right-aligned amount.
component LedgerRow inherits Rectangle {
    in property <string> date-text;
    in property <string> title;
    in property <string> meta;
    in property <string> amount-text;
    in property <bool> expense: true;
    in property <bool> interactive: false;

    callback clicked;

    height: 44px;
    background: root.interactive && row-touch.has-hover ? Theme.background : transparent;

    HorizontalLayout {
        spacing: 12px;

        Text {
            text: root.date-text;
            width: 90px;
            color: Theme.text;
            font-size: Type.body-small-size;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
                overflow: elide;
            }

            Text {
                text: root.meta;
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                overflow: elide;
            }
        }

        Text {
            text: root.amount-text;
            color: root.expense ? Theme.money-out : Theme.money-in;
            font-size: Type.body-size;
            font-weight: Type.title-small-weight;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    row-touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One budget: name, spent of limit, progress bar and what is left.
component BudgetRow inherits Rectangle {
    in property <DashboardBudgetRow> budget;
    in property <float> month-progress;

    height: 56px;
    background: transparent;

    VerticalLayout {
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.budget.name;
                color: Theme.text;
                font-size: Type.body-small-size;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: root.budget.amount-text;
                color: Theme.money-out;
                font-size: Type.label-small-size;
                font-weight: Type.label-small-weight;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        Rectangle {
            height: 6px;
            border-radius: Radius.dot;
            background: Theme.divider;
            clip: true;

            Rectangle {
                width: parent.width * root.budget.ratio;
                height: parent.height;
                border-radius: Radius.dot;
                background: root.budget.over || root.budget.warning ? Theme.caution : root.budget.colour;
            }

            Rectangle {
                x: parent.width * root.month-progress - 1px;
                width: 2px;
                height: parent.height;
                background: Theme.text;
            }
        }

        Text {
            text: root.budget.rest-text;
            color: root.budget.over ? Theme.caution : Theme.muted-text;
            font-size: Type.body-small-size;
        }
    }
}

// The first-run card: three setup steps, then no empty figures.
component GettingStartedCard inherits Rectangle {
    callback add-bank;
    callback open-settings;

    width: 640px;
    height: card-layout.preferred-height;
    background: Theme.surface;
    border-radius: Radius.surface;
    border-width: 1px;
    border-color: Theme.divider;

    card-layout := VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: Tr.t("WelcomeTitle");
            color: Theme.text;
            font-size: Type.title-large-size;
            font-weight: Type.title-large-weight;
        }

        Text {
            text: Tr.t("GettingStartedIntro");
            color: Theme.muted-text;
            font-size: Type.body-size;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            horizontal-stretch: 1;
            cross-axis-alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: self.height / 2;
                background: Theme.selected;

                Text {
                    text: "1";
                    color: Theme.on-selected;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                width: parent.width - 40px;

                Text {
                    text: Tr.t("StepAddBank");
                    color: Theme.text;
                    font-size: Type.title-small-size;
                    font-weight: Type.title-small-weight;
                }
                Text {
                    text: Tr.t("StepAddBankHint");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
                PrimaryButton {
                    width: 140px;
                    text: Tr.t("AddBank");
                    icon: @image-url("icons/add.svg");
                    has-icon: true;
                    clicked => {
                        root.add-bank();
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            horizontal-stretch: 1;
            cross-axis-alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: self.height / 2;
                background: Theme.selected;

                Text {
                    text: "2";
                    color: Theme.on-selected;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                width: parent.width - 40px;

                Text {
                    text: Tr.t("StepSync");
                    color: Theme.text;
                    font-size: Type.title-small-size;
                    font-weight: Type.title-small-weight;
                }
                Text {
                    text: Tr.t("StepSyncHint");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            horizontal-stretch: 1;
            cross-axis-alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: self.height / 2;
                background: Theme.selected;

                Text {
                    text: "3";
                    color: Theme.on-selected;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                width: parent.width - 40px;

                Text {
                    text: Tr.t("StepCategorize");
                    color: Theme.text;
                    font-size: Type.title-small-size;
                    font-weight: Type.title-small-weight;
                }
                Text {
                    text: Tr.t("StepCategorizeHint");
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    TextButton {
                        text: Tr.t("OpenSettings");
                        clicked => {
                            root.open-settings();
                        }
                    }
                }
            }
        }
    }
}

export component DashboardPage inherits Rectangle {
    in property <bool> loading;
    in property <bool> first-run;
    in property <bool> show-content;
    in property <string> error-text;

    in property <string> month-label;
    in property <[string]> month-options;
    in property <int> month-selected-index;
    in property <bool> previous-enabled;
    in property <bool> next-enabled;
    in property <bool> is-current-month;
    in-out property <bool> month-menu-open: false;
    property <int> month-menu-index: 0;

    changed month-menu-open => {
        if (root.month-menu-open) {
            root.month-menu-index = root.month-selected-index;
        }
    }

    in property <string> available-title;
    in property <string> available-value;
    in property <string> available-subtitle;
    in property <string> available-tone;
    in property <[DashboardStatementLine]> statement-lines;
    in property <string> income-title;
    in property <string> income-value;
    in property <string> expenses-title;
    in property <string> expenses-value;
    in property <string> pending-title;
    in property <string> pending-value;
    in property <string> pending-subtitle;
    in property <[string]> pending-lines;
    in property <bool> pending-enabled;
    // The window width, so the statement can stack below 900 px even when the page is narrower.
    in property <length> window-width: 1100px;

    in property <string> expenses-section-title;
    in property <string> expenses-empty-text;
    in property <[DashboardCategoryRow]> expense-rows;
    in property <string> transfers-note;

    in property <string> chart-title;
    in property <string> chart-empty-text;
    in property <string> chart-axis-top;
    in property <string> chart-axis-mid;
    in property <string> chart-axis-zero;
    in property <[DashboardMonthBar]> month-bars;
    in property <string> income-legend;
    in property <string> expenses-legend;
    in property <string> partial-note;

    in property <string> budgets-title;
    in property <[DashboardBudgetRow]> budget-rows;
    in property <bool> has-budgets;
    in property <float> month-progress;

    in property <string> tax-title;
    in property <string> tax-hint;
    in property <string> tax-value;
    in property <[DashboardTaxSlice]> tax-slices;

    in property <string> upcoming-title;
    in property <[DashboardUpcomingRow]> upcoming-rows;
    in property <bool> has-upcoming;

    in property <string> recent-title;
    in property <string> recent-empty-text;
    in property <[DashboardTransactionRow]> recent-rows;
    in property <string> view-all-label;

    callback previous-month;
    callback next-month;
    callback current-month;
    callback select-month(int);
    callback open-category(int);
    callback open-uncategorized;
    callback open-all;
    callback open-partner(string);
    callback open-accounts;
    callback open-settings;
    callback open-tax;
    callback dismiss-error;

    background: Theme.background;

    ScrollView {
        VerticalLayout {
            padding: 20px;
            spacing: 24px;
            alignment: start;

            if (root.error-text != "") : Rectangle {
                background: Theme.surface;
                border-radius: Radius.panel;
                border-width: 1px;
                border-color: Theme.error;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;

                    Image {
                        width: 20px;
                        height: 20px;
                        source: @image-url("icons/warning.svg");
                        colorize: Theme.error;
                        accessible-role: none;
                    }

                    Text {
                        text: root.error-text;
                        color: Theme.error;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        icon: @image-url("icons/close.svg");
                        label: Tr.t("Dismiss");
                        tooltip-text: Tr.t("Dismiss");
                        icon-size: 18px;
                        clicked => {
                            root.dismiss-error();
                        }
                    }
                }
            }

            if (root.first-run) : GettingStartedCard {
                add-bank => {
                    root.open-accounts();
                }
                open-settings => {
                    root.open-settings();
                }
            }

            if (!root.first-run && !root.show-content && root.loading) : Rectangle {
                height: 240px;
                background: transparent;

                Spinner {
                    width: 32px;
                    height: 32px;
                }
            }

            if (!root.first-run && root.show-content) : VerticalLayout {
                spacing: 24px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    PeriodNavigator {
                        title: root.month-label;
                        previous-enabled: root.previous-enabled;
                        next-enabled: root.next-enabled;
                        previous-label: Tr.t("PreviousMonth");
                        next-label: Tr.t("NextMonth");
                        title-has-menu: true;
                        previous => { root.previous-month(); }
                        next => { root.next-month(); }
                        title-clicked => {
                            root.month-menu-index = root.month-selected-index;
                            root.month-menu-open = !root.month-menu-open;
                        }
                    }

                    if (!root.is-current-month) : TextButton {
                        text: Tr.t("CurrentMonth");
                        clicked => {
                            root.current-month();
                        }
                    }
                }

                Rectangle {
                    background: Theme.surface;
                    border-radius: Radius.surface;
                    border-width: 1px;
                    border-color: Theme.divider;
                    clip: true;

                    VerticalLayout {
                        if (root.window-width < 900px) : VerticalLayout {
                            StatementPanel {
                                month-label: root.month-label;
                                lines: root.statement-lines;
                                notes: root.available-subtitle;
                                tone: root.available-tone;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            PendingPanel {
                                title: root.pending-title;
                                count-text: root.pending-value;
                                detail-lines: root.pending-lines;
                                enabled: root.pending-enabled;
                                clicked => {
                                    root.open-uncategorized();
                                }
                            }
                        }

                        if (root.window-width >= 900px) : HorizontalLayout {
                            StatementPanel {
                                horizontal-stretch: 3;
                                preferred-width: 0px;
                                min-width: 0px;
                                month-label: root.month-label;
                                lines: root.statement-lines;
                                notes: root.available-subtitle;
                                tone: root.available-tone;
                            }

                            Rectangle {
                                width: 1px;
                                background: Theme.divider;
                            }

                            PendingPanel {
                                horizontal-stretch: 2;
                                preferred-width: 0px;
                                min-width: 0px;
                                title: root.pending-title;
                                count-text: root.pending-value;
                                detail-lines: root.pending-lines;
                                enabled: root.pending-enabled;
                                clicked => {
                                    root.open-uncategorized();
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    // Both cards take the taller one's content height, so their bottoms line up.
                    Card {
                        horizontal-stretch: 3;
                        title: root.expenses-section-title;

                        if (root.expense-rows.length == 0) : Text {
                            text: root.expenses-empty-text;
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                            wrap: word-wrap;
                        }

                        if (root.expense-rows.length > 0) : CategorySplit {
                            rows: root.expense-rows;
                            transfers-note: root.transfers-note;
                            select(category-id) => {
                                root.open-category(category-id);
                            }
                        }
                    }

                    Card {
                        horizontal-stretch: 2;
                        title: root.chart-title;

                        IncomeExpenseChart {
                            bars: root.month-bars;
                            axis-top: root.chart-axis-top;
                            axis-mid: root.chart-axis-mid;
                            axis-zero: root.chart-axis-zero;
                            empty-text: root.chart-empty-text;
                            income-label: root.income-legend;
                            expenses-label: root.expenses-legend;
                            partial-note: root.partial-note;
                        }
                    }
                }

                if (root.has-upcoming) : Card {
                    title: root.upcoming-title;

                    for payment in root.upcoming-rows : LedgerRow {
                        date-text: payment.date-text;
                        title: payment.title;
                        meta: payment.meta;
                        amount-text: payment.amount-text;
                        expense: payment.expense;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    if (root.has-budgets) : Card {
                        horizontal-stretch: 1;
                        title: root.budgets-title;

                        for budget in root.budget-rows : BudgetRow {
                            budget: budget;
                            month-progress: root.month-progress;
                        }
                    }

                    Card {
                        horizontal-stretch: 1;
                        title: root.tax-title;
                        // The whole card opens the Tax bookings tab for the loaded month's year.
                        interactive: true;
                        clicked => { root.open-tax(); }

                        if (root.tax-slices.length == 0) : Text {
                            text: root.tax-hint;
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                            wrap: word-wrap;
                        }

                        if (root.tax-slices.length > 0) : TaxDonut {
                            slices: root.tax-slices;
                            total-text: root.tax-value;
                        }
                    }
                }

                Card {
                    title: root.recent-title;
                    action-label: root.view-all-label;
                    action-clicked => {
                        root.open-all();
                    }

                    if (root.recent-rows.length == 0) : Text {
                        text: root.recent-empty-text;
                        color: Theme.muted-text;
                        font-size: Type.body-size;
                    }

                    for booking in root.recent-rows : LedgerRow {
                        date-text: booking.date-text;
                        title: booking.title;
                        meta: booking.meta;
                        amount-text: booking.amount-text;
                        expense: booking.expense;
                        interactive: true;
                        clicked => {
                            if (booking.partner != "") {
                                root.open-partner(booking.partner);
                            } else {
                                root.open-all();
                            }
                        }
                    }
                }
            }
        }
    }

    // The month drop-down, with the same full-page backdrop as the top bar's menus.
    if (root.month-menu-open) : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => {
                root.month-menu-open = false;
            }
        }

        Rectangle {
            x: 64px;
            y: 60px;
            width: 200px;
            height: min(root.month-options.length * 36px + 16px, 340px);
            border-radius: Radius.menu;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            border-width: 1px;
            border-color: Theme.divider;
            background: Theme.surface;
            clip: true;

            VerticalLayout {
                padding: 8px;

                ListView {
                    for option[index] in root.month-options : Rectangle {
                        height: 36px;
                        border-radius: Radius.small;
                        background: index == root.month-menu-index ? Theme.selected : (option-touch.has-hover ? Theme.background : transparent);
                        accessible-role: button;
                        accessible-label: option;

                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: option;
                            color: index == root.month-menu-index ? Theme.on-selected : Theme.text;
                            font-size: Type.body-size;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }

                        option-touch := TouchArea {
                            clicked => {
                                root.month-menu-open = false;
                                root.month-menu-index = index;
                                root.select-month(index);
                            }
                        }
                    }
                }
            }
        }
    }
}
