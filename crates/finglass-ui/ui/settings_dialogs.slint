import { ScrollView, Spinner } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import { Checkbox, OutlinedField, PrimaryButton, SelectPill, TextButton } from "components.slint";
import { ColourSwatch } from "models.slint";

// A modal confirmation with a title, a body and two actions.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> confirm-text;
    in property <bool> busy: false;
    in property <bool> destructive: true;

    callback confirm;
    callback cancel;

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 440px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
                wrap: word-wrap;
            }

            Text {
                text: root.text;
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    enabled: !root.busy;
                    clicked => { root.cancel(); }
                }

                PrimaryButton {
                    text: root.confirm-text;
                    enabled: !root.busy;
                    destructive: root.destructive;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}

// Add or edit one category: name, palette colour, monthly budget and flags.
export component CategoryDialog inherits Rectangle {
    in property <string> title;
    in-out property <string> name;
    in-out property <string> colour;
    in-out property <string> budget;
    in-out property <bool> tax-relevant;
    in-out property <bool> transfer;
    in property <string> error-text;
    in property <[ColourSwatch]> swatches;

    callback close;
    callback save;
    // Fired whenever the name or colour changes, so the host can re-run validate_category.
    callback changed(string, string);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 500px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
            }

            OutlinedField {
                label: Tr.t("Name");
                text <=> root.name;
                edited(value) => { root.changed(value, root.colour); }
                accepted(value) => { root.save(); }
            }

            GridLayout {
                spacing: 6px;
                for swatch[index] in root.swatches : Rectangle {
                    row: Math.floor(index / 12);
                    col: Math.mod(index, 12);
                    width: 26px;
                    height: 26px;
                    border-radius: Radius.swatch;
                    background: swatch.colour;
                    border-width: swatch.hex == root.colour ? 3px : 0px;
                    border-color: Theme.text;

                    TouchArea {
                        clicked => {
                            root.colour = swatch.hex;
                            root.changed(root.name, root.colour);
                        }
                    }
                }
            }

            OutlinedField {
                label: Tr.t("MonthlyBudgetOptional");
                text <=> root.budget;
                edited(value) => { root.changed(root.name, root.colour); }
                accepted(value) => { root.save(); }
            }

            Checkbox {
                checked <=> root.tax-relevant;
                text: Tr.t("TaxRelevantHint");
            }

            Checkbox {
                checked <=> root.transfer;
                text: Tr.t("CategoryIsTransfer");
            }

            Text {
                text: Tr.t("CategoryIsTransferHint");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                wrap: word-wrap;
            }

            if (root.error-text != "") : Text {
                text: root.error-text;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: Tr.t("Save");
                    clicked => { root.save(); }
                }
            }
        }
    }
}

// Add or edit one auto-categorization rule.
export component RuleDialog inherits Rectangle {
    in property <string> title;
    in-out property <string> pattern;
    in property <[string]> categories;
    in-out property <int> category-index;
    in-out property <string> priority;
    in-out property <bool> auto-apply;
    in property <[string]> field-options;
    in-out property <int> field-index;
    in property <[string]> direction-options;
    in-out property <int> direction-index;
    in property <[string]> tax-options;
    in-out property <int> tax-index;
    in property <string> error-text;
    // Creating a rule from a booking (as FinDesk): only the pattern and the category; core picks the rest.
    in property <bool> pattern-and-category-only: false;

    callback close;
    callback save;
    // Fired whenever the pattern or priority changes, so the host can re-run validate_rule.
    callback changed(string, string);

    function category-value() -> string {
        return root.category-index >= 0 && root.category-index < root.categories.length
                ? root.categories[root.category-index] : "";
    }

    function field-value() -> string {
        return root.field-index >= 0 && root.field-index < root.field-options.length
                ? root.field-options[root.field-index] : "";
    }

    function direction-value() -> string {
        return root.direction-index >= 0 && root.direction-index < root.direction-options.length
                ? root.direction-options[root.direction-index] : "";
    }

    function tax-value() -> string {
        return root.tax-index >= 0 && root.tax-index < root.tax-options.length
                ? root.tax-options[root.tax-index] : "";
    }

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 500px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
            }

            OutlinedField {
                label: Tr.t("PatternExample");
                text <=> root.pattern;
                edited(value) => { root.changed(value, root.priority); }
                accepted(value) => { root.save(); }
            }

            HorizontalLayout {
                alignment: start;

                SelectPill {
                    label-prefix: Tr.t("ColCategory") + ": ";
                    value: root.category-value();
                    options: root.categories;
                    chosen(index) => { root.category-index = index; }
                }
            }

            if (!root.pattern-and-category-only) : VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    alignment: start;

                    SelectPill {
                        label-prefix: Tr.t("RuleSearchIn") + ": ";
                        value: root.field-value();
                        options: root.field-options;
                        chosen(index) => {
                            root.field-index = index;
                            root.changed(root.pattern, root.priority);
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;

                    SelectPill {
                        label-prefix: Tr.t("RuleAppliesTo") + ": ";
                        value: root.direction-value();
                        options: root.direction-options;
                        chosen(index) => { root.direction-index = index; }
                    }
                }

                HorizontalLayout {
                    alignment: start;

                    SelectPill {
                        label-prefix: Tr.t("TaxMenu") + ": ";
                        value: root.tax-value();
                        options: root.tax-options;
                        chosen(index) => { root.tax-index = index; }
                    }
                }

                OutlinedField {
                    label: Tr.t("Priority");
                    text <=> root.priority;
                    edited(value) => { root.changed(root.pattern, value); }
                    accepted(value) => { root.save(); }
                }

                Checkbox {
                    checked <=> root.auto-apply;
                    text: Tr.t("ApplyAutomatically");
                }
            }

            if (root.error-text != "") : Text {
                text: root.error-text;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: Tr.t("Save");
                    clicked => { root.save(); }
                }
            }
        }
    }
}

// Creates a profile or renames one.
export component ProfileNameDialog inherits Rectangle {
    in property <string> title;
    in-out property <string> name;
    in property <string> error-text;

    callback close;
    callback save;

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 440px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
                wrap: word-wrap;
            }

            OutlinedField {
                label: Tr.t("ProfileName");
                text <=> root.name;
                accepted(value) => { root.save(); }
