}

// The passphrase of a backup made before the current database passphrase was set.
export component BackupPassphraseDialog inherits Rectangle {
    in property <string> file-name;
    in property <bool> wrong: false;
    in property <bool> busy: false;
    in-out property <string> passphrase;

    callback close;
    callback submit(string);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    function send() {
        if (root.busy) {
            return;
        }
        root.submit(root.passphrase);
    }

    Rectangle {
        width: 440px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: Tr.t("BackupPassphraseTitle");
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
                wrap: word-wrap;
            }

            Text {
                text: root.file-name;
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
                overflow: elide;
            }

            Text {
                text: Tr.t("BackupPassphraseText");
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            OutlinedField {
                label: Tr.t("Passphrase");
                enabled: !root.busy;
                text <=> root.passphrase;
                input-type: InputType.password;
                error: root.wrong;
                supporting-text: root.wrong ? Tr.t("WrongPassphrase") : "";
                accepted(value) => { root.send(); }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    enabled: !root.busy;
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: Tr.t("PrepareRestore");
                    enabled: !root.busy && root.passphrase != "";
                    clicked => { root.send(); }
                }
            }
        }
    }
}

// FinDesk's passphrase, asked once for the one-time import.
export component FinDeskPassphraseDialog inherits Rectangle {
    in property <string> folder;
    in property <bool> wrong: false;
    in property <bool> busy: false;
    in-out property <string> passphrase;

    callback close;
    callback submit(string);

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    function send() {
        if (root.busy) {
            return;
        }
        root.submit(root.passphrase);
    }

    Rectangle {
        width: 460px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: Tr.t("FinDeskPassphraseTitle");
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
                wrap: word-wrap;
            }

            Text {
                text: root.folder;
                color: Theme.text;
                font-size: Type.label-size;
                font-weight: Type.label-weight;
                overflow: elide;
            }

            Text {
                text: Tr.t("FinDeskPassphraseText");
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            OutlinedField {
                label: Tr.t("Passphrase");
                enabled: !root.busy;
                text <=> root.passphrase;
                input-type: InputType.password;
                error: root.wrong;
                supporting-text: root.wrong ? Tr.t("WrongPassphrase") : "";
                accepted(value) => { root.send(); }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    enabled: !root.busy;
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: Tr.t("Import");
                    enabled: !root.busy && root.passphrase != "";
                    clicked => { root.send(); }
                }

                if (root.busy) : HorizontalLayout {
                    spacing: 8px;
                    Spinner {
                        width: 20px;
                        height: 20px;
                    }
                }
            }
        }
    }
}

// The result of a FinDesk import: the success report or the localized failure.
export component FinDeskReportDialog inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> is-error: false;

    callback close;

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 560px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
                wrap: word-wrap;
            }

            Text {
                text: root.text;
                color: root.is-error ? Theme.error : Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                PrimaryButton {
                    text: Tr.t("Close");
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// The rule-import preview: counts, skipped rows and the option to categorize existing bookings.
export component RuleImportDialog inherits Rectangle {
    in property <string> new-rules-text;
    in property <string> categories-text;
    in property <string> categories-list;
    in property <string> duplicates-text;
    in property <string> conflicts-text;
    in property <string> conflicts-list;
    in property <string> errors-text;
    in property <string> errors-list;
    in property <bool> show-categorize;
    in property <string> categorize-text;
    in-out property <bool> categorize;
    in property <bool> busy;
    in property <bool> confirm-enabled;

    callback close;
    callback confirm;

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    Rectangle {
        width: 580px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: Tr.t("RuleImportTitle");
                color: Theme.text;
                font-size: Type.title-large-size;
                font-weight: Type.title-large-weight;
            }

            ScrollView {
                height: 300px;
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.new-rules-text;
                        color: Theme.text;
                        font-size: Type.body-size;
                    }

                    if (root.categories-text != "") : Text {
                        text: root.categories-text;
                        color: Theme.text;
                        font-size: Type.body-size;
                    }
                    if (root.categories-list != "") : Text {
                        text: root.categories-list;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                    }

                    if (root.duplicates-text != "") : Text {
                        text: root.duplicates-text;
                        color: Theme.text;
                        font-size: Type.body-size;
                    }

                    if (root.conflicts-text != "") : Text {
                        text: root.conflicts-text;
                        color: Theme.text;
                        font-size: Type.body-size;
                    }
                    if (root.conflicts-list != "") : Text {
                        text: root.conflicts-list;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                    }

                    if (root.errors-text != "") : Text {
                        text: root.errors-text;
                        color: Theme.text;
                        font-size: Type.body-size;
                    }
                    if (root.errors-list != "") : Text {
                        text: root.errors-list;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        wrap: word-wrap;
                    }

                    if (root.show-categorize) : Checkbox {
                        checked <=> root.categorize;
                        text: root.categorize-text;
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    enabled: !root.busy;
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: Tr.t("Import");
                    enabled: root.confirm-enabled;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
