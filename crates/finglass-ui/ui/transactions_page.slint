import { ListView, Spinner } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    AccountAmount,
    AccountGroupChoice,
    AccountPanelRow,
    AccountTone,
    IconButton,
    ImportCsvField,
    ImportFileRow,
    PrimaryButton,
    ReapplyGroupRow,
    SearchField,
    TextButton,
    TransactionRow,
} from "components.slint";
import { AccountPanel } from "account_panel.slint";
import { ConfirmDialog, RuleDialog } from "settings_dialogs.slint";
import {
    AddTransactionDialog,
    AmountFilterDialog,
    CustomRangeDialog,
    ImportDialog,
    MultiDeleteDialog,
    ReapplyRulesDialog,
    TransactionDetailDialog,
} from "transactions_dialogs.slint";

// The shared column widths of the booking list.
global TxLayout {
    out property <length> select-width: 24px;
    out property <length> date-width: 82px;
    out property <length> category-width: 112px;
    out property <length> amount-width: 106px;
    out property <length> balance-width: 106px;
    out property <length> action-width: 30px;
}

// One labelled figure of the transactions summary strip.
component SummaryFigure inherits VerticalLayout {
    in property <string> label;
    in property <[AccountAmount]> values;
    in property <string> single-text;
    in property <bool> value-tone: true;
    // Flow totals (in/out) use the money colours; balances use the balance colours.
    in property <bool> flow: false;

    spacing: 1px;
    alignment: start;
    min-width: 64px;

    Text {
        text: root.label;
        color: Theme.muted-text;
        font-size: Type.label-small-size;
        font-weight: Type.label-small-weight;
        overflow: elide;
    }

    if (root.single-text != "") : Text {
        text: root.single-text;
        color: Theme.text;
        font-size: Type.title-medium-size;
        font-weight: Type.title-medium-weight;
        overflow: elide;
    }

    for amount in root.values : Text {
        text: amount.text;
        color: root.flow ? AccountTone.flow-color(amount.tone)
                : (root.value-tone ? AccountTone.amount-color(amount.tone) : Theme.text);
        font-size: Type.title-medium-size;
        font-weight: Type.title-medium-weight;
        overflow: elide;
    }
}

// A filled toolbar filter: a 36 px rounded rectangle without an outline, label and a small chevron.
// `opens-menu: false` turns it into a plain action control (the amount filter opens its dialog).
component DropdownPill inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in property <int> selected: 0;
    in property <image> leading-icon;
    in property <bool> has-leading-icon: false;
    in property <bool> opens-menu: true;

    callback chosen(int);
    callback activated;

    height: 36px;
    min-width: pill-content.preferred-width;
    border-radius: Radius.control;
    background: touch.has-hover ? Theme.control-fill-hover : Theme.control-fill;
    border-width: 0px;
    border-color: Theme.primary;
    accessible-role: button;
    accessible-label: root.label;

    pill-content := HorizontalLayout {
        padding-left: root.has-leading-icon ? 12px : 14px;
        padding-right: 10px;
        spacing: 6px;
        cross-axis-alignment: center;

        if (root.has-leading-icon) : Image {
            width: 18px;
            height: 18px;
            source: root.leading-icon;
            colorize: Theme.text;
            accessible-role: none;
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            vertical-alignment: center;
            overflow: elide;
        }

        Image {
            width: 16px;
            height: 16px;
            source: @image-url("icons/arrow_drop_down.svg");
            colorize: Theme.muted-text;
            accessible-role: none;
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                if (root.opens-menu) {
                    menu.show();
                } else {
                    root.activated();
                }
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: parent.border-radius;
    }

    touch := TouchArea {
        clicked => {
            if (root.opens-menu) {
                menu.show();
            } else {
                root.activated();
            }
        }
    }

    menu := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 220px);
        height: min(root.options.length * 36px, 320px);

        Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            ListView {
                for option[index] in root.options : Rectangle {
                    height: 36px;
                    background: index == root.selected || row-touch.has-hover ? Theme.background : transparent;

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: option;
                        color: index == root.selected ? Theme.primary : Theme.text;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-touch := TouchArea {
                        clicked => {
                            menu.close();
                            root.chosen(index);
                        }
                    }
                }
            }
        }
    }
}

// A menu button for batch actions: the closed control shows the action's label, the popup lists
// the real choices and closes after one is picked.
component ActionPicker inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in property <bool> primary: false;

    callback chosen(int);

    height: 32px;
    min-width: 104px;
    border-radius: Radius.control-small;
    background: root.primary ? Theme.primary : Theme.surface;
    border-width: 1px;
    border-color: root.primary ? Theme.primary : Theme.divider;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.primary ? Theme.on-primary : Theme.text;
            font-size: Type.label-size;
            font-weight: Type.label-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        Image {
            width: 18px;
            height: 18px;
            source: @image-url("icons/arrow_drop_down.svg");
            colorize: root.primary ? Theme.on-primary : Theme.muted-text;
            accessible-role: none;
        }
    }

    TouchArea {
        clicked => { menu.show(); }
    }

    menu := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 220px);
        height: min(root.options.length * 32px, 280px);

        Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            ListView {
                for option[index] in root.options : Rectangle {
                    height: 32px;
                    background: row-touch.has-hover ? Theme.background : transparent;

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: option;
                        color: Theme.text;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    row-touch := TouchArea {
                        clicked => {
                            menu.close();
                            root.chosen(index);
                        }
                    }
                }
            }
        }
    }
}

// One entry of the page's More menu.
component MoreMenuEntry inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback picked;

    height: 36px;
    background: touch.has-hover && root.enabled ? Theme.background : transparent;

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        color: root.enabled ? Theme.text : Theme.muted-text;
        font-size: Type.body-size;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.picked();
            }
        }
    }
}

// One booking row: its columns, selection tint, unread dot and inline actions.
component TransactionRowView inherits Rectangle {
    in property <TransactionRow> item;
    in property <bool> has-balance-column;

    callback open;
    callback toggle-select;
    callback select-range;
    callback show-partner;
    callback delete-row;

    property <bool> menu-open: false;
    property <string> more-label: Tr.t("More");

    height: 46px + (root.menu-open && !root.item.pending ? 48px : 0px);
    background: transparent;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 46px;
            background: root.item.selected ? Theme.selected : (!root.item.pending && row-touch.has-hover ? Theme.background : transparent);

            Rectangle {
                visible: root.item.selected;
                x: 0px;
                y: 0px;
                width: 3px;
                height: parent.height;
                background: Theme.primary;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 4px;
                spacing: 8px;

                // The header's select-all box keeps this leading column; rows leave it empty.
                Rectangle {
                    width: TxLayout.select-width;
                    background: transparent;
                }

                HorizontalLayout {
                    width: TxLayout.date-width;
                    spacing: 5px;

                    // Its own fixed-width column, centred on the row's text line.
                    VerticalLayout {
                        width: 8px;
                        alignment: center;

                        Rectangle {
                            visible: root.item.is-new;
                            width: 6px;
                            height: 6px;
                            border-radius: Radius.dot;
                            background: Theme.primary;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.item.date-text;
                        color: root.item.pending ? Theme.muted-text : Theme.text;
                        font-size: Type.label-small-size;
                        font-weight: root.item.is-new ? Type.label-small-weight : Type.body-weight;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 5px;
                        cross-axis-alignment: center;

                        Text {
                            text: root.item.title;
                            color: root.item.pending ? Theme.muted-text : Theme.text;
                            font-size: Type.label-size;
                            font-weight: root.item.is-new ? Type.label-weight : Type.label-weight;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        if (root.item.has-documents) : Image {
                            width: 16px;
                            height: 16px;
                            source: @image-url("icons/attach_file.svg");
                            colorize: Theme.muted-text;
                            accessible-role: none;
                        }
                    }

                    if (root.item.subtitle != "") : Text {
                        text: root.item.subtitle;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    width: TxLayout.category-width;
                    spacing: 5px;

                    // Directly left of the name, centred with it.
                    VerticalLayout {
                        width: 7px;
                        alignment: center;

                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: Radius.marker;
                            background: root.item.category-colour;
                        }
                    }

                    Text {
                        text: root.item.category-text;
                        color: root.item.pending ? Theme.muted-text : Theme.muted-text;
                        font-size: Type.body-small-size;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    width: TxLayout.amount-width;
                    text: root.item.amount-text;
                    color: root.item.pending
                        ? Theme.muted-text
                        : (root.item.expense ? Theme.money-out : Theme.money-in);
                    font-size: Type.body-size;
                    font-weight: Type.title-small-weight;
                    font-italic: root.item.pending;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                if (root.has-balance-column) : HorizontalLayout {
                    width: TxLayout.balance-width;
                    spacing: 4px;
                    alignment: end;
                    cross-axis-alignment: center;

                    if (root.item.balance-warning) : Image {
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/warning.svg");
                        colorize: Theme.caution;
                        accessible-role: none;
                    }

                    Text {
                        text: root.item.balance-text;
                        color: AccountTone.amount-color(root.item.balance-tone);
                        font-size: Type.body-small-size;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }

                Rectangle {
                    width: TxLayout.action-width;
                    background: transparent;
                    accessible-role: button;
                    accessible-label: root.more-label;

                    Image {
                        width: 18px;
                        height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/more_vert.svg");
                        colorize: Theme.muted-text;
                        accessible-role: none;
                    }

                    if (!root.item.pending) : TouchArea {
                        clicked => { root.menu-open = !root.menu-open; }
                    }

                    if (!root.item.pending) : Tooltip {
                        text: @markdown("\{root.more-label}");
                    }
                }
            }

            row-touch := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width - TxLayout.action-width;
                height: parent.height;
                enabled: !root.item.pending;
                mouse-cursor: pointer;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                        if (event.modifiers.shift) {
                            root.select-range();
                        } else if (event.modifiers.control) {
                            root.toggle-select();
                        } else {
                            root.open();
                        }
                    }
                }
            }
        }

        if (root.menu-open && !root.item.pending) : Rectangle {
            height: 48px;
            background: Theme.background;

            HorizontalLayout {
                padding-left: 100px;
                padding-right: 6px;
                spacing: 12px;
                alignment: start;
                cross-axis-alignment: center;

                TextButton {
                    text: Tr.t("OpenDetails");
                    clicked => {
                        root.menu-open = false;
                        root.open();
                    }
                }

                if (root.item.partner-link-text != "") : TextButton {
                    text: root.item.partner-link-text;
                    clicked => {
                        root.menu-open = false;
                        root.show-partner();
                    }
                }

                TextButton {
                    text: Tr.t("Delete");
                    clicked => {
                        root.menu-open = false;
                        root.delete-row();
                    }
                }
            }
        }
    }
}

// The table header's leading select-all box. It uses the same select-all/clear-selection callbacks as
// the selection bar, and keeps the 24 px leading column the rows reserve.
component HeaderSelectAll inherits Rectangle {
    in property <bool> checked;

    callback toggled;

    width: TxLayout.select-width;
    height: 34px;
    background: transparent;
    accessible-role: checkbox;
    accessible-label: Tr.t("SelectAll");
    accessible-checked: root.checked;

    Rectangle {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.hairline;
        background: root.checked ? Theme.primary : transparent;
        border-width: 2px;
        border-color: root.checked ? Theme.primary : Theme.muted-text;
    }

    if (root.checked) : Image {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/check.svg");
        colorize: Theme.on-primary;
        accessible-role: none;
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

// The empty booking list.
component EmptyTransactions inherits Rectangle {
    in property <bool> has-accounts;

    callback add-bank;

    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 10px;

        Text {
            text: "☰";
            color: Theme.muted-text;
            font-size: Type.amount-size;
            horizontal-alignment: center;
        }

        Text {
            text: Tr.t("NoTransactions");
            color: Theme.text;
            font-size: Type.title-large-size;
            font-weight: Type.title-large-weight;
            horizontal-alignment: center;
        }

        Text {
            text: root.has-accounts ? Tr.t("NothingMatches") : Tr.t("NoTransactionsAddBank");
            color: Theme.muted-text;
            font-size: Type.body-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if (!root.has-accounts) : HorizontalLayout {
            alignment: center;

            PrimaryButton {
                width: 150px;
                text: Tr.t("AddBank");
                icon: @image-url("icons/add.svg");
                has-icon: true;
                clicked => { root.add-bank(); }
            }
        }
    }
}

// The foldable balance-history card below the list.
component BalanceChartCard inherits Rectangle {
    in property <bool> collapsed;
    in property <string> line-path;
    in property <string> area-path;
    in property <string> axis-top;
    in property <string> axis-bottom;
    in property <string> axis-start;
    in property <string> axis-mid;
    in property <string> axis-end;
    in property <string> value-text;
    in property <bool> not-from-zero;

    callback toggle;

    property <string> toggle-label: Tr.t("BalanceHistory");

    border-radius: Radius.surface;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.divider;
    height: root.collapsed ? 44px : 200px;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 4px;
        padding-bottom: 8px;
        spacing: 4px;

        HorizontalLayout {
            height: 36px;
            spacing: 8px;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Radius.icon-medium;
                background: touch.has-hover ? Theme.divider : transparent;
                accessible-role: button;
                accessible-label: root.toggle-label;

                Image {
                    width: 20px;
                    height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.collapsed ? @image-url("icons/keyboard_arrow_right.svg") : @image-url("icons/keyboard_arrow_down.svg");
                    colorize: Theme.muted-text;
                    accessible-role: none;
                }

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle(); }
                }

                Tooltip {
                    text: @markdown("\{root.toggle-label}");
                }
            }

            Text {
                horizontal-stretch: 1;
                text: Tr.t("BalanceHistory");
                color: Theme.text;
                font-size: Type.title-small-size;
                font-weight: Type.title-small-weight;
                vertical-alignment: center;
            }

            if (!root.collapsed && root.not-from-zero) : Text {
                text: Tr.t("AxisNotFromZero");
                color: Theme.muted-text;
                font-size: Type.body-small-size;
                vertical-alignment: center;
            }
        }

        if (!root.collapsed) : HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;

            VerticalLayout {
                width: 66px;
                alignment: space-between;

                Text {
                    text: root.axis-top;
                    color: Theme.muted-text;
                    font-size: Type.caption-size;
                    font-weight: Type.caption-weight;
                    horizontal-alignment: right;
                    overflow: elide;
                }

                Text {
                    text: root.axis-bottom;
                    color: Theme.muted-text;
                    font-size: Type.caption-size;
                    font-weight: Type.caption-weight;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    clip: true;

                    Path {
                        commands: root.area-path;
                        viewbox-width: 700.0;
                        viewbox-height: 200.0;
                        width: 100%;
                        height: 100%;
                        fill: Theme.primary;
                        opacity: 0.10;
                        stroke: transparent;
                    }

                    Path {
                        commands: root.line-path;
                        viewbox-width: 700.0;
                        viewbox-height: 200.0;
                        width: 100%;
                        height: 100%;
                        stroke: Theme.primary;
                        stroke-width: 2px;
                        fill: transparent;
                    }

                    Text {
                        x: parent.width - self.width - 4px;
                        y: 0px;
                        text: root.value-text;
                        color: Theme.text;
                        font-size: Type.label-small-size;
                        font-weight: Type.label-small-weight;
                        horizontal-alignment: right;
                    }
                }

                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: root.axis-start;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.axis-mid;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        horizontal-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.axis-end;
                        color: Theme.muted-text;
                        font-size: Type.body-small-size;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }
}

// The Transactions page: the shared account panel, summary, filters, booking list and chart.
export component TransactionsPage inherits Rectangle {
    in property <bool> show-panel;
    // Window width ≥ 1280 px: the account panel gets 300 px instead of its narrow 258 px.
    in property <bool> wide: false;
    in property <int> focus-search-request;
    in property <bool> loading;
    in property <bool> has-accounts;
    in property <string> error-text;
    in property <string> message-text;

    in property <string> count-text;
    in property <[AccountAmount]> income-amounts;
    in property <[AccountAmount]> expense-amounts;
    in property <bool> has-balance;
    in property <string> balance-text;
    in property <string> balance-tone;
    in property <bool> show-back;

    in property <[string]> period-options;
    in-out property <int> period-index;
    in property <string> period-extra;
    in property <[string]> category-options;
    in-out property <int> category-index;
    in property <[string]> direction-options;
    in-out property <int> direction-index;
    in property <string> amount-label;
    in-out property <int> account-index;
    in property <[string]> account-options;

    in property <[AccountPanelRow]> panel-rows;
    in property <[AccountGroupChoice]> group-choices;
    in property <string> panel-filter-text;
    in property <string> panel-shown-text;

    in property <string> pending-header;
    in property <[TransactionRow]> rows;
    in property <bool> has-transactions;
    in property <bool> has-balance-column;

    in property <bool> has-chart;
    in property <bool> chart-collapsed;
    in property <string> chart-line;
    in property <string> chart-area;
    in property <string> chart-axis-top;
    in property <string> chart-axis-bottom;
    in property <string> chart-axis-start;
    in property <string> chart-axis-mid;
    in property <string> chart-axis-end;
    in property <string> chart-value;
    in property <bool> chart-not-from-zero;

    in property <bool> selection-visible;
    in property <bool> all-selected;
    in property <string> selection-count-text;
    in property <string> selection-totals-text;
    in property <[string]> category-names;
    in property <[string]> tax-options;

    in property <bool> detail-open;
    in property <string> detail-title;
    in property <string> detail-amount;
    in property <bool> detail-expense;
    in property <string> detail-date;
    in property <string> detail-account;
    in property <string> detail-partner;
    in property <string> detail-shop;
    in property <string> detail-purpose;
    in-out property <int> detail-category-index;
    in property <bool> detail-tax-relevant;
    in property <string> detail-tax-state;
    in-out property <int> detail-tax-index;
    in property <string> detail-mismatch;
    in property <bool> detail-has-mismatch;
    in property <string> detail-partner-link;
    in property <bool> detail-can-create-rule;

    in property <bool> import-open;
    in property <string> import-title;
    in property <string> import-summary;
    in property <[ImportFileRow]> import-files;
    in property <[ImportCsvField]> import-csv-fields;
    in property <string> import-csv-hint;
    in property <[string]> import-account-options;
    in-out property <int> import-account-index;
    in property <bool> import-balance-allowed;
    in-out property <bool> import-update-balance;
    in property <string> import-balance-text;
    in property <string> import-newer-text;
    in property <bool> importing;
    in property <string> import-confirm-text;
    in property <bool> import-confirm-enabled;

    in property <bool> reapply-open;
    in property <string> reapply-summary;
    in property <string> reapply-warning;
    in property <[ReapplyGroupRow]> reapply-groups;
    in property <string> reapply-confirm-text;
    in property <bool> reapply-confirm-enabled;
    in property <bool> can-undo-reapply;

    in property <bool> rule-open;
    in-out property <string> rule-pattern;
    in property <[string]> rule-categories;
    in-out property <int> rule-category-index;
    in property <string> rule-error;

    in property <bool> add-open;
    in property <bool> add-focus-amount: false;
    in property <[string]> add-account-options;
    in property <int> add-account-index;
    in property <string> add-date;
    in property <[string]> add-category-names;
    in property <string> add-amount-label;
    in property <string> add-error;

    in property <bool> duplicate-open;
    in property <string> duplicate-title;
    in property <string> duplicate-text;

    in property <bool> delete-open;
    in property <int> delete-id;
    in property <string> delete-title;
    in property <string> delete-text;

    in property <bool> multi-delete-open;
    in property <string> multi-delete-title;
    in property <string> multi-delete-range;
    in property <string> multi-delete-totals;
    in property <[string]> multi-delete-lines;
    in property <string> multi-delete-more;

    in property <bool> range-open;
    in property <string> range-from;
    in property <string> range-to;
    in property <string> range-error;

    in property <bool> amount-open;
    in property <string> amount-min;
    in property <string> amount-max;
    in property <string> amount-min-label;
    in property <string> amount-max-label;
    in property <string> amount-error;

    callback search(string);
    callback period-changed(int);
    callback open-range;
    callback apply-range(string, string);
    callback close-range;
    callback category-changed(int);
    callback direction-changed(int);
    callback account-changed(int);
    callback open-amount;
    callback apply-amount(string, string);
    callback reset-amount;
    callback close-amount;
    callback toggle-chart;
    callback auto-categorize;
    callback open-accounts;
    callback back;

    callback open-detail(int);
    callback toggle-select(int);
    callback select-range(int);
    callback select-all;
    callback clear-selection;
    callback show-partner(string);
    callback delete-row(int);
    callback confirm-delete(int);
    callback cancel-delete;
    callback open-multi-delete;
    callback confirm-multi-delete;
    callback cancel-multi-delete;
    callback batch-category(int);
    callback batch-tax(int);

    callback open-add;
    callback add-submit(int, bool, string, string, string, string, int);
    callback close-add;
    callback confirm-duplicate;
    callback dismiss-duplicate;
    callback detail-close;
    callback detail-category(int);
    callback detail-tax(int);
    callback detail-show-partner(string);
    callback detail-attach-receipt;
    callback detail-create-rule;
    callback dismiss-message;

    callback open-import;
    callback import-account-changed(int);
    callback import-csv-changed(string, string);
    callback confirm-import(bool);
    callback cancel-import;
    callback reapply-rules;
    callback toggle-reapply-group(int, int);
    callback confirm-reapply-rules;
    callback cancel-reapply-rules;
    callback undo-reapply-rules;
    callback export-csv;
    callback rule-save;
    callback rule-close;

    in-out property <bool> more-menu-open: false;

    callback panel-select(string, string, int, string);
    callback panel-toggle(string, string, int, string);
    callback panel-mark-read(string, string, int, string);
    callback panel-new-group(string);
    callback panel-rename-group(int, string);
    callback panel-delete-group(int);
    callback panel-move-group(int, bool);
    callback panel-move-account(int, int);
    callback panel-filter-changed(string);

    /// Puts keyboard focus into the partner/purpose search field, used by View > Find.
    public function focus-search() {
        search-field.focus-input();
    }

    changed focus-search-request => {
        root.focus-search();
    }

    background: Theme.background;

    HorizontalLayout {
        padding: 20px;
        spacing: 16px;

        if (root.show-panel && root.has-accounts) : AccountPanel {
            width: root.wide ? 320px : 300px;
            rows: root.panel-rows;
            groups: root.group-choices;
            filter-text: root.panel-filter-text;
            shown-text: root.panel-shown-text;

            filter-changed(text) => { root.panel-filter-changed(text); }
            select(kind, group-kind, id, account-type) => {
                root.panel-select(kind, group-kind, id, account-type);
            }
            toggle(kind, group-kind, id, account-type) => {
                root.panel-toggle(kind, group-kind, id, account-type);
            }
            mark-read(kind, group-kind, id, account-type) => {
                root.panel-mark-read(kind, group-kind, id, account-type);
            }
            new-group(name) => { root.panel-new-group(name); }
            rename-group(id, name) => { root.panel-rename-group(id, name); }
            delete-group(id) => { root.panel-delete-group(id); }
            move-group(id, up) => { root.panel-move-group(id, up); }
            move-account(account-id, group-id) => { root.panel-move-account(account-id, group-id); }
        }

        VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 28px;

                    SummaryFigure {
                        label: Tr.t("SummaryCount");
                        single-text: root.count-text;
                        value-tone: false;
                    }

                    SummaryFigure {
                        label: Tr.t("SummaryIn");
                        values: root.income-amounts;
                        flow: true;
                    }

                    SummaryFigure {
                        label: Tr.t("SummaryOut");
                        values: root.expense-amounts;
                        flow: true;
                    }

                    if (root.has-balance) : SummaryFigure {
                        label: Tr.t("SummaryBalance");
                        values: [{ text: root.balance-text, tone: root.balance-tone }];
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                IconButton {
                    icon: @image-url("icons/more_vert.svg");
                    label: Tr.t("More");
                    tooltip-text: Tr.t("More");
                    filled: true;
                    clicked => { root.more-menu-open = !root.more-menu-open; }
                }

                if (root.has-accounts) : PrimaryButton {
                    text: Tr.t("Add");
                    icon: @image-url("icons/add.svg");
                    has-icon: true;
                    clicked => { root.open-add(); }
                }
            }

            if (root.error-text != "" || root.message-text != "") : Rectangle {
                height: 42px;
                background: Theme.surface;
                border-radius: Radius.panel;
                border-width: 1px;
                border-color: root.error-text != "" ? Theme.error : Theme.success;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 4px;
                    spacing: 12px;

                    Image {
                        width: 20px;
                        height: 20px;
                        source: root.error-text != "" ? @image-url("icons/warning.svg") : @image-url("icons/check_circle.svg");
                        colorize: root.error-text != "" ? Theme.error : Theme.success;
                        accessible-role: none;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.error-text != "" ? root.error-text : root.message-text;
                        color: root.error-text != "" ? Theme.error : Theme.success;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }

                    if (root.error-text == "" && root.can-undo-reapply) : TextButton {
                        text: Tr.t("UndoReapplyRules");
                        clicked => { root.undo-reapply-rules(); }
                    }

                    IconButton {
                        icon: @image-url("icons/close.svg");
                        label: Tr.t("Dismiss");
                        tooltip-text: Tr.t("Dismiss");
                        icon-size: 18px;
                        clicked => { root.dismiss-message(); }
                    }
                }
            }

            // The search field and the filter dropdowns share one line while the search field keeps
            // at least 240 px; otherwise the search field gets its own line and the dropdowns go below
            // it (wrapping only when even they no longer fit).
            filter-area := Rectangle {
                // The four dropdowns side by side. The account dropdown only appears below 1000 px, where
                // two lines are needed anyway.
                property <length> filters-line-width: period-pill.preferred-width + category-pill.preferred-width
                    + direction-pill.preferred-width + amount-pill.preferred-width + 3 * 8px;
                property <bool> one-line: root.show-panel
                    && self.width - self.filters-line-width - 8px >= 240px;
                height: self.one-line ? 36px : 36px + 8px + filters.height;

                search-field := SearchField {
                    x: 0px;
                    y: 0px;
                    width: filter-area.one-line ? filter-area.width - filters.width - 8px : filter-area.width;
                    height: 36px;
                    text: "";
                    placeholder: Tr.t("SearchPartnerPurpose");
                    edited(text) => { root.search(text); }
                }

                filters := FlexboxLayout {
                    x: filter-area.one-line ? filter-area.width - self.width : 0px;
                    y: filter-area.one-line ? 0px : 44px;
                    width: filter-area.one-line ? filter-area.filters-line-width : filter-area.width;
                    height: self.preferred-height;
                    spacing: 8px;
                    flex-wrap: wrap;
                    alignment: start;
                    cross-axis-alignment: center;

                    period-pill := DropdownPill {
                        label: root.period-extra != "" ? root.period-extra : (root.period-index >= 0 && root.period-index < root.period-options.length ? root.period-options[root.period-index] : "");
                        options: root.period-options;
                        selected: root.period-extra != "" ? -1 : root.period-index;
                        leading-icon: @image-url("icons/date_range.svg");
                        has-leading-icon: true;
                        chosen(index) => {
                            if (index == root.period-options.length - 1) {
                                root.open-range();
                            } else {
                                root.period-changed(index);
                            }
                        }
                    }

                    category-pill := DropdownPill {
                        label: root.category-index >= 0 && root.category-index < root.category-options.length ? root.category-options[root.category-index] : "";
                        options: root.category-options;
                        selected: root.category-index;
                        chosen(index) => { root.category-changed(index); }
                    }

                    if (!root.show-panel && root.has-accounts) : DropdownPill {
                        label: root.account-index >= 0 && root.account-index < root.account-options.length ? root.account-options[root.account-index] : "";
                        options: root.account-options;
                        selected: root.account-index;
                        chosen(index) => { root.account-changed(index); }
                    }

                    direction-pill := DropdownPill {
                        label: root.direction-index >= 0 && root.direction-index < root.direction-options.length ? root.direction-options[root.direction-index] : "";
                        options: root.direction-options;
                        selected: root.direction-index;
                        chosen(index) => { root.direction-changed(index); }
                    }

                    amount-pill := DropdownPill {
                        label: root.amount-label;
                        opens-menu: false;
                        activated => { root.open-amount(); }
                    }
                }
            }

            if (root.show-back) : TextButton {
                text: Tr.t("Back");
                clicked => { root.back(); }
            }

            Rectangle {
                background: Theme.surface;
                border-radius: Radius.surface;
                border-width: 1px;
                border-color: Theme.divider;
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 0px;

                    if (root.selection-visible) : Rectangle {
                        height: 48px;
                        background: Theme.background;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;

                            Text {
                                text: root.selection-count-text;
                                color: Theme.text;
                                font-size: Type.label-size;
                                font-weight: Type.label-weight;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.selection-totals-text;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }

                            ActionPicker {
                                width: 140px;
                                label: Tr.t("CategoryMenu");
                                options: root.category-names;
                                primary: true;
                                chosen(index) => { root.batch-category(index); }
                            }

                            ActionPicker {
                                width: 150px;
                                label: Tr.t("TaxMenu");
                                options: root.tax-options;
                                chosen(index) => { root.batch-tax(index); }
                            }

                            TextButton {
                                text: Tr.t("SelectAll");
                                clicked => { root.select-all(); }
                            }

                            TextButton {
                                text: Tr.t("ClearSelection");
                                clicked => { root.clear-selection(); }
                            }

                            TextButton {
                                text: Tr.t("DeleteSelected");
                                clicked => { root.open-multi-delete(); }
                            }
                        }
                    }

                    Rectangle {
                        height: 34px;
                        background: transparent;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 8px;

                            if (root.rows.length > 0) : HeaderSelectAll {
                                checked: root.all-selected;
                                toggled => {
                                    if (root.all-selected) {
                                        root.clear-selection();
                                    } else {
                                        root.select-all();
                                    }
                                }
                            }

                            Text {
                                width: TxLayout.date-width;
                                text: Tr.t("ColDate");
                                color: Theme.muted-text;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: Tr.t("ColDescription");
                                color: Theme.muted-text;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                vertical-alignment: center;
                            }
                            Text {
                                width: TxLayout.category-width;
                                text: Tr.t("ColCategory");
                                color: Theme.muted-text;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                vertical-alignment: center;
                            }
                            Text {
                                width: TxLayout.amount-width;
                                text: Tr.t("ColAmount");
                                color: Theme.muted-text;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            if (root.has-balance-column) : Text {
                                width: TxLayout.balance-width;
                                text: Tr.t("ColBalance");
                                color: Theme.muted-text;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: TxLayout.action-width;
                                background: transparent;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }

                    if (root.pending-header != "") : Rectangle {
                        height: 34px;
                        background: Theme.background;

                        HorizontalLayout {
                            padding-left: 12px;

                            Text {
                                text: root.pending-header;
                                color: Theme.muted-text;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if (root.rows.length == 0 && !root.loading) : EmptyTransactions {
                        has-accounts: root.has-accounts;
                        add-bank => { root.open-accounts(); }
                    }

                    if (root.rows.length == 0 && root.loading) : Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        Spinner {
                            width: 28px;
                            height: 28px;
                        }
                    }

                    if (root.rows.length > 0) : ListView {
                        vertical-stretch: 1;

                        for row in root.rows : TransactionRowView {
                            item: row;
                            has-balance-column: root.has-balance-column;

                            open => { root.open-detail(row.id); }
                            toggle-select => { root.toggle-select(row.id); }
                            select-range => { root.select-range(row.id); }
                            show-partner => { root.show-partner(row.partner); }
                            delete-row => { root.delete-row(row.id); }
                        }
                    }
                }
            }

            if (root.has-chart) : BalanceChartCard {
                collapsed: root.chart-collapsed;
                line-path: root.chart-line;
                area-path: root.chart-area;
                axis-top: root.chart-axis-top;
                axis-bottom: root.chart-axis-bottom;
                axis-start: root.chart-axis-start;
                axis-mid: root.chart-axis-mid;
                axis-end: root.chart-axis-end;
                value-text: root.chart-value;
                not-from-zero: root.chart-not-from-zero;
                toggle => { root.toggle-chart(); }
            }
        }
    }

    if (root.detail-open) : TransactionDetailDialog {
        title: root.detail-title;
        amount-text: root.detail-amount;
        expense: root.detail-expense;
        date-text: root.detail-date;
        account-text: root.detail-account;
        partner-text: root.detail-partner;
        shop-text: root.detail-shop;
        purpose-text: root.detail-purpose;
        category-index <=> root.detail-category-index;
        category-names: root.category-names;
        tax-relevant: root.detail-tax-relevant;
        tax-state-text: root.detail-tax-state;
        tax-index <=> root.detail-tax-index;
        tax-options: root.tax-options;
        has-mismatch: root.detail-has-mismatch;
        mismatch-text: root.detail-mismatch;
        has-partner: root.detail-partner != "";
        partner-link-text: root.detail-partner-link;
        can-create-rule: root.detail-can-create-rule;

        close => { root.detail-close(); }
        category-selected(index) => { root.detail-category(index); }
        tax-selected(index) => { root.detail-tax(index); }
        show-partner => { root.detail-show-partner(root.detail-partner); }
        attach-receipt => { root.detail-attach-receipt(); }
        create-rule => { root.detail-create-rule(); }
    }

    if (root.add-open) : AddTransactionDialog {
        initial-date: root.add-date;
        initial-account-index: root.add-account-index;
        accounts: root.add-account-options;
        category-names: root.add-category-names;
        amount-label: root.add-amount-label;
        error-text: root.add-error;
        focus-amount: root.add-focus-amount;

        close => { root.close-add(); }
        submit(account-index, expense, date-text, amount-text, partner-text, purpose-text, category-index) => {
            root.add-submit(account-index, expense, date-text, amount-text, partner-text, purpose-text, category-index);
        }
    }

    if (root.duplicate-open) : ConfirmDialog {
        title: root.duplicate-title;
        text: root.duplicate-text;
        confirm-text: Tr.t("AddAnyway");

        confirm => { root.confirm-duplicate(); }
        cancel => { root.dismiss-duplicate(); }
    }

    if (root.delete-open) : ConfirmDialog {
        title: root.delete-title;
        text: root.delete-text;
        confirm-text: Tr.t("Delete");

        confirm => { root.confirm-delete(root.delete-id); }
        cancel => { root.cancel-delete(); }
    }

    if (root.multi-delete-open) : MultiDeleteDialog {
        title: root.multi-delete-title;
        range-text: root.multi-delete-range;
        totals-text: root.multi-delete-totals;
        booking-lines: root.multi-delete-lines;
        more-text: root.multi-delete-more;

        confirm => { root.confirm-multi-delete(); }
        cancel => { root.cancel-multi-delete(); }
    }

    if (root.range-open) : CustomRangeDialog {
        initial-from: root.range-from;
        initial-to: root.range-to;
        error-text: root.range-error;

        close => { root.close-range(); }
        apply(from, to) => { root.apply-range(from, to); }
    }

    if (root.amount-open) : AmountFilterDialog {
        initial-min: root.amount-min;
        initial-max: root.amount-max;
        min-label: root.amount-min-label;
        max-label: root.amount-max-label;
        error-text: root.amount-error;

        close => { root.close-amount(); }
        apply(minimum, maximum) => { root.apply-amount(minimum, maximum); }
        reset => { root.reset-amount(); }
    }

    if (root.import-open) : ImportDialog {
        title: root.import-title;
        summary-text: root.import-summary;
        file-rows: root.import-files;
        csv-fields: root.import-csv-fields;
        csv-hint: root.import-csv-hint;
        account-options: root.import-account-options;
        account-index <=> root.import-account-index;
        balance-allowed: root.import-balance-allowed;
        update-balance <=> root.import-update-balance;
        balance-text: root.import-balance-text;
        newer-text: root.import-newer-text;
        importing: root.importing;
        confirm-text: root.import-confirm-text;
        confirm-enabled: root.import-confirm-enabled;

        close => { root.cancel-import(); }
        confirm(update-balance) => { root.confirm-import(update-balance); }
        account-selected(index) => { root.import-account-changed(index); }
        csv-changed(field, index) => { root.import-csv-changed(field, index); }
    }

    if (root.reapply-open) : ReapplyRulesDialog {
        summary-text: root.reapply-summary;
        warning-text: root.reapply-warning;
        groups: root.reapply-groups;
        confirm-text: root.reapply-confirm-text;
        confirm-enabled: root.reapply-confirm-enabled;

        cancel => { root.cancel-reapply-rules(); }
        confirm => { root.confirm-reapply-rules(); }
        toggle(from-id, to-id) => { root.toggle-reapply-group(from-id, to-id); }
    }

    if (root.rule-open) : RuleDialog {
        title: Tr.t("AddRule");
        pattern <=> root.rule-pattern;
        categories: root.rule-categories;
        category-index <=> root.rule-category-index;
        pattern-and-category-only: true;
        error-text: root.rule-error;

        close => { root.rule-close(); }
        save => { root.rule-save(); }
    }

    if (root.more-menu-open) : Rectangle {
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => { root.more-menu-open = false; }
        }

        Rectangle {
            x: parent.width - 288px;
            y: 52px;
            width: 260px;
            height: (root.can-undo-reapply ? 5 : 4) * 36px + 8px;
            background: Theme.surface;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                MoreMenuEntry {
                    text: Tr.t("Import");
                    enabled: root.has-accounts;
                    picked => {
                        root.more-menu-open = false;
                        root.open-import();
                    }
                }

                MoreMenuEntry {
                    text: Tr.t("AutoCategorize");
                    picked => {
                        root.more-menu-open = false;
                        root.auto-categorize();
                    }
                }

                MoreMenuEntry {
                    text: Tr.t("ReapplyRules");
                    enabled: root.has-transactions;
                    picked => {
                        root.more-menu-open = false;
                        root.reapply-rules();
                    }
                }

                if (root.can-undo-reapply) : MoreMenuEntry {
                    text: Tr.t("UndoReapplyRules");
                    picked => {
                        root.more-menu-open = false;
                        root.undo-reapply-rules();
                    }
                }

                MoreMenuEntry {
                    text: Tr.t("ExportCsv");
                    enabled: root.has-transactions;
                    picked => {
                        root.more-menu-open = false;
                        root.export-csv();
                    }
                }
            }
        }
    }
}
