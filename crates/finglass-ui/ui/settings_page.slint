import { AboutSlint, ScrollView, Spinner, TextEdit } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import { Checkbox, IconButton, OutlinedField, PrimaryButton, SegmentedButton, SelectPill, TextButton } from "components.slint";
import { ReportMenuItem } from "reports_page.slint";
import { AuditRow, CategoryRow, ProfileRow, RuleRow } from "models.slint";
import { FinDeskPassphraseDialog, FinDeskReportDialog } from "settings_dialogs.slint";

// The Settings sections, in FinDesk's order. A section's title reuses the key its header shows.
global SettingsSections {
    out property <[int]> indices: [0, 1, 2, 3, 4, 5, 6, 7, 8];
}

// The section's title, as a Text so a row can keep its own styling and a drop-down can read `text`.
component SettingsSectionLabel inherits Text {
    in property <int> index;

    text: root.index == 0 ? Tr.t("Appearance")
        : root.index == 1 ? Tr.t("Profiles")
        : root.index == 2 ? Tr.t("Categories")
        : root.index == 3 ? Tr.t("AutoCategorizationRules")
        : root.index == 4 ? Tr.t("Security")
        : root.index == 5 ? Tr.t("BackupAndRestore")
        : root.index == 6 ? Tr.t("FinDeskImportTitle")
        : root.index == 7 ? Tr.t("AuditLogShort")
        : Tr.t("AboutTitle");
}

component SectionHeader inherits FlexboxLayout {
    in property <string> text;

    // Wraps the actions to a second line when a long translated title and the buttons no longer fit.
    min-height: 48px;
    spacing: 8px;
    // Stretch lets the title (horizontal-stretch: 1) take the free space, so the actions sit at the
    // end, as in FinDesk's SettingsSectionHeader.
    alignment: stretch;
    cross-axis-alignment: center;

    Text {
        text: root.text;
        color: Theme.text;
        font-size: Type.title-medium-size;
        font-weight: Type.title-medium-weight;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }

    @children
}

// The Categories header's primary action plus the secondary actions in a ⋮ overflow menu.
component CategoriesHeaderActions inherits HorizontalLayout {
    in property <bool> has-duplicate-colours: false;

    callback add-category;
    callback add-default-categories;
    callback fix-duplicate-colours;

    property <bool> menu-open: false;
    property <int> menu-selected: 0;

    spacing: 8px;
    alignment: end;

    function item-count() -> int {
        return root.has-duplicate-colours ? 2 : 1;
    }

    function open-menu() {
        root.menu-selected = 0;
        root.menu-open = true;
        menu.show();
        menu-focus.focus();
    }

    function close-menu() {
        root.menu-open = false;
        menu.close();
    }

    function activate(index: int) {
        if (root.has-duplicate-colours) {
            if (index == 0) {
                root.fix-duplicate-colours();
            } else {
                root.add-default-categories();
            }
        } else {
            root.add-default-categories();
        }
        root.close-menu();
    }

    PrimaryButton {
        text: Tr.t("AddCategory");
        icon: @image-url("icons/add.svg");
        has-icon: true;
        clicked => { root.add-category(); }
    }

    IconButton {
        icon: @image-url("icons/more_vert.svg");
        label: Tr.t("More");
        tooltip-text: Tr.t("More");
        outlined: true;
        clicked => {
            if (root.menu-open) {
                root.close-menu();
            } else {
                root.open-menu();
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 220px;
        y: root.height + 4px;
        width: 220px;
        height: root.item-count() * 36px + 8px;

        Rectangle {
            background: Theme.surface;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                if (root.has-duplicate-colours) : ReportMenuItem {
                    text: Tr.t("FixDuplicateColours");
                    highlighted: root.menu-selected == 0;
                    picked => { root.activate(0); }
                }
                ReportMenuItem {
                    text: Tr.t("AddDefaultCategories");
                    highlighted: root.menu-selected == (root.has-duplicate-colours ? 1 : 0);
                    picked => { root.activate(root.has-duplicate-colours ? 1 : 0); }
                }
            }
        }
    }

    menu-focus := FocusScope {
        enabled: root.menu-open;
        // The menu entries' TouchAreas handle the mouse; without this a click would be taken for focus.
        focus-on-click: false;
        key-pressed(event) => {
            if (!root.menu-open) {
                return reject;
            }
            if (event.text == Key.Escape) {
                root.close-menu();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.menu-selected = root.menu-selected <= 0 ? root.item-count() - 1 : root.menu-selected - 1;
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.menu-selected = root.menu-selected >= root.item-count() - 1 ? 0 : root.menu-selected + 1;
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activate(root.menu-selected);
                return accept;
            }
            return reject;
        }
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <image> icon;

    spacing: 8px;
    alignment: start;
    cross-axis-alignment: center;

    Image {
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: Theme.muted-text;
        accessible-role: none;
    }

    Text {
        text: root.text;
        color: Theme.text;
        font-size: Type.title-medium-size;
        font-weight: Type.title-medium-weight;
        vertical-alignment: center;
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// One row of the section list, and one row of the narrow section drop-down.
component SettingsSectionRow inherits Rectangle {
    in property <int> index;
    in property <bool> selected;

    callback picked;
    callback move-up;
    callback move-down;

    property <image> icon: root.index == 0 ? @image-url("icons/palette.svg")
            : root.index == 1 ? @image-url("icons/person.svg")
            : root.index == 2 ? @image-url("icons/list.svg")
            : root.index == 3 ? @image-url("icons/auto_fix_high.svg")
            : root.index == 4 ? @image-url("icons/storage.svg")
            : root.index == 5 ? @image-url("icons/backup.svg")
            : root.index == 6 ? @image-url("icons/upload_file.svg")
            : root.index == 7 ? @image-url("icons/history.svg")
            : @image-url("icons/info.svg");

    min-height: 40px;
    border-radius: Radius.panel;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.surface : transparent);
    accessible-role: button;
    accessible-label: row-label.text;

    Rectangle {
        visible: root.selected;
        x: 0px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: Radius.hairline;
        background: Theme.primary;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        cross-axis-alignment: center;

        Image {
            width: 20px;
            height: 20px;
            source: root.icon;
            colorize: root.selected ? Theme.on-selected : Theme.muted-text;
            accessible-role: none;
        }

        row-label := SettingsSectionLabel {
            index: root.index;
            color: root.selected ? Theme.on-selected : Theme.text;
            font-size: Type.label-size;
            font-weight: root.selected ? 600 : Type.label-weight;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            min-width: 0px;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    focus := FocusScope {
        // The TouchArea underneath handles the mouse; without this the FocusScope would take the
        // first press to gain focus and the user would need a second click.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.move-up();
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-down();
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.picked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus : Rectangle {
        border-width: 2px;
        border-color: Theme.primary;
        border-radius: parent.border-radius;
    }
}

component SettingsSectionList inherits VerticalLayout {
    in property <int> selected;

    callback select(int);

    width: 272px;
    spacing: 2px;

    for index in SettingsSections.indices : SettingsSectionRow {
        index: index;
        selected: index == root.selected;
        picked => { root.select(index); }
        move-up => { root.select(max(0, index - 1)); }
        move-down => { root.select(min(8, index + 1)); }
    }
}

component SettingsBanner inherits Rectangle {
    in property <string> error-text;
    in property <string> message-text;

    callback dismiss;

    height: 46px;
    background: Theme.surface;

    if (root.error-text != "") : HorizontalLayout {
        padding-left: 24px;
        padding-right: 12px;
        spacing: 12px;

        Image {
            width: 20px;
            height: 20px;
            source: @image-url("icons/warning.svg");
            colorize: Theme.error;
            accessible-role: none;
        }

        Text {
            text: root.error-text;
            color: Theme.error;
            font-size: Type.body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }

        IconButton {
            icon: @image-url("icons/close.svg");
            label: Tr.t("Dismiss");
            tooltip-text: Tr.t("Dismiss");
            icon-size: 18px;
            clicked => { root.dismiss(); }
        }
    }

    if (root.error-text == "" && root.message-text != "") : HorizontalLayout {
        padding-left: 24px;
        padding-right: 12px;
        spacing: 12px;

        Image {
            width: 20px;
            height: 20px;
            source: @image-url("icons/check_circle.svg");
            colorize: Theme.success;
            accessible-role: none;
        }

        Text {
            text: root.message-text;
            color: Theme.success;
            font-size: Type.body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }

        IconButton {
            icon: @image-url("icons/close.svg");
            label: Tr.t("Dismiss");
            tooltip-text: Tr.t("Dismiss");
            icon-size: 18px;
            clicked => { root.dismiss(); }
        }
    }
}

// The tax suggestion keywords card at the end of Categories.
component TaxKeywordsCard inherits Rectangle {
    in-out property <string> keywords;
    in property <string> count;

    callback save(string);
    callback reset;

    height: card.preferred-height;
    border-radius: Radius.surface;
    border-width: 1px;
    border-color: Theme.divider;
    background: Theme.surface;

    card := VerticalLayout {
        padding: 16px;
        spacing: 10px;

        SectionTitle {
            text: Tr.t("TaxSuggestionKeywords");
            icon: @image-url("icons/transactions.svg");
        }

        Text {
            text: root.count;
            color: Theme.muted-text;
            font-size: Type.body-small-size;
        }

        TextEdit {
            height: 150px;
            text: root.keywords;
            wrap: word-wrap;
            edited(value) => { root.keywords = value; }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            PrimaryButton {
                text: Tr.t("Save");
                clicked => { root.save(root.keywords); }
            }

            TextButton {
                text: Tr.t("ResetToDefaults");
                clicked => { root.reset(); }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <string> theme-pref;
    in property <string> language;
    in property <string> about-version-text;
    in property <[AuditRow]> audit-rows;

    in property <string> settings-error;
    in property <string> settings-message;
    in property <bool> categories-empty;
    in property <bool> has-duplicate-colours;

    in-out property <string> primary-currency;
    in property <[string]> currency-options;
    in-out property <int> primary-currency-index;

    in property <[ProfileRow]> profile-rows;
    in property <[CategoryRow]> category-rows;
    in property <[RuleRow]> rule-rows;
    in-out property <string> tax-keywords;
    in property <string> tax-keywords-count;

    // Backup & restore.
    in property <bool> backup-busy;
    in property <bool> backup-has-pending-restore;
    in property <string> backup-restored-text;

    // One-time import from FinDesk and its result.
    in property <bool> findesk-busy;
    in property <bool> findesk-passphrase-open;
    in property <string> findesk-folder;
    in property <bool> findesk-passphrase-wrong;
    in-out property <string> findesk-passphrase;
    in property <bool> findesk-report-open;
    in property <string> findesk-report-title;
    in property <string> findesk-report-text;
    in property <bool> findesk-report-error;

    // The section shown on the right and its narrow-window drop-down.
    in-out property <int> section: 0;
    in-out property <bool> section-menu-open: false;
    in-out property <length> scroll-y;

    property <bool> narrow: root.width < 840px;
    property <length> menu-y: 24px + (root.settings-error != "" || root.settings-message != "" ? 46px + 12px : 0px) + 40px + 4px;

    callback set-theme(string);
    callback set-language(string);
    callback open-change;
    callback dismiss-message;

    callback set-primary-currency(string);
    callback new-profile;
    callback rename-profile(int);
    callback switch-profile(int);
    callback delete-profile(int);
    callback add-category;
    callback edit-category(int);
    callback delete-category(int);
    callback add-default-categories;
    callback fix-duplicate-colours;
    callback add-rule;
    callback edit-rule(int);
    callback delete-rule(int);
    callback import-rules;
    callback export-rules;
    callback save-tax-keywords(string);
    callback reset-tax-keywords;
    callback create-backup;
    callback restore-backup;
    callback cancel-pending-restore;
    callback import-findesk;
    callback findesk-passphrase-submit(string);
    callback findesk-passphrase-cancel;
    callback findesk-report-close;

    background: Theme.background;

    changed section => {
        // A section always opens at its top; a shared scroll position would open a short one part-way down.
        root.scroll-y = 0;
        root.section-menu-open = false;
    }

    if (root.narrow) : VerticalLayout {
        padding: 24px;
        spacing: 12px;

        if (root.settings-error != "" || root.settings-message != "") : SettingsBanner {
            error-text: root.settings-error;
            message-text: root.settings-message;
            dismiss => { root.dismiss-message(); }
        }

        Rectangle {
            height: 40px;
            border-radius: Radius.panel;
            border-width: 1px;
            border-color: dropdown-focus.has-focus ? Theme.primary : Theme.divider;
            background: dropdown-touch.has-hover || root.section-menu-open ? Theme.surface : Theme.background;
            accessible-role: button;
            accessible-label: section-label.text;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                cross-axis-alignment: center;

                section-label := SettingsSectionLabel {
                    index: root.section;
                    color: Theme.text;
                    font-size: Type.label-size;
                    font-weight: Type.label-weight;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Image {
                    width: 18px;
                    height: 18px;
                    source: @image-url("icons/arrow_drop_down.svg");
                    colorize: Theme.muted-text;
                    accessible-role: none;
                }
            }

            dropdown-touch := TouchArea {
                clicked => { root.section-menu-open = !root.section-menu-open; }
            }

            dropdown-focus := FocusScope {
                // The TouchArea underneath handles the mouse; without this the FocusScope would take the
                // first press to gain focus and the user would need a second click.
                focus-on-click: false;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.section-menu-open = !root.section-menu-open;
                        return accept;
                    }
                    return reject;
                }
            }
        }

        ScrollView {
            content-y <=> root.scroll-y;

            VerticalLayout {
                width: min(parent.width, 760px);
                spacing: 0;
                alignment: start;

                // Appearance
                if (root.section == 0) : VerticalLayout {
                    alignment: start;
                    SectionHeader { text: Tr.t("Appearance"); }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: Tr.t("Theme");
                                width: 120px;
                                color: Theme.text;
                                font-size: Type.body-size;
                                vertical-alignment: center;
                            }
                            SegmentedButton {
                                labels: [Tr.t("ThemeSystem"), Tr.t("ThemeLight"), Tr.t("ThemeDark")];
                                selected: root.theme-pref == "system" ? 0 : (root.theme-pref == "light" ? 1 : 2);
                                select(index) => {
                                    root.set-theme(index == 0 ? "system" : (index == 1 ? "light" : "dark"));
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: Tr.t("Language");
                                width: 120px;
                                color: Theme.text;
                                font-size: Type.body-size;
                                vertical-alignment: center;
                            }
                            SegmentedButton {
                                labels: ["EN", "DE", "FR"];
                                selected: root.language == "en" ? 0 : (root.language == "de" ? 1 : 2);
                                select(index) => {
                                    root.set-language(index == 0 ? "en" : (index == 1 ? "de" : "fr"));
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: Tr.t("PrimaryCurrency");
                                    color: Theme.text;
                                    font-size: Type.body-size;
                                }
                                Text {
                                    text: Tr.t("PrimaryCurrencyHint");
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    wrap: word-wrap;
                                }
                            }

                            SelectPill {
                                label-prefix: "";
                                value: root.primary-currency-index >= 0 && root.primary-currency-index < root.currency-options.length
                                        ? root.currency-options[root.primary-currency-index] : "";
                                options: root.currency-options;
                                chosen(index) => { root.set-primary-currency(index); }
                            }
                        }
                    }
                }

                // Profiles
                if (root.section == 1) : VerticalLayout {
                    alignment: start;
                    SectionHeader {
                        text: Tr.t("Profiles");

                        PrimaryButton {
                            text: Tr.t("NewProfile");
                            icon: @image-url("icons/add.svg");
                            has-icon: true;
                            clicked => { root.new-profile(); }
                        }
                    }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: Tr.t("ProfilesHint");
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            wrap: word-wrap;
                        }

                        for row in root.profile-rows : Rectangle {
                            height: 46px;
                            background: transparent;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                Text {
                                    text: row.name;
                                    color: Theme.text;
                                    font-size: Type.title-small-size;
                                    font-weight: row.open ? Type.title-small-weight : Type.body-weight;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }

                                if (row.open) : Rectangle {
                                    height: 22px;
                                    border-radius: Radius.tag;
                                    background: Theme.selected;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;

                                        Text {
                                            text: Tr.t("ProfileOpen");
                                            color: Theme.on-selected;
                                            font-size: Type.label-small-size;
                                            font-weight: Type.label-small-weight;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if (row.next-start) : Text {
                                    text: Tr.t("ProfileNextStart");
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    vertical-alignment: center;
                                }

                                if (row.can-switch) : TextButton {
                                    text: Tr.t("OpenProfile");
                                    clicked => { root.switch-profile(row.index); }
                                }

                                IconButton {
                                    icon: @image-url("icons/edit.svg");
                                    label: Tr.t("Edit");
                                    tooltip-text: Tr.t("Edit");
                                    icon-size: 20px;
                                    clicked => { root.rename-profile(row.index); }
                                }

                                if (row.can-delete) : IconButton {
                                    icon: @image-url("icons/delete.svg");
                                    label: Tr.t("Delete");
                                    tooltip-text: Tr.t("Delete");
                                    icon-size: 20px;
                                    icon-color: Theme.error;
                                    clicked => { root.delete-profile(row.index); }
                                }
                            }
                        }
                    }
                }

                // Categories, including the tax suggestion keywords card.
                if (root.section == 2) : VerticalLayout {
                    alignment: start;
                    SectionHeader {
                        text: Tr.t("Categories");

                        if (!root.categories-empty) : CategoriesHeaderActions {
                            has-duplicate-colours: root.has-duplicate-colours;
                            add-category => { root.add-category(); }
                            add-default-categories => { root.add-default-categories(); }
                            fix-duplicate-colours => { root.fix-duplicate-colours(); }
                        }
                    }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 12px;

                        if (root.categories-empty) : Text {
                            text: Tr.t("NoCategoriesYet");
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                        }

                        if (root.categories-empty) : HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            PrimaryButton {
                                text: Tr.t("AddDefaultCategories");
                                clicked => { root.add-default-categories(); }
                            }

                            TextButton {
                                text: Tr.t("AddCategory");
                                icon: @image-url("icons/add.svg");
                                has-icon: true;
                                clicked => { root.add-category(); }
                            }
                        }

                        for row in root.category-rows : Rectangle {
                            height: 46px;
                            background: transparent;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    border-radius: Radius.small;
                                    background: row.colour;
                                }

                                Text {
                                    text: row.name;
                                    color: Theme.text;
                                    font-size: Type.body-size;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }

                                if (row.transfer) : Text {
                                    text: Tr.t("CategoryTransferLabel");
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    vertical-alignment: center;
                                }

                                if (row.tax-relevant) : Text {
                                    text: Tr.t("TaxRelevant");
                                    color: Theme.warning;
                                    font-size: Type.label-small-size;
                                    font-weight: Type.label-small-weight;
                                    vertical-alignment: center;
                                }

                                if (row.budget-text != "") : Text {
                                    text: row.budget-text;
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: row.usage-text;
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    vertical-alignment: center;
                                }

                                IconButton {
                                    icon: @image-url("icons/edit.svg");
                                    label: Tr.t("Edit");
                                    tooltip-text: Tr.t("Edit");
                                    icon-size: 20px;
                                    clicked => { root.edit-category(row.id); }
                                }

                                IconButton {
                                    icon: @image-url("icons/delete.svg");
                                    label: Tr.t("Delete");
                                    tooltip-text: Tr.t("Delete");
                                    icon-size: 20px;
                                    icon-color: Theme.error;
                                    clicked => { root.delete-category(row.id); }
                                }
                            }
                        }

                        TaxKeywordsCard {
                            keywords <=> root.tax-keywords;
                            count: root.tax-keywords-count;
                            save(value) => { root.save-tax-keywords(value); }
                            reset => { root.reset-tax-keywords(); }
                        }
                    }
                }

                // Auto-categorization rules
                if (root.section == 3) : VerticalLayout {
                    alignment: start;
                    SectionHeader {
                        text: Tr.t("AutoCategorizationRules");

                        PrimaryButton {
                            text: Tr.t("AddRule");
                            enabled: !root.categories-empty;
                            clicked => { root.add-rule(); }
                        }

                        TextButton {
                            text: Tr.t("ImportRules");
                            clicked => { root.import-rules(); }
                        }

                        TextButton {
                            text: Tr.t("ExportRules");
                            clicked => { root.export-rules(); }
                        }
                    }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: Tr.t("RulesHint");
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            wrap: word-wrap;
                        }

                        if (root.categories-empty) : Text {
                            text: Tr.t("HintNeedsCategory");
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                        }

                        if (!root.categories-empty && root.rule-rows.length == 0) : Text {
                            text: Tr.t("NoRulesYet");
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                        }

                        for row in root.rule-rows : Rectangle {
                            height: 56px;
                            background: transparent;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                Text {
                                    text: row.pattern;
                                    width: 34%;
                                    color: Theme.text;
                                    font-size: Type.title-small-size;
                                    font-weight: Type.title-small-weight;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Text {
                                        text: "→ " + row.category-text;
                                        color: Theme.text;
                                        font-size: Type.body-size;
                                        overflow: elide;
                                    }

                                    if (row.detail != "") : Text {
                                        text: row.detail;
                                        color: Theme.muted-text;
                                        font-size: Type.body-small-size;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: row.prio-text;
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    vertical-alignment: center;
                                }

                                IconButton {
                                    icon: @image-url("icons/edit.svg");
                                    label: Tr.t("Edit");
                                    tooltip-text: Tr.t("Edit");
                                    icon-size: 20px;
                                    clicked => { root.edit-rule(row.id); }
                                }

                                IconButton {
                                    icon: @image-url("icons/delete.svg");
                                    label: Tr.t("Delete");
                                    tooltip-text: Tr.t("Delete");
                                    icon-size: 20px;
                                    icon-color: Theme.error;
                                    clicked => { root.delete-rule(row.id); }
                                }
                            }
                        }
                    }
                }

                // Security
                if (root.section == 4) : VerticalLayout {
                    alignment: start;
                    SectionHeader { text: Tr.t("Security"); }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: Tr.t("ChangePassphraseText");
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                            wrap: word-wrap;
                        }
                        PrimaryButton {
                            text: Tr.t("ChangePassphrase");
                            clicked => { root.open-change(); }
                        }
                    }
                }

                // Backup & restore
                if (root.section == 5) : VerticalLayout {
                    alignment: start;
                    SectionHeader { text: Tr.t("BackupAndRestore"); }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: Tr.t("BackupHint");
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            PrimaryButton {
                                text: Tr.t("CreateBackup");
                                enabled: !root.backup-busy;
                                clicked => { root.create-backup(); }
                            }

                            TextButton {
                                text: Tr.t("RestoreFromBackup");
                                enabled: !root.backup-busy && !root.backup-has-pending-restore;
                                clicked => { root.restore-backup(); }
                            }

                            if (root.backup-busy) : HorizontalLayout {
                                spacing: 8px;
                                Spinner {
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                        }

                        if (root.backup-has-pending-restore) : HorizontalLayout {
                            spacing: 12px;

                            Text {
                                text: Tr.t("RestoreWaiting");
                                color: Theme.warning;
                                font-size: Type.body-size;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }

                            TextButton {
                                text: Tr.t("CancelRestore");
                                enabled: !root.backup-busy;
                                clicked => { root.cancel-pending-restore(); }
                            }
                        }

                        if (root.backup-restored-text != "") : Text {
                            text: root.backup-restored-text;
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            wrap: word-wrap;
                        }
                    }
                }

                // Import from FinDesk
                if (root.section == 6) : VerticalLayout {
                    alignment: start;
                    SectionHeader { text: Tr.t("FinDeskImportTitle"); }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: Tr.t("FinDeskImportHint");
                            color: Theme.muted-text;
                            font-size: Type.body-small-size;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;

                            PrimaryButton {
                                text: Tr.t("FinDeskImportChooseFolder");
                                enabled: !root.findesk-busy;
                                clicked => { root.import-findesk(); }
                            }

                            if (root.findesk-busy) : HorizontalLayout {
                                spacing: 8px;
                                Spinner {
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                        }
                    }
                }

                // Audit log
                if (root.section == 7) : VerticalLayout {
                    alignment: start;
                    SectionHeader { text: Tr.t("AuditLogLatest"); }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    VerticalLayout {
                        spacing: 8px;

                        if (root.audit-rows.length == 0) : Text {
                            text: Tr.t("AuditLogEmpty");
                            color: Theme.muted-text;
                            font-size: Type.body-size;
                        }

                        for row in root.audit-rows : HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: row.time;
                                width: 130px;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                            }
                            Text {
                                text: row.action;
                                width: 190px;
                                color: Theme.text;
                                font-size: Type.label-small-size;
                                font-weight: Type.label-small-weight;
                                overflow: elide;
                            }
                            Text {
                                text: row.actor;
                                width: 70px;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                overflow: elide;
                            }
                            Text {
                                text: row.details;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                // About
                if (root.section == 8) : VerticalLayout {
                    alignment: start;
                    SectionHeader { text: Tr.t("AboutTitle"); }
                    Rectangle { height: 8px; background: transparent; }
                    Divider {}
                    Rectangle { height: 12px; background: transparent; }

                    HorizontalLayout {
                        spacing: 16px;

                        Image {
                            source: @image-url("../../../assets/icons/finglass-256.png");
                            width: 64px;
                            height: 64px;
                            image-fit: contain;
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Finglass";
                                color: Theme.text;
                                font-size: Type.title-large-size;
                                font-weight: Type.title-large-weight;
                            }
                            Text {
                                text: root.about-version-text;
                                color: Theme.text;
                                font-size: Type.body-size;
                            }
                            Text {
                                text: Tr.t("AboutText");
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }
                            Text {
                                text: Tr.t("AboutBankCodesSource");
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }
                        }
                    }

                    AboutSlint {
                        height: 100px;
                    }
                }
            }
        }
    }

    if (!root.narrow) : HorizontalLayout {
        padding: 24px;
        spacing: 0;

        SettingsSectionList {
            selected: root.section;
            vertical-stretch: 1;
            select(index) => { root.section = index; }
        }

        Rectangle {
            width: 1px;
            background: Theme.divider;
        }

        VerticalLayout {
            padding-left: 24px;
            spacing: 12px;
            horizontal-stretch: 1;

            if (root.settings-error != "" || root.settings-message != "") : SettingsBanner {
                error-text: root.settings-error;
                message-text: root.settings-message;
                dismiss => { root.dismiss-message(); }
            }

            ScrollView {
                content-y <=> root.scroll-y;

                VerticalLayout {
                    width: min(parent.width, 760px);
                    spacing: 0;
                    alignment: start;

                    // Appearance
                    if (root.section == 0) : VerticalLayout {
                        alignment: start;
                        SectionHeader { text: Tr.t("Appearance"); }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                Text {
                                    text: Tr.t("Theme");
                                    width: 120px;
                                    color: Theme.text;
                                    font-size: Type.body-size;
                                    vertical-alignment: center;
                                }
                                SegmentedButton {
                                    labels: [Tr.t("ThemeSystem"), Tr.t("ThemeLight"), Tr.t("ThemeDark")];
                                    selected: root.theme-pref == "system" ? 0 : (root.theme-pref == "light" ? 1 : 2);
                                    select(index) => {
                                        root.set-theme(index == 0 ? "system" : (index == 1 ? "light" : "dark"));
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                Text {
                                    text: Tr.t("Language");
                                    width: 120px;
                                    color: Theme.text;
                                    font-size: Type.body-size;
                                    vertical-alignment: center;
                                }
                                SegmentedButton {
                                    labels: ["EN", "DE", "FR"];
                                    selected: root.language == "en" ? 0 : (root.language == "de" ? 1 : 2);
                                    select(index) => {
                                        root.set-language(index == 0 ? "en" : (index == 1 ? "de" : "fr"));
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: Tr.t("PrimaryCurrency");
                                        color: Theme.text;
                                        font-size: Type.body-size;
                                    }
                                    Text {
                                        text: Tr.t("PrimaryCurrencyHint");
                                        color: Theme.muted-text;
                                        font-size: Type.body-small-size;
                                        wrap: word-wrap;
                                    }
                                }

                                SelectPill {
                                    label-prefix: "";
                                    value: root.primary-currency-index >= 0 && root.primary-currency-index < root.currency-options.length
                                            ? root.currency-options[root.primary-currency-index] : "";
                                    options: root.currency-options;
                                    chosen(index) => { root.set-primary-currency(index); }
                                }
                            }
                        }
                    }

                    // Profiles
                    if (root.section == 1) : VerticalLayout {
                        alignment: start;
                        SectionHeader {
                            text: Tr.t("Profiles");

                            PrimaryButton {
                                text: Tr.t("NewProfile");
                                icon: @image-url("icons/add.svg");
                                has-icon: true;
                                clicked => { root.new-profile(); }
                            }
                        }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: Tr.t("ProfilesHint");
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }

                            for row in root.profile-rows : Rectangle {
                                height: 46px;
                                background: transparent;

                                HorizontalLayout {
                                    spacing: 12px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: row.name;
                                        color: Theme.text;
                                        font-size: Type.title-small-size;
                                        font-weight: row.open ? Type.title-small-weight : Type.body-weight;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    if (row.open) : Rectangle {
                                        height: 22px;
                                        border-radius: Radius.tag;
                                        background: Theme.selected;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;

                                            Text {
                                                text: Tr.t("ProfileOpen");
                                                color: Theme.on-selected;
                                                font-size: Type.label-small-size;
                                                font-weight: Type.label-small-weight;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if (row.next-start) : Text {
                                        text: Tr.t("ProfileNextStart");
                                        color: Theme.muted-text;
                                        font-size: Type.body-small-size;
                                        vertical-alignment: center;
                                    }

                                    if (row.can-switch) : TextButton {
                                        text: Tr.t("OpenProfile");
                                        clicked => { root.switch-profile(row.index); }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/edit.svg");
                                        label: Tr.t("Edit");
                                        tooltip-text: Tr.t("Edit");
                                        icon-size: 20px;
                                        clicked => { root.rename-profile(row.index); }
                                    }

                                    if (row.can-delete) : IconButton {
                                        icon: @image-url("icons/delete.svg");
                                        label: Tr.t("Delete");
                                        tooltip-text: Tr.t("Delete");
                                        icon-size: 20px;
                                        icon-color: Theme.error;
                                        clicked => { root.delete-profile(row.index); }
                                    }
                                }
                            }
                        }
                    }

                    // Categories, including the tax suggestion keywords card.
                    if (root.section == 2) : VerticalLayout {
                        alignment: start;
                        SectionHeader {
                            text: Tr.t("Categories");

                            if (!root.categories-empty) : CategoriesHeaderActions {
                                has-duplicate-colours: root.has-duplicate-colours;
                                add-category => { root.add-category(); }
                                add-default-categories => { root.add-default-categories(); }
                                fix-duplicate-colours => { root.fix-duplicate-colours(); }
                            }
                        }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 12px;

                            if (root.categories-empty) : Text {
                                text: Tr.t("NoCategoriesYet");
                                color: Theme.muted-text;
                                font-size: Type.body-size;
                            }

                            if (root.categories-empty) : HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                PrimaryButton {
                                    text: Tr.t("AddDefaultCategories");
                                    clicked => { root.add-default-categories(); }
                                }

                                TextButton {
                                    text: Tr.t("AddCategory");
                                    icon: @image-url("icons/add.svg");
                                    has-icon: true;
                                    clicked => { root.add-category(); }
                                }
                            }

                            for row in root.category-rows : Rectangle {
                                height: 46px;
                                background: transparent;

                                HorizontalLayout {
                                    spacing: 12px;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 12px;
                                        height: 12px;
                                        border-radius: Radius.small;
                                        background: row.colour;
                                    }

                                    Text {
                                        text: row.name;
                                        color: Theme.text;
                                        font-size: Type.body-size;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    if (row.transfer) : Text {
                                        text: Tr.t("CategoryTransferLabel");
                                        color: Theme.muted-text;
                                        font-size: Type.body-small-size;
                                        vertical-alignment: center;
                                    }

                                    if (row.tax-relevant) : Text {
                                        text: Tr.t("TaxRelevant");
                                        color: Theme.warning;
                                        font-size: Type.label-small-size;
                                        font-weight: Type.label-small-weight;
                                        vertical-alignment: center;
                                    }

                                    if (row.budget-text != "") : Text {
                                        text: row.budget-text;
                                        color: Theme.muted-text;
                                        font-size: Type.body-small-size;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: row.usage-text;
                                        color: Theme.muted-text;
                                        font-size: Type.body-small-size;
                                        vertical-alignment: center;
                                    }

                                    IconButton {
                                        icon: @image-url("icons/edit.svg");
                                        label: Tr.t("Edit");
                                        tooltip-text: Tr.t("Edit");
                                        icon-size: 20px;
                                        clicked => { root.edit-category(row.id); }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/delete.svg");
                                        label: Tr.t("Delete");
                                        tooltip-text: Tr.t("Delete");
                                        icon-size: 20px;
                                        icon-color: Theme.error;
                                        clicked => { root.delete-category(row.id); }
                                    }
                                }
                            }

                            TaxKeywordsCard {
                                keywords <=> root.tax-keywords;
                                count: root.tax-keywords-count;
                                save(value) => { root.save-tax-keywords(value); }
                                reset => { root.reset-tax-keywords(); }
                            }
                        }
                    }

                    // Auto-categorization rules
                    if (root.section == 3) : VerticalLayout {
                        alignment: start;
                        SectionHeader {
                            text: Tr.t("AutoCategorizationRules");

                            PrimaryButton {
                                text: Tr.t("AddRule");
                                enabled: !root.categories-empty;
                                clicked => { root.add-rule(); }
                            }

                            TextButton {
                                text: Tr.t("ImportRules");
                                clicked => { root.import-rules(); }
                            }

                            TextButton {
                                text: Tr.t("ExportRules");
                                clicked => { root.export-rules(); }
                            }
                        }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: Tr.t("RulesHint");
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }

                            if (root.categories-empty) : Text {
                                text: Tr.t("HintNeedsCategory");
                                color: Theme.muted-text;
                                font-size: Type.body-size;
                            }

                            if (!root.categories-empty && root.rule-rows.length == 0) : Text {
                                text: Tr.t("NoRulesYet");
                                color: Theme.muted-text;
                                font-size: Type.body-size;
                            }

                            for row in root.rule-rows : Rectangle {
                                height: 56px;
                                background: transparent;

                                HorizontalLayout {
                                    spacing: 12px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: row.pattern;
                                        width: 34%;
                                        color: Theme.text;
                                        font-size: Type.title-small-size;
                                        font-weight: Type.title-small-weight;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        alignment: center;

                                        Text {
                                            text: "→ " + row.category-text;
                                            color: Theme.text;
                                            font-size: Type.body-size;
                                            overflow: elide;
                                        }

                                        if (row.detail != "") : Text {
                                            text: row.detail;
                                            color: Theme.muted-text;
                                            font-size: Type.body-small-size;
                                            overflow: elide;
                                        }
                                    }

                                    Text {
                                        text: row.prio-text;
                                        color: Theme.muted-text;
                                        font-size: Type.body-small-size;
                                        vertical-alignment: center;
                                    }

                                    IconButton {
                                        icon: @image-url("icons/edit.svg");
                                        label: Tr.t("Edit");
                                        tooltip-text: Tr.t("Edit");
                                        icon-size: 20px;
                                        clicked => { root.edit-rule(row.id); }
                                    }

                                    IconButton {
                                        icon: @image-url("icons/delete.svg");
                                        label: Tr.t("Delete");
                                        tooltip-text: Tr.t("Delete");
                                        icon-size: 20px;
                                        icon-color: Theme.error;
                                        clicked => { root.delete-rule(row.id); }
                                    }
                                }
                            }
                        }
                    }

                    // Security
                    if (root.section == 4) : VerticalLayout {
                        alignment: start;
                        SectionHeader { text: Tr.t("Security"); }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: Tr.t("ChangePassphraseText");
                                color: Theme.muted-text;
                                font-size: Type.body-size;
                                wrap: word-wrap;
                            }
                            PrimaryButton {
                                text: Tr.t("ChangePassphrase");
                                clicked => { root.open-change(); }
                            }
                        }
                    }

                    // Backup & restore
                    if (root.section == 5) : VerticalLayout {
                        alignment: start;
                        SectionHeader { text: Tr.t("BackupAndRestore"); }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: Tr.t("BackupHint");
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                PrimaryButton {
                                    text: Tr.t("CreateBackup");
                                    enabled: !root.backup-busy;
                                    clicked => { root.create-backup(); }
                                }

                                TextButton {
                                    text: Tr.t("RestoreFromBackup");
                                    enabled: !root.backup-busy && !root.backup-has-pending-restore;
                                    clicked => { root.restore-backup(); }
                                }

                                if (root.backup-busy) : HorizontalLayout {
                                    spacing: 8px;
                                    Spinner {
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }

                            if (root.backup-has-pending-restore) : HorizontalLayout {
                                spacing: 12px;

                                Text {
                                    text: Tr.t("RestoreWaiting");
                                    color: Theme.warning;
                                    font-size: Type.body-size;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }

                                TextButton {
                                    text: Tr.t("CancelRestore");
                                    enabled: !root.backup-busy;
                                    clicked => { root.cancel-pending-restore(); }
                                }
                            }

                            if (root.backup-restored-text != "") : Text {
                                text: root.backup-restored-text;
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Import from FinDesk
                    if (root.section == 6) : VerticalLayout {
                        alignment: start;
                        SectionHeader { text: Tr.t("FinDeskImportTitle"); }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: Tr.t("FinDeskImportHint");
                                color: Theme.muted-text;
                                font-size: Type.body-small-size;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                PrimaryButton {
                                    text: Tr.t("FinDeskImportChooseFolder");
                                    enabled: !root.findesk-busy;
                                    clicked => { root.import-findesk(); }
                                }

                                if (root.findesk-busy) : HorizontalLayout {
                                    spacing: 8px;
                                    Spinner {
                                        width: 20px;
                                        height: 20px;
                                    }
                                }
                            }
                        }
                    }

                    // Audit log
                    if (root.section == 7) : VerticalLayout {
                        alignment: start;
                        SectionHeader { text: Tr.t("AuditLogLatest"); }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        VerticalLayout {
                            spacing: 8px;

                            if (root.audit-rows.length == 0) : Text {
                                text: Tr.t("AuditLogEmpty");
                                color: Theme.muted-text;
                                font-size: Type.body-size;
                            }

                            for row in root.audit-rows : HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: row.time;
                                    width: 130px;
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                }
                                Text {
                                    text: row.action;
                                    width: 190px;
                                    color: Theme.text;
                                    font-size: Type.label-small-size;
                                    font-weight: Type.label-small-weight;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.actor;
                                    width: 70px;
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.details;
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    // About
                    if (root.section == 8) : VerticalLayout {
                        alignment: start;
                        SectionHeader { text: Tr.t("AboutTitle"); }
                        Rectangle { height: 8px; background: transparent; }
                        Divider {}
                        Rectangle { height: 12px; background: transparent; }

                        HorizontalLayout {
                            spacing: 16px;

                            Image {
                                source: @image-url("../../../assets/icons/finglass-256.png");
                                width: 64px;
                                height: 64px;
                                image-fit: contain;
                            }

                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Finglass";
                                    color: Theme.text;
                                    font-size: Type.title-large-size;
                                    font-weight: Type.title-large-weight;
                                }
                                Text {
                                    text: root.about-version-text;
                                    color: Theme.text;
                                    font-size: Type.body-size;
                                }
                                Text {
                                    text: Tr.t("AboutText");
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: Tr.t("AboutBankCodesSource");
                                    color: Theme.muted-text;
                                    font-size: Type.body-small-size;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        AboutSlint {
                            height: 100px;
                        }
                    }
                }
            }
        }
    }

    // The narrow window's section menu. The backdrop closes it on a click anywhere else.
    if (root.narrow && root.section-menu-open) : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            clicked => { root.section-menu-open = false; }
        }

        Rectangle {
            x: 24px;
            y: root.menu-y;
            width: root.width - 48px;
            height: 16px + 9 * 40px + 8 * 2px;
            border-radius: Radius.menu;
            border-width: 1px;
            border-color: Theme.divider;
            background: Theme.surface;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;

                for index in SettingsSections.indices : SettingsSectionRow {
                    index: index;
                    selected: index == root.section;
                    picked => {
                        root.section = index;
                        root.section-menu-open = false;
                    }
                    move-up => { root.section = max(0, index - 1); }
                    move-down => { root.section = min(8, index + 1); }
                }
            }
        }
    }

    if (root.findesk-passphrase-open) : FinDeskPassphraseDialog {
        folder: root.findesk-folder;
        wrong: root.findesk-passphrase-wrong;
        busy: root.findesk-busy;
        passphrase <=> root.findesk-passphrase;
        close => { root.findesk-passphrase-cancel(); }
        submit(value) => { root.findesk-passphrase-submit(value); }
    }

    if (root.findesk-report-open) : FinDeskReportDialog {
        title: root.findesk-report-title;
        text: root.findesk-report-text;
        is-error: root.findesk-report-error;
        close => { root.findesk-report-close(); }
    }
}

// The Security section's dialog. It reuses the Change mode's fields and validation.
export component ChangePassphraseDialog inherits Rectangle {
    in property <bool> busy;
    in property <string> error-text;

    callback close;
    callback submit(string, string, string, bool);

    property <string> current;
    property <string> new-passphrase;
    property <string> repeat;
    property <bool> show-passphrase;
    property <bool> acknowledged;

    width: 100%;
    height: 100%;
    background: Theme.scrim;

    function send() {
        if (root.busy) {
            return;
        }
        root.submit(root.current, root.new-passphrase, root.repeat, root.acknowledged);
    }

    Rectangle {
        width: 440px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.dialog;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: Tr.t("ChangePassphrase");
                color: Theme.text;
                font-size: Type.headline-size;
                font-weight: Type.headline-weight;
            }

            Text {
                text: Tr.t("ChangePassphraseText");
                color: Theme.muted-text;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            OutlinedField {
                label: Tr.t("CurrentPassphrase");
                enabled: !root.busy;
                text <=> root.current;
                input-type: root.show-passphrase ? InputType.text : InputType.password;
                accepted(text) => { root.send(); }
            }

            OutlinedField {
                label: Tr.t("NewPassphrase");
                enabled: !root.busy;
                text <=> root.new-passphrase;
                input-type: root.show-passphrase ? InputType.text : InputType.password;
                accepted(text) => { root.send(); }
            }

            OutlinedField {
                label: Tr.t("RepeatPassphrase");
                enabled: !root.busy;
                text <=> root.repeat;
                input-type: root.show-passphrase ? InputType.text : InputType.password;
                accepted(text) => { root.send(); }
            }

            Checkbox {
                enabled: !root.busy;
                text: Tr.t("ShowPassphrase");
                checked <=> root.show-passphrase;
            }

            Checkbox {
                enabled: !root.busy;
                text: Tr.t("PassphraseNoRecovery");
                checked <=> root.acknowledged;
            }

            if (root.error-text != "") : Text {
                text: root.error-text;
                color: Theme.error;
                font-size: Type.body-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                TextButton {
                    text: Tr.t("Cancel");
                    enabled: !root.busy;
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: Tr.t("ChangePassphrase");
                    enabled: !root.busy;
                    clicked => { root.send(); }
                }

                if (root.busy) : HorizontalLayout {
                    spacing: 8px;
                    Spinner {
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        text: Tr.t("Encrypting");
                        color: Theme.muted-text;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
