import { ScrollView } from "std-widgets.slint";
import { Radius, Theme, Type } from "theme.slint";
import { Tr } from "translations.slint";
import {
    AccountAmount,
    AccountGroupChoice,
    AccountPanelRow,
    AccountTone,
    BankBadge,
    ChoiceChip,
    CountBadge,
    OutlinedField,
    SearchField,
    TextButton,
} from "components.slint";

// The per-currency totals of one row, one line per currency, primary first.
component PanelAmounts inherits VerticalLayout {
    in property <[AccountAmount]> amounts;
    in property <bool> selected;

    alignment: end;
    spacing: 0px;

    for amount in root.amounts : Text {
        text: amount.text;
        color: root.selected ? Theme.on-selected : AccountTone.amount-color(amount.tone);
        font-size: Type.body-size;
        font-weight: Type.title-small-weight;
        horizontal-alignment: right;
        overflow: elide;
    }
}

component ChevronButton inherits Rectangle {
    in property <bool> collapsed;

    callback clicked;

    width: 20px;
    height: 20px;
    border-radius: Radius.icon-small;
    background: touch.has-hover ? Theme.divider : transparent;
    property <string> label: root.collapsed ? Tr.t("Expand") : Tr.t("Collapse");
    accessible-role: button;
    accessible-label: root.label;

    Image {
        width: 20px;
        height: 20px;
        source: root.collapsed ? @image-url("icons/keyboard_arrow_right.svg") : @image-url("icons/keyboard_arrow_down.svg");
        colorize: Theme.muted-text;
        accessible-role: none;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Tooltip {
        text: @markdown("\{root.label}");
    }
}

component DotButton inherits Rectangle {
    callback clicked;

    property <string> label: Tr.t("More");

    width: 24px;
    height: 24px;
    border-radius: Radius.icon;
    background: touch.has-hover ? Theme.divider : transparent;
    accessible-role: button;
    accessible-label: root.label;

    Image {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/more_vert.svg");
        colorize: Theme.muted-text;
        accessible-role: none;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Tooltip {
        text: @markdown("\{root.label}");
    }
}

// One compact action in a row's action strip. Unlike TextButton it may shrink to its label.
component PanelAction inherits Rectangle {
    in property <string> label;

    callback clicked;

    height: 24px;
    min-width: 0px;
    background: transparent;

    Text {
        text: root.label;
        color: touch.has-hover ? Theme.primary-hover : Theme.primary;
        font-size: Type.label-small-size;
        font-weight: Type.label-small-weight;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One row of the panel: "All accounts", a group header or an account.
component PanelRowView inherits Rectangle {
    in property <AccountPanelRow> item;
    /// A group header keeps 12 px of air above it, except the first one.
    in property <bool> group-gap: false;

    callback select;
    callback toggle;
    callback mark-read;
    callback rename-requested(int, string);
    callback delete-requested(int, string);
    callback move-requested(int);
    callback move-up;
    callback move-down;

    property <bool> actions-open: false;
    property <bool> has-menu: root.item.new-count > 0 || root.item.kind == "account" || (root.item.kind == "group" && root.item.group-kind == "custom");

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        if (root.group-gap) : Rectangle {
            height: 12px;
            background: transparent;
        }

        Rectangle {
            // Account rows are 52 px high and hold two lines: the name and the masked account
            // number. The last-fetched note moved to the row's tooltip.
            min-height: root.item.kind == "account" ? 52px : 36px;
            background: root.item.selected ? Theme.selected : (touch.has-hover ? Theme.background : transparent);

            // The row's own click target sits below the chevron and the menu button.
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.select();
                }
            }

            Rectangle {
                visible: root.item.selected;
                x: 0px;
                y: 0px;
                width: 3px;
                height: parent.height;
                background: Theme.primary;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                cross-axis-alignment: center;

                if (root.item.kind == "group") : ChevronButton {
                    collapsed: root.item.collapsed;
                    clicked => {
                        root.actions-open = false;
                        root.toggle();
                    }
                }

                // An account's badge takes the place of this spacer, so the name keeps its room.
                if (root.item.kind == "account" && root.item.logo == "" && root.item.logo-letters == "") : Rectangle {
                    width: 20px;
                    background: transparent;
                }

                // Only rows that stand for one bank get a badge; the narrow panel keeps it at 20 px so the
                // names stay readable.
                if (root.item.logo != "" || root.item.logo-letters != "") : VerticalLayout {
                    alignment: center;

                    BankBadge {
                        logo: root.item.logo;
                        letters: root.item.logo-letters;
                        colour-index: root.item.logo-colour;
                        size: 20px;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 0px;

                    Text {
                        text: root.item.label;
                        color: root.item.selected ? Theme.on-selected
                                : (root.item.kind == "group" ? Theme.muted-text : Theme.text);
                        font-size: root.item.kind == "group" ? Type.label-small-size : Type.label-size;
                        font-weight: root.item.kind == "group" ? Type.label-small-weight : Type.label-weight;
                        overflow: elide;
                    }

                    if (root.item.secondary != "") : Text {
                        text: root.item.secondary;
                        color: root.item.selected ? Theme.on-selected : Theme.muted-text;
                        font-size: Type.body-small-size;
                        overflow: elide;
                    }
                }

                // Own column so the unread badge cannot overlap the right-aligned amount.
                VerticalLayout {
                    // Only reserve a column when there is a badge to show.
                    width: root.item.new-count > 0 ? 20px : 0px;
                    alignment: center;

                    CountBadge {
                        count: root.item.new-count;
                        selected: false;
                    }
                }

                PanelAmounts {
                    amounts: root.item.totals;
                    selected: root.item.selected;
                }

                if (root.has-menu) : DotButton {
                    clicked => {
                        root.actions-open = !root.actions-open;
                    }
                }
            }

            if (root.item.detail != "") : Tooltip {
                text: @markdown("\{root.item.detail}");
            }
        }

        if (root.actions-open) : Rectangle {
            height: strip.preferred-height;
            background: Theme.background;

            strip := HorizontalLayout {
                padding-left: 24px;
                padding-right: 6px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 10px;
                alignment: start;

                if (root.item.new-count > 0) : PanelAction {
                    label: Tr.t("MarkAsRead");
                    clicked => {
                        root.actions-open = false;
                        root.mark-read();
                    }
                }

                if (root.item.kind == "group" && root.item.group-kind == "custom") : PanelAction {
                    label: Tr.t("RenameGroup");
                    clicked => {
                        root.actions-open = false;
                        root.rename-requested(root.item.id, root.item.name);
                    }
                }

                if (root.item.kind == "group" && root.item.group-kind == "custom") : PanelAction {
                    label: Tr.t("MoveUp");
                    clicked => {
                        root.actions-open = false;
                        root.move-up();
                    }
                }

                if (root.item.kind == "group" && root.item.group-kind == "custom") : PanelAction {
                    label: Tr.t("MoveDown");
                    clicked => {
                        root.actions-open = false;
                        root.move-down();
                    }
                }

                if (root.item.kind == "group" && root.item.group-kind == "custom") : PanelAction {
                    label: Tr.t("Delete");
                    clicked => {
                        root.actions-open = false;
                        root.delete-requested(root.item.id, root.item.delete-text);
                    }
                }

                if (root.item.kind == "account") : PanelAction {
                    label: Tr.t("MoveToGroup");
                    clicked => {
                        root.actions-open = false;
                        root.move-requested(root.item.id);
                    }
                }
            }
        }
    }
}

// The shared account panel: filter, "All accounts" with its per-currency total, groups with their
// accounts, and the group actions. The Transactions page reuses it later.
export component AccountPanel inherits Rectangle {
    in property <[AccountPanelRow]> rows;
    in property <[AccountGroupChoice]> groups;
    in property <string> filter-text;
    in property <string> shown-text;

    callback filter-changed(string);
    callback select(string, string, int, string);
    callback toggle(string, string, int, string);
    callback mark-read(string, string, int, string);
    callback new-group(string);
    callback rename-group(int, string);
    callback delete-group(int);
    callback move-group(int, bool);
    callback move-account(int, int);

    property <bool> creating: false;
    property <string> create-name: "";
    property <int> renaming-id: -1;
    property <string> rename-name: "";
    property <int> deleting-id: -1;
    property <string> deleting-text: "";
    property <int> moving-account-id: -1;
    property <int> move-group-id: -1;

    function reset-form() {
        root.creating = false;
        root.renaming-id = -1;
        root.deleting-id = -1;
        root.moving-account-id = -1;
    }

    function start-rename(id: int, name: string) {
        root.reset-form();
        root.renaming-id = id;
        root.rename-name = name;
    }

    function start-delete(id: int, text: string) {
        root.reset-form();
        root.deleting-id = id;
        root.deleting-text = text;
    }

    function start-move(id: int) {
        root.reset-form();
        root.moving-account-id = id;
        root.move-group-id = -1;
    }

    background: Theme.surface;
    border-radius: Radius.surface;
    border-width: 1px;
    border-color: Theme.divider;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        SearchField {
            text: root.filter-text;
            placeholder: Tr.t("FilterAccounts");
            edited(text) => {
                root.filter-changed(text);
            }
        }

        if (root.shown-text != "") : Text {
            text: root.shown-text;
            color: Theme.muted-text;
            font-size: Type.body-small-size;
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 0px;

                for panel-row[index] in root.rows : PanelRowView {
                    item: panel-row;
                    group-gap: index > 1 && panel-row.kind == "group";
                    select => {
                        root.select(panel-row.kind, panel-row.group-kind, panel-row.id, panel-row.account-type);
                    }
                    toggle => {
                        root.toggle(panel-row.kind, panel-row.group-kind, panel-row.id, panel-row.account-type);
                    }
                    mark-read => {
                        root.mark-read(panel-row.kind, panel-row.group-kind, panel-row.id, panel-row.account-type);
                    }
                    rename-requested(id, name) => {
                        root.start-rename(id, name);
                    }
                    delete-requested(id, text) => {
                        root.start-delete(id, text);
                    }
                    move-requested(id) => {
                        root.start-move(id);
                    }
                    move-up => {
                        root.move-group(panel-row.id, true);
                    }
                    move-down => {
                        root.move-group(panel-row.id, false);
                    }
                }
            }
        }

        if (root.creating) : Rectangle {
            background: Theme.background;
            border-radius: Radius.panel;
            height: create-form.preferred-height;

            create-form := VerticalLayout {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: Tr.t("NewGroup");
                    color: Theme.text;
                    font-size: Type.label-small-size;
                    font-weight: Type.label-small-weight;
                }

                OutlinedField {
                    label: Tr.t("GroupName");
                    text <=> root.create-name;
                    accepted(text) => {
                        if (text != "") {
                            root.new-group(text);
                            root.reset-form();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    PanelAction {
                        label: Tr.t("Save");
                        clicked => {
                            if (root.create-name != "") {
                                root.new-group(root.create-name);
                                root.reset-form();
                            }
                        }
                    }

                    PanelAction {
                        label: Tr.t("Cancel");
                        clicked => {
                            root.reset-form();
                        }
                    }
                }
            }
        }

        if (root.renaming-id >= 0) : Rectangle {
            background: Theme.background;
            border-radius: Radius.panel;
            height: rename-form.preferred-height;

            rename-form := VerticalLayout {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: Tr.t("RenameGroup");
                    color: Theme.text;
                    font-size: Type.label-small-size;
                    font-weight: Type.label-small-weight;
                }

                OutlinedField {
                    label: Tr.t("GroupName");
                    text <=> root.rename-name;
                    accepted(text) => {
                        if (text != "") {
                            root.rename-group(root.renaming-id, text);
                            root.reset-form();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    PanelAction {
                        label: Tr.t("Save");
                        clicked => {
                            if (root.rename-name != "") {
                                root.rename-group(root.renaming-id, root.rename-name);
                                root.reset-form();
                            }
                        }
                    }

                    PanelAction {
                        label: Tr.t("Cancel");
                        clicked => {
                            root.reset-form();
                        }
                    }
                }
            }
        }

        if (root.deleting-id >= 0) : Rectangle {
            background: Theme.background;
            border-radius: Radius.panel;
            height: delete-form.preferred-height;

            delete-form := VerticalLayout {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: root.deleting-text;
                    color: Theme.text;
                    font-size: Type.body-small-size;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    PanelAction {
                        label: Tr.t("Delete");
                        clicked => {
                            root.delete-group(root.deleting-id);
                            root.reset-form();
                        }
                    }

                    PanelAction {
                        label: Tr.t("Cancel");
                        clicked => {
                            root.reset-form();
                        }
                    }
                }
            }
        }

        if (root.moving-account-id >= 0) : Rectangle {
            background: Theme.background;
            border-radius: Radius.panel;
            height: move-form.preferred-height;

            move-form := VerticalLayout {
                padding: 8px;
                spacing: 6px;

                Text {
                    text: Tr.t("MoveToGroup");
                    color: Theme.text;
                    font-size: Type.label-small-size;
                    font-weight: Type.label-small-weight;
                }

                ChoiceChip {
                    label: Tr.t("DefaultGroup");
                    selected: root.move-group-id < 0;
                    clicked => {
                        root.move-group-id = -1;
                    }
                }

                for group in root.groups : ChoiceChip {
                    label: group.name;
                    selected: root.move-group-id == group.id;
                    clicked => {
                        root.move-group-id = group.id;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    PanelAction {
                        label: Tr.t("Save");
                        clicked => {
                            root.move-account(root.moving-account-id, root.move-group-id);
                            root.reset-form();
                        }
                    }

                    PanelAction {
                        label: Tr.t("Cancel");
                        clicked => {
                            root.reset-form();
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        TextButton {
            text: Tr.t("NewGroup");
            icon: @image-url("icons/add.svg");
            has-icon: true;
            clicked => {
                root.reset-form();
                root.creating = true;
            }
        }
    }
}
