import { Radius, Theme, Type } from "theme.slint";
import { DashboardCategoryRow, DashboardMonthBar } from "components.slint";

// The spending split: one horizontal 100% bar and one legend row per category.
export component CategorySplit inherits Rectangle {
    in property <[DashboardCategoryRow]> rows;
    in property <string> transfers-note;
    in property <bool> selectable: true;

    callback select(int);

    background: transparent;

    VerticalLayout {
        spacing: 12px;

        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.divider;
            clip: true;

            HorizontalLayout {
                spacing: 2px;

                for row in root.rows : Rectangle {
                    visible: row.fraction > 0.0;
                    horizontal-stretch: row.fraction;
                    background: row.is-more ? Theme.divider : row.colour;
                }
            }
        }

        VerticalLayout {
            spacing: 4px;

            for row in root.rows : Rectangle {
                height: 28px;
                border-radius: Radius.small;
                background: !row.is-more && root.selectable && row-touch.has-hover ? Theme.background : transparent;

                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 4px;
                    padding-right: 4px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: Radius.bar;
                            background: row.is-more ? Theme.divider : row.colour;
                        }
                    }

                    Text {
                        text: row.label;
                        color: row.is-more ? Theme.muted-text : Theme.text;
                        font-size: Type.body-size;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: row.percent-text;
                        width: 48px;
                        color: row.is-more ? Theme.muted-text : Theme.text;
                        font-size: Type.body-size;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    Text {
                        text: row.amount-text;
                        width: 96px;
                        color: row.is-more ? Theme.muted-text : Theme.text;
                        font-size: Type.body-size;
                        font-weight: Type.title-small-weight;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    // Centred on the row: a fixed-size element in a HorizontalLayout sits at the top.
                    VerticalLayout {
                        alignment: center;
                        Image {
                            visible: !row.is-more && root.selectable;
                            width: 18px;
                            height: 18px;
                            source: @image-url("icons/keyboard_arrow_right.svg");
                            colorize: Theme.muted-text;
                            accessible-role: none;
                        }
                    }
                }

                row-touch := TouchArea {
                    enabled: !row.is-more && root.selectable;
                    mouse-cursor: pointer;
                    clicked => {
                        root.select(row.category-id);
                    }
                }
            }
        }

        if (root.transfers-note != "") : Text {
            text: root.transfers-note;
            color: Theme.muted-text;
            font-size: Type.body-small-size;
        }
    }
}

// Grouped income/expense bars for six months, on an axis from zero to a round maximum.
export component IncomeExpenseChart inherits Rectangle {
    in property <[DashboardMonthBar]> bars;
    in property <string> axis-top;
    in property <string> axis-mid;
    in property <string> axis-zero;
    in property <string> empty-text;
    in property <string> income-label;
    in property <string> expenses-label;
    in property <string> partial-note;
    in property <string> so-far-text;

    background: transparent;

    VerticalLayout {
        spacing: 4px;

        if (root.empty-text != "") : Text {
            text: root.empty-text;
            color: Theme.muted-text;
            font-size: Type.body-size;
            wrap: word-wrap;
        }

        if (root.empty-text == "") : VerticalLayout {
            spacing: 2px;

            HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    width: 64px;
                    height: 160px;
                    alignment: space-between;

                    Text {
                        text: root.axis-top;
                        color: Theme.muted-text;
                        font-size: Type.caption-size;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                    Text {
                        text: root.axis-mid;
                        color: Theme.muted-text;
                        font-size: Type.caption-size;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                    Text {
                        text: root.axis-zero;
                        color: Theme.muted-text;
                        font-size: Type.caption-size;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }

                Rectangle {
                    height: 160px;
                    horizontal-stretch: 1;
                    background: transparent;

                    Rectangle {
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.divider;
                    }
                    Rectangle {
                        y: parent.height / 2;
                        width: parent.width;
                        height: 1px;
                        background: Theme.divider;
                    }
                    Rectangle {
                        y: parent.height - self.height;
                        width: parent.width;
                        height: 1px;
                        background: Theme.divider;
                    }

                    HorizontalLayout {
                        for bar[index] in root.bars : Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            property <length> bar-width: min(parent.width * 0.30, 24px);
                            property <length> group-width: self.bar-width * 2 + 2px;

                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: month-touch.has-hover ? Theme.background : transparent;
                            }

                            Rectangle {
                                x: (parent.width - parent.group-width) / 2;
                                width: parent.bar-width;
                                height: parent.height * bar.income-fraction;
                                y: parent.height - self.height;
                                border-top-left-radius: 4px;
                                border-top-right-radius: 4px;
                                border-bottom-left-radius: 0px;
                                border-bottom-right-radius: 0px;
                                background: Theme.chart-in;
                                opacity: bar.partial ? 0.45 : 1.0;
                            }

                            Rectangle {
                                x: (parent.width - parent.group-width) / 2 + parent.bar-width + 2px;
                                width: parent.bar-width;
                                height: parent.height * bar.expenses-fraction;
                                y: parent.height - self.height;
                                border-top-left-radius: 4px;
                                border-top-right-radius: 4px;
                                border-bottom-left-radius: 0px;
                                border-bottom-right-radius: 0px;
                                background: Theme.chart-out;
                                opacity: bar.partial ? 0.45 : 1.0;
                            }

                            month-touch := TouchArea {
                                mouse-cursor: pointer;
                            }

                            Rectangle {
                                visible: month-touch.has-hover;
                                width: 176px;
                                height: tip.preferred-height;
                                x: index < root.bars.length / 2 ? 0px : parent.width - self.width;
                                y: 8px;
                                border-radius: 8px;
                                background: Theme.text;

                                tip := VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    alignment: start;

                                    Text {
                                        text: bar.title;
                                        color: Theme.surface;
                                        font-size: Type.label-small-size;
                                        font-weight: Type.label-small-weight;
                                    }

                                    if (bar.partial) : Text {
                                        text: root.so-far-text;
                                        color: Theme.surface;
                                        opacity: 0.75;
                                        font-size: Type.caption-size;
                                        font-weight: Type.caption-weight;
                                    }

                                    HorizontalLayout {
                                        spacing: 5px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 7px;
                                                height: 7px;
                                                border-radius: Radius.marker;
                                                background: Theme.chart-in;
                                            }
                                        }

                                        Text {
                                            text: root.income-label;
                                            color: Theme.surface;
                                            font-size: Type.caption-size;
                                            font-weight: Type.caption-weight;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: bar.income-text;
                                            color: Theme.surface;
                                            font-size: Type.label-small-size;
                                            font-weight: Type.label-small-weight;
                                            horizontal-alignment: right;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 5px;
                                        alignment: start;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 7px;
                                                height: 7px;
                                                border-radius: Radius.marker;
                                                background: Theme.chart-out;
                                            }
                                        }

                                        Text {
                                            text: root.expenses-label;
                                            color: Theme.surface;
                                            font-size: Type.caption-size;
                                            font-weight: Type.caption-weight;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: bar.expenses-text;
                                            color: Theme.surface;
                                            font-size: Type.label-small-size;
                                            font-weight: Type.label-small-weight;
                                            horizontal-alignment: right;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-left: 72px;

                for bar in root.bars : Text {
                    text: bar.label;
                    // Equal slots under the bars, whatever the label length.
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    color: Theme.muted-text;
                    font-size: Type.caption-size;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: Radius.bar;
                            background: Theme.chart-in;
                        }
                    }
                    Text {
                        text: root.income-label;
                        color: Theme.text;
                        font-size: Type.body-small-size;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: Radius.bar;
                            background: Theme.chart-out;
                        }
                    }
                    Text {
                        text: root.expenses-label;
                        color: Theme.text;
                        font-size: Type.body-small-size;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.partial-note;
                    color: Theme.muted-text;
                    font-size: Type.body-small-size;
                    vertical-alignment: center;
                }
            }
        }
    }
}
