                has-tax: root.reports-has-tax;
                tax-empty: root.reports-tax-empty;
                tax-income-value: root.reports-tax-income-value;
                tax-deduction-value: root.reports-tax-deduction-value;
                tax-net-value: root.reports-tax-net-value;
                tax-net-tone: root.reports-tax-net-tone;
                tax-receipts-value: root.reports-tax-receipts-value;
                tax-receipts-subtitle: root.reports-tax-receipts-subtitle;
                tax-receipts-missing: root.reports-tax-receipts-missing;
                tax-other-hint: root.reports-tax-other-hint;
                tax-suggestions-title: root.reports-tax-suggestions-title;
                tax-suggestions-hint: root.reports-tax-suggestions-hint;
                tax-suggestions: root.reports-tax-suggestions;
                missing-receipts-only: root.reports-missing-receipts-only;
                tax-empty-title: root.reports-tax-empty-title;
                tax-empty-hint: root.reports-tax-empty-hint;
                tax-rows: root.reports-tax-rows;

                select-tab(value) => { root.reports-tab = value; }
                set-custom(value) => { root.reports-set-custom(value); }
                change-year(delta) => { root.reports-change-year(delta); }
                apply-range(from, to) => { root.reports-apply-range(from, to); }
                export-report-pdf => { root.reports-export-report-pdf(); }
                export-csv => { root.reports-export-csv(); }
                export-tax-xlsx => { root.reports-export-tax-xlsx(); }
                export-tax-pdf => { root.reports-export-tax-pdf(); }
                print-tax => { root.reports-print-tax(); }
                set-missing-only(value) => { root.reports-set-missing-only(value); }
                accept-suggestion(id) => { root.reports-accept-suggestion(id); }
                dismiss-suggestion(id) => { root.reports-dismiss-suggestion(id); }
                mark-not-tax-relevant(id) => { root.reports-mark-not-tax-relevant(id); }
                reset-tax-automatic(id) => { root.reports-reset-tax-automatic(id); }
                open-category(id) => { root.reports-open-category(id); }
                dismiss => { root.reports-dismiss(); }
            }

            if (root.current-screen == "accounts") : AccountsPage {
                loading: root.accounts-loading;
                show-content: root.accounts-show-content;
                has-content: root.accounts-has-content;
                error-text: root.accounts-error-text;
                message-text: root.accounts-message-text;
                figures: root.accounts-figures;
                bank-cards: root.accounts-bank-cards;
                type-choices: root.accounts-type-choices;
                currency-codes: root.accounts-currency-codes;
                days-choices: root.accounts-days-choices;

                dialog: root.accounts-dialog;
                dialog-title: root.accounts-dialog-title;
                dialog-text: root.accounts-dialog-text;
                dialog-error: root.accounts-dialog-error;
                dialog-account-label: root.accounts-dialog-account-label;
                dialog-account-name: root.accounts-dialog-account-name;
                dialog-balance: root.accounts-dialog-balance;
                dialog-account-type: root.accounts-dialog-account-type;
                dialog-offline: root.accounts-dialog-offline;
                dialog-bank-id: root.accounts-dialog-bank-id;
                dialog-account-id: root.accounts-dialog-account-id;

                detail-open: root.accounts-detail-open;
                detail-title: root.accounts-detail-title;
                detail-subtitle: root.accounts-detail-subtitle;
                detail-balance: root.accounts-detail-balance;
                detail-tone: root.accounts-detail-tone;
                detail-account-id: root.accounts-detail-account-id;
                detail-days: root.accounts-detail-days;
                detail-summary: root.accounts-detail-summary;
                detail-path: root.accounts-detail-path;
                detail-axis-top: root.accounts-detail-axis-top;
                detail-axis-bottom: root.accounts-detail-axis-bottom;
                detail-rows: root.accounts-detail-rows;

                open-add-bank => { root.accounts-open-add-bank(); }
                close-dialog => { root.accounts-close-dialog(); }
                submit-add-bank(name) => { root.accounts-submit-add-bank(name); }
                open-add-account(bank-id) => { root.accounts-open-add-account(bank-id); }
                submit-add-account(bank-id, name, identifier, account-type, currency, balance) => {
                    root.accounts-submit-add-account(bank-id, name, identifier, account-type, currency, balance);
                }
                open-balance(account-id) => { root.accounts-open-balance(account-id); }
                submit-balance(account-id, balance, account-type) => {
                    root.accounts-submit-balance(account-id, balance, account-type);
                }
                open-rename(account-id) => { root.accounts-open-rename(account-id); }
                submit-rename(account-id, name) => { root.accounts-submit-rename(account-id, name); }
                open-delete-account(account-id) => { root.accounts-open-delete-account(account-id); }
                confirm-delete-account(account-id) => { root.accounts-confirm-delete-account(account-id); }
                open-delete-bank(bank-id) => { root.accounts-open-delete-bank(bank-id); }
                confirm-delete-bank(bank-id) => { root.accounts-confirm-delete-bank(bank-id); }
                close-detail => { root.accounts-close-detail(); }
                select-days(account-id, days) => { root.accounts-select-days(account-id, days); }
                toggle-bank(bank-id) => { root.accounts-toggle-bank(bank-id); }
                forget-deleted(account-id) => { root.accounts-forget-deleted(account-id); }
                dismiss-message => { root.accounts-dismiss-message(); }
                open-detail(account-id) => { root.accounts-open-detail(account-id); }
            }

            if (root.current-screen == "settings") : SettingsPage {
                theme-pref: root.theme-pref;
                language: root.language;
                about-version-text: root.about-version-text;
                audit-rows: root.audit-rows;

                settings-error: root.settings-error;
                settings-message: root.settings-message;
                categories-empty: root.settings-categories-empty;
                has-duplicate-colours: root.settings-has-duplicate-colours;
                primary-currency: root.settings-primary-currency;
                currency-options: root.settings-currency-options;
                primary-currency-index <=> root.settings-primary-currency-index;
                category-rows: root.settings-category-rows;
                rule-rows: root.settings-rule-rows;
                tax-keywords <=> root.settings-tax-keywords;
                tax-keywords-count: root.settings-tax-keywords-count;
                backup-busy: root.settings-backup-busy;
                backup-has-pending-restore: root.settings-has-pending-restore;
                backup-restored-text: root.settings-backup-restored-text;
                scroll-y <=> root.settings-scroll-y;

                set-theme(value) => { root.set-theme(value); }
                set-language(value) => { root.set-language(value); }
                open-change => { root.open-change(); }
                dismiss-message => { root.settings-dismiss-message(); }
                set-primary-currency(value) => { root.settings-set-primary-currency(value); }
                add-category => { root.settings-add-category(); }
                edit-category(id) => { root.settings-edit-category(id); }
                delete-category(id) => { root.settings-delete-category(id); }
                add-default-categories => { root.settings-add-default-categories(); }
                fix-duplicate-colours => { root.settings-fix-duplicate-colours(); }
                add-rule => { root.settings-add-rule(); }
                edit-rule(id) => { root.settings-edit-rule(id); }
                delete-rule(id) => { root.settings-delete-rule(id); }
                import-rules => { root.settings-import-rules(); }
                export-rules => { root.settings-export-rules(); }
                save-tax-keywords(text) => { root.settings-save-tax-keywords(text); }
                reset-tax-keywords => { root.settings-reset-tax-keywords(); }
                create-backup => { root.settings-create-backup(); }
                restore-backup => { root.settings-restore-backup(); }
                cancel-pending-restore => { root.settings-cancel-pending-restore(); }
            }

            if (root.current-screen == "documents") : DocumentsPage {
                rows: root.document-rows;
                tab: root.documents-tab;
                tab-all-label: root.documents-tab-all-label;
                tab-unlinked-label: root.documents-tab-unlinked-label;
                tab-linked-label: root.documents-tab-linked-label;
                search-query: root.documents-search-query;
                ocr-available: root.documents-ocr-available;
                ocr-hint: root.documents-ocr-hint;
                uploading: root.documents-uploading;
                progress-text: root.documents-progress-text;
                loading: root.documents-loading;
                error-text: root.documents-error;
                message-text: root.documents-message;
                has-selection: root.documents-has-selection;
                selected-name: root.documents-selected-name;
                selected-linked: root.documents-selected-linked;
                selected-link-label: root.documents-selected-link-label;
                selected-ocr-heading: root.documents-selected-ocr-heading;
                selected-ocr-text: root.documents-selected-ocr-text;
                preview-kind: root.documents-preview-kind;
                preview: root.documents-preview;
                suggestions: root.documents-suggestions;
                candidates: root.documents-candidates;
                candidate-query: root.documents-candidate-query;
                delete-text: root.documents-delete-text;

                set-tab(value) => { root.documents-set-tab(value); }
                search(value) => { root.documents-search(value); }
                select(id) => { root.documents-select(id); }
                close-detail => { root.documents-close-detail(); }
                link(id) => { root.documents-link(id); }
                unlink => { root.documents-unlink(); }
                reprocess => { root.documents-reprocess(); }
                delete => { root.documents-confirm-delete(); }
                upload => { root.documents-upload(); }
                open => { root.documents-open(); }
                candidate-query-changed(value) => { root.documents-candidate-query-changed(value); }
                dismiss => { root.documents-dismiss(); }
            }

            if (root.current-screen != "settings" && root.current-screen != "dashboard" && root.current-screen != "reports" && root.current-screen != "accounts" && root.current-screen != "documents") : VerticalLayout {
                padding: 32px;
                spacing: 12px;

                Text {
                    text: Tr.t("ComingSoon");
                    color: Theme.muted-text;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Test-only harness for the panel's own screenshot; the Transactions page hosts it later.
    if (root.accounts-panel-preview) : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background;

        AccountPanel {
            width: 320px;
            height: parent.height - 48px;
            x: (parent.width - self.width) / 2;
            y: 24px;
            rows: root.accounts-panel-rows;
            groups: root.accounts-group-choices;
            filter-text: root.accounts-filter-text;
            shown-text: root.accounts-shown-text;

            filter-changed(text) => { root.accounts-filter-changed(text); }
            select(kind, group-kind, id, account-type) => {
                root.accounts-select(kind, group-kind, id, account-type);
            }
            toggle(kind, group-kind, id, account-type) => {
                root.accounts-toggle-group(kind, group-kind, id, account-type);
            }
            mark-read(kind, group-kind, id, account-type) => {
                root.accounts-mark-read(kind, group-kind, id, account-type);
            }
            new-group(name) => { root.accounts-new-group(name); }
            rename-group(id, name) => { root.accounts-rename-group(id, name); }
            delete-group(id) => { root.accounts-delete-group(id); }
            move-group(id, up) => { root.accounts-move-group(id, up); }
            move-account(account-id, group-id) => { root.accounts-move-account(account-id, group-id); }
        }
    }

    if (root.change-open) : ChangePassphraseDialog {
        busy: root.change-busy;
        error-text: root.change-error;
        close => { root.close-change(); }
        submit(current, new-passphrase, repeat, acknowledged) => {
            root.change-passphrase(current, new-passphrase, repeat, acknowledged);
        }
    }

    if (root.category-dialog-open) : CategoryDialog {
        title: root.category-dialog-id < 0 ? Tr.t("AddCategory") : Tr.t("EditCategory");
        name <=> root.category-dialog-name;
        colour <=> root.category-dialog-colour;
        budget <=> root.category-dialog-budget;
        tax-relevant <=> root.category-dialog-tax;
        transfer <=> root.category-dialog-transfer;
        error-text: root.category-dialog-error;
        swatches: root.category-dialog-swatches;
        changed(name, colour) => { root.settings-category-changed(name, colour); }
        close => { root.settings-category-dialog-close(); }
        save => { root.settings-category-dialog-save(); }
    }

    if (root.category-delete-open) : ConfirmDialog {
        title: root.category-delete-title;
        text: root.category-delete-text;
        confirm-text: Tr.t("Delete");
        confirm => { root.settings-confirm-delete-category(); }
        cancel => { root.settings-cancel-delete-category(); }
    }

    if (root.rule-dialog-open) : RuleDialog {
        title: root.rule-dialog-id < 0 ? Tr.t("AddRule") : Tr.t("EditRule");
        pattern <=> root.rule-dialog-pattern;
        categories: root.rule-dialog-categories;
        category-index <=> root.rule-dialog-category-index;
        priority <=> root.rule-dialog-priority;
        auto-apply <=> root.rule-dialog-auto-apply;
        field-options: root.rule-dialog-field-options;
        field-index <=> root.rule-dialog-field-index;
        direction-options: root.rule-dialog-direction-options;
        direction-index <=> root.rule-dialog-direction-index;
        tax-options: root.rule-dialog-tax-options;
        tax-index <=> root.rule-dialog-tax-index;
        error-text: root.rule-dialog-error;
        changed(pattern, priority) => { root.settings-rule-changed(pattern, priority); }
        close => { root.settings-rule-dialog-close(); }
        save => { root.settings-rule-dialog-save(); }
    }

    if (root.rule-delete-open) : ConfirmDialog {
        title: root.rule-delete-title;
        text: root.rule-delete-text;
        confirm-text: Tr.t("Delete");
        confirm => { root.settings-confirm-delete-rule(); }
        cancel => { root.settings-cancel-delete-rule(); }
    }

    if (root.rule-import-open) : RuleImportDialog {
        new-rules-text: root.rule-import-new-rules-text;
        categories-text: root.rule-import-categories-text;
        categories-list: root.rule-import-categories-list;
        duplicates-text: root.rule-import-duplicates-text;
        conflicts-text: root.rule-import-conflicts-text;
        conflicts-list: root.rule-import-conflicts-list;
        errors-text: root.rule-import-errors-text;
        errors-list: root.rule-import-errors-list;
        show-categorize: root.rule-import-show-categorize;
        categorize-text: root.rule-import-categorize-text;
        categorize <=> root.rule-import-categorize;
        busy: root.rule-import-busy;
        confirm-enabled: root.rule-import-confirm-enabled;
        close => { root.settings-cancel-rule-import(); }
        confirm => { root.settings-confirm-rule-import(); }
    }

    if (root.settings-restore-open) : ConfirmDialog {
        title: root.settings-restore-title;
        text: root.settings-restore-text;
        confirm-text: Tr.t("PrepareRestore");
        busy: root.settings-backup-busy;
        confirm => { root.settings-confirm-restore(); }
        cancel => { root.settings-cancel-restore(); }
    }

    if (root.settings-restore-passphrase-open) : BackupPassphraseDialog {
        file-name: root.settings-restore-passphrase-file;
        wrong: root.settings-restore-passphrase-wrong;
        busy: root.settings-backup-busy;
        passphrase <=> root.settings-restore-passphrase;
        close => { root.settings-cancel-restore-passphrase(); }
        submit(value) => { root.settings-confirm-restore-passphrase(value); }
    }
}
