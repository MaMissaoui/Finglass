import { Theme } from "theme.slint";
import { DocumentsPage } from "documents_page.slint";
import { Tr } from "translations.slint";
import { AccountAmount, AccountDaysChoice, AccountDetailRow, AccountGroupChoice, AccountPanelRow, AccountTypeChoice, AccountsBankCard, AccountsFigure, DashboardBudgetRow, DashboardCategoryRow, DashboardMonthBar, DashboardTaxSlice, DashboardTransactionRow, DashboardUpcomingRow, DocumentLinkRow, DocumentRow, NavItem, ReportAmountRow, ReportMonthlyRow, ReportRecurringRow, ReportSuggestionRow, ReportTaxRow, ReportVendorRow, TextButton } from "components.slint";
import { AuditRow, CategoryRow, ColourSwatch, RuleRow } from "models.slint";
import { DashboardPage } from "dashboard_page.slint";
import { ReportsPage } from "reports_page.slint";
import { AccountPanel } from "account_panel.slint";
import { AccountsPage } from "accounts_page.slint";
import { ChangePassphraseDialog, SettingsPage } from "settings_page.slint";
import { BackupPassphraseDialog, CategoryDialog, ConfirmDialog, RuleDialog, RuleImportDialog } from "settings_dialogs.slint";

// The main window: sidebar navigation, placeholder screens and the settings sections.
export component MainWindow inherits Window {
    in property <string> app-name: "Finglass";
    in property <string> version;
    in property <string> about-version-text;
    in property <string> current-screen: "dashboard";
    in property <string> theme-pref: "system";
    in property <string> language: "en";
    in property <string> status-text;
    in property <bool> change-open;
    in property <bool> change-busy;
    in property <string> change-error;
    in property <[AuditRow]> audit-rows;

    // Settings page state, prepared by the mapping in src/settings.rs.
    in property <string> settings-error;
    in property <string> settings-message;
    in property <bool> settings-categories-empty;
    in property <bool> settings-has-duplicate-colours;
    in property <[string]> settings-currency-options;
    in property <string> settings-primary-currency;
    in-out property <int> settings-primary-currency-index;
    in property <[CategoryRow]> settings-category-rows;
    in property <[RuleRow]> settings-rule-rows;
    in-out property <string> settings-tax-keywords;
    in property <string> settings-tax-keywords-count;
    in-out property <length> settings-scroll-y;

    // Backup & restore section and its dialogs.
    in property <bool> settings-backup-busy;
    in property <bool> settings-has-pending-restore;
    in property <string> settings-backup-restored-text;
    in property <bool> settings-restore-open;
    in property <string> settings-restore-title;
    in property <string> settings-restore-text;
    in property <bool> settings-restore-passphrase-open;
    in property <string> settings-restore-passphrase-file;
    in property <bool> settings-restore-passphrase-wrong;
    in-out property <string> settings-restore-passphrase;

    // Category dialog and its delete confirmation.
    in property <bool> category-dialog-open;
    in property <int> category-dialog-id: -1;
    in-out property <string> category-dialog-name;
    in-out property <string> category-dialog-colour;
    in-out property <string> category-dialog-budget;
    in-out property <bool> category-dialog-tax;
    in-out property <bool> category-dialog-transfer;
    in property <string> category-dialog-error;
    in property <[ColourSwatch]> category-dialog-swatches;
    in property <bool> category-delete-open;
    in property <int> category-delete-id: -1;
    in property <string> category-delete-title;
    in property <string> category-delete-text;

    // Rule dialog and its delete confirmation.
    in property <bool> rule-dialog-open;
    in property <int> rule-dialog-id: -1;
    in-out property <string> rule-dialog-pattern;
    in property <[string]> rule-dialog-categories;
    in-out property <int> rule-dialog-category-index;
    in-out property <string> rule-dialog-priority;
    in-out property <bool> rule-dialog-auto-apply;
    in property <[string]> rule-dialog-field-options;
    in-out property <int> rule-dialog-field-index;
    in property <[string]> rule-dialog-direction-options;
    in-out property <int> rule-dialog-direction-index;
    in property <[string]> rule-dialog-tax-options;
    in-out property <int> rule-dialog-tax-index;
    in property <string> rule-dialog-error;
    in property <bool> rule-delete-open;
    in property <int> rule-delete-id: -1;
    in property <string> rule-delete-title;
    in property <string> rule-delete-text;

    // Rule-import preview.
    in property <bool> rule-import-open;
    in property <bool> rule-import-busy;
    in property <bool> rule-import-confirm-enabled;
    in property <string> rule-import-new-rules-text;
    in property <string> rule-import-categories-text;
    in property <string> rule-import-categories-list;
    in property <string> rule-import-duplicates-text;
    in property <string> rule-import-conflicts-text;
    in property <string> rule-import-conflicts-list;
    in property <string> rule-import-errors-text;
    in property <string> rule-import-errors-list;
    in property <bool> rule-import-show-categorize;
    in property <string> rule-import-categorize-text;
    in-out property <bool> rule-import-categorize;

    in property <bool> dashboard-loading;
    in property <bool> dashboard-first-run;
    in property <bool> dashboard-show-content;
    in property <string> dashboard-error-text;

    in property <string> dashboard-month-label;
    in property <bool> dashboard-previous-enabled;
    in property <bool> dashboard-next-enabled;
    in property <bool> dashboard-is-current-month;

    in property <string> dashboard-available-title;
    in property <string> dashboard-available-value;
    in property <string> dashboard-available-subtitle;
    in property <string> dashboard-available-tone;
    in property <string> dashboard-income-title;
    in property <string> dashboard-income-value;
    in property <string> dashboard-expenses-title;
    in property <string> dashboard-expenses-value;
    in property <string> dashboard-pending-title;
    in property <string> dashboard-pending-value;
    in property <string> dashboard-pending-subtitle;
    in property <bool> dashboard-pending-enabled;

    in property <string> dashboard-expenses-section-title;
    in property <string> dashboard-expenses-empty-text;
    in property <[DashboardCategoryRow]> dashboard-expense-rows;
    in property <string> dashboard-transfers-note;

    in property <string> dashboard-chart-title;
    in property <string> dashboard-chart-empty-text;
    in property <string> dashboard-chart-axis-top;
    in property <string> dashboard-chart-axis-mid;
    in property <string> dashboard-chart-axis-zero;
    in property <[DashboardMonthBar]> dashboard-month-bars;
    in property <string> dashboard-income-legend;
    in property <string> dashboard-expenses-legend;
    in property <string> dashboard-partial-note;

    in property <string> dashboard-budgets-title;
    in property <[DashboardBudgetRow]> dashboard-budget-rows;
    in property <bool> dashboard-has-budgets;
    in property <float> dashboard-month-progress;

    in property <string> dashboard-tax-title;
    in property <string> dashboard-tax-hint;
    in property <string> dashboard-tax-value;
    in property <[DashboardTaxSlice]> dashboard-tax-slices;

    in property <string> dashboard-upcoming-title;
    in property <[DashboardUpcomingRow]> dashboard-upcoming-rows;
    in property <bool> dashboard-has-upcoming;

    in property <string> dashboard-recent-title;
    in property <string> dashboard-recent-empty-text;
    in property <[DashboardTransactionRow]> dashboard-recent-rows;
    in property <string> dashboard-view-all-label;

    in-out property <string> reports-tab: "summary";

    in property <string> reports-year-label;
    in property <bool> reports-custom;
    in property <string> reports-range-from;
    in property <string> reports-range-to;
    in property <string> reports-range-error;
    in property <bool> reports-loading;
    in property <bool> reports-exporting;
    in property <bool> reports-has-report;
    in property <bool> reports-empty;
    in property <string> reports-empty-title;
    in property <string> reports-empty-hint;
    in property <string> reports-error-text;
    in property <string> reports-message-text;
    in property <bool> reports-can-export-report;
    in property <bool> reports-can-export-tax;
    in property <bool> reports-linkable;

    in property <string> reports-other-currency-hint;
    in property <string> reports-income-value;
    in property <string> reports-expenses-value;
    in property <string> reports-net-value;
    in property <string> reports-tax-value;
    in property <string> reports-net-tone;
    in property <[ReportAmountRow]> reports-tax-relevant-rows;
    in property <string> reports-tax-relevant-empty;
    in property <string> reports-stat-transactions;
    in property <string> reports-stat-categories;
    in property <string> reports-stat-average;
    in property <string> reports-stat-highest;

    in property <string> reports-monthly-title;
    in property <[ReportMonthlyRow]> reports-monthly-rows;
    in property <string> reports-monthly-total-income;
    in property <string> reports-monthly-total-expenses;
    in property <string> reports-monthly-total-net;
    in property <string> reports-monthly-total-tone;

    in property <[DashboardCategoryRow]> reports-category-rows;
    in property <string> reports-transfers-note;
    in property <[ReportVendorRow]> reports-vendor-rows;

    in property <bool> reports-recurring-empty;
    in property <string> reports-recurring-count;
    in property <string> reports-recurring-yearly;
    in property <string> reports-recurring-monthly;
    in property <[ReportRecurringRow]> reports-recurring-rows;

    in property <bool> reports-has-tax;
    in property <bool> reports-tax-empty;
    in property <string> reports-tax-income-value;
    in property <string> reports-tax-deduction-value;
    in property <string> reports-tax-net-value;
    in property <string> reports-tax-net-tone;
    in property <string> reports-tax-receipts-value;
    in property <string> reports-tax-receipts-subtitle;
    in property <bool> reports-tax-receipts-missing;
    in property <string> reports-tax-other-hint;
    in property <string> reports-tax-suggestions-title;
    in property <string> reports-tax-suggestions-hint;
    in property <[ReportSuggestionRow]> reports-tax-suggestions;
    in property <bool> reports-missing-receipts-only;
    in property <string> reports-tax-empty-title;
    in property <string> reports-tax-empty-hint;
    in property <[ReportTaxRow]> reports-tax-rows;
    in property <bool> accounts-loading;
    in property <bool> accounts-show-content;
    in property <bool> accounts-has-content;
    // Test-only: renders the shared account panel alone for its screenshot.
    in property <bool> accounts-panel-preview;
    in property <string> accounts-error-text;
    in property <string> accounts-message-text;
    in property <[AccountsFigure]> accounts-figures;
    in property <[AccountsBankCard]> accounts-bank-cards;
    in property <[AccountPanelRow]> accounts-panel-rows;
    in property <[AccountGroupChoice]> accounts-group-choices;
    in property <string> accounts-filter-text;
    in property <string> accounts-shown-text;
    in property <[AccountTypeChoice]> accounts-type-choices;
    in property <[string]> accounts-currency-codes;
    in property <[AccountDaysChoice]> accounts-days-choices;

    in property <string> accounts-dialog;
    in property <string> accounts-dialog-title;
    in property <string> accounts-dialog-text;
    in property <string> accounts-dialog-error;
    in property <string> accounts-dialog-account-label;
    in property <string> accounts-dialog-account-name;
    in property <string> accounts-dialog-balance;
    in property <string> accounts-dialog-account-type;
    in property <bool> accounts-dialog-offline;
    in property <int> accounts-dialog-bank-id;
    in property <int> accounts-dialog-account-id;

    in property <bool> accounts-detail-open;
    in property <string> accounts-detail-title;
    in property <string> accounts-detail-subtitle;
    in property <string> accounts-detail-balance;
    in property <string> accounts-detail-tone;
    in property <int> accounts-detail-account-id;
    in property <int> accounts-detail-days;
    in property <string> accounts-detail-summary;
    in property <string> accounts-detail-path;
    in property <string> accounts-detail-axis-top;
    in property <string> accounts-detail-axis-bottom;
    in property <[AccountDetailRow]> accounts-detail-rows;

    // Documents page state, mapped from finglass_core::app::documents::DocumentsState.
    in property <[DocumentRow]> document-rows;
    in property <string> documents-tab: "all";
    in property <string> documents-tab-all-label;
    in property <string> documents-tab-unlinked-label;
    in property <string> documents-tab-linked-label;
    in property <string> documents-search-query;
    in property <bool> documents-ocr-available: true;
    in property <string> documents-ocr-hint;
    in property <bool> documents-uploading;
    in property <string> documents-progress-text;
    in property <bool> documents-loading;
    in property <string> documents-error;
    in property <string> documents-message;
    in property <bool> documents-has-selection;
    in property <string> documents-selected-name;
    in property <bool> documents-selected-linked;
    in property <string> documents-selected-link-label;
    in property <string> documents-selected-ocr-heading;
    in property <string> documents-selected-ocr-text;
    in property <string> documents-preview-kind: "none";
    in property <image> documents-preview;
    in property <[DocumentLinkRow]> documents-suggestions;
    in property <[DocumentLinkRow]> documents-candidates;
    in property <string> documents-candidate-query;
    in property <string> documents-delete-text;

    callback navigate(string);
    callback set-theme(string);
    callback set-language(string);
    callback open-change;
    callback close-change;
    callback change-passphrase(string, string, string, bool);
    callback dismiss-status;

    callback settings-dismiss-message;
    callback settings-set-primary-currency(string);
    callback settings-add-category;
    callback settings-edit-category(int);
    callback settings-delete-category(int);
    callback settings-add-default-categories;
    callback settings-fix-duplicate-colours;
    callback settings-add-rule;
    callback settings-edit-rule(int);
    callback settings-delete-rule(int);
    callback settings-import-rules;
    callback settings-export-rules;
    callback settings-save-tax-keywords(string);
    callback settings-reset-tax-keywords;
    callback settings-create-backup;
    callback settings-restore-backup;
    callback settings-cancel-pending-restore;
    callback settings-confirm-restore;
    callback settings-cancel-restore;
    callback settings-confirm-restore-passphrase(string);
    callback settings-cancel-restore-passphrase;
    callback settings-category-changed(string, string);
    callback settings-rule-changed(string, string);
    callback settings-category-dialog-save;
    callback settings-category-dialog-close;
    callback settings-confirm-delete-category;
    callback settings-cancel-delete-category;
    callback settings-rule-dialog-save;
    callback settings-rule-dialog-close;
    callback settings-confirm-delete-rule;
    callback settings-cancel-delete-rule;
    callback settings-confirm-rule-import;
    callback settings-cancel-rule-import;

    callback dashboard-previous-month;
    callback dashboard-next-month;
    callback dashboard-current-month;
    callback dashboard-open-category(int);
    callback dashboard-open-uncategorized;
    callback dashboard-open-all;
    callback dashboard-open-partner(string);
    callback dashboard-open-accounts;
    callback dashboard-open-settings;
    callback dashboard-dismiss-error;

    callback reports-set-custom(bool);
    callback reports-change-year(int);
    callback reports-apply-range(string, string);
    callback reports-export-report-pdf;
    callback reports-export-csv;
    callback reports-export-tax-xlsx;
    callback reports-export-tax-pdf;
    callback reports-print-tax;
    callback reports-set-missing-only(bool);
    callback reports-accept-suggestion(int);
    callback reports-dismiss-suggestion(int);
    callback reports-mark-not-tax-relevant(int);
    callback reports-reset-tax-automatic(int);
    callback reports-open-category(int);
    callback reports-dismiss;
    callback accounts-open-add-bank;
    callback accounts-close-dialog;
    callback accounts-submit-add-bank(string);
    callback accounts-open-add-account(int);
    callback accounts-submit-add-account(int, string, string, string, string, string);
    callback accounts-open-balance(int);
    callback accounts-submit-balance(int, string, string);
    callback accounts-open-rename(int);
    callback accounts-submit-rename(int, string);
    callback accounts-open-delete-account(int);
    callback accounts-confirm-delete-account(int);
    callback accounts-open-delete-bank(int);
    callback accounts-confirm-delete-bank(int);
    callback accounts-close-detail;
    callback accounts-select-days(int, int);
    callback accounts-select(string, string, int, string);
    callback accounts-toggle-group(string, string, int, string);
    callback accounts-mark-read(string, string, int, string);
    callback accounts-toggle-bank(int);
    callback accounts-forget-deleted(int);
    callback accounts-new-group(string);
    callback accounts-rename-group(int, string);
    callback accounts-delete-group(int);
    callback accounts-move-group(int, bool);
    callback accounts-move-account(int, int);
    callback accounts-filter-changed(string);
    callback accounts-dismiss-message;
    callback accounts-open-detail(int);

    callback documents-set-tab(string);
    callback documents-search(string);
    callback documents-select(int);
    callback documents-close-detail;
    callback documents-link(int);
    callback documents-unlink;
    callback documents-reprocess;
    callback documents-confirm-delete;
    callback documents-upload;
    callback documents-open;
    callback documents-candidate-query-changed(string);
    callback documents-dismiss;

    title: root.app-name;
    icon: @image-url("../../../assets/icons/finglass-256.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.background;

    property <string> title-key: {
        if (root.current-screen == "accounts") {
            return "NavAccounts";
        }
        if (root.current-screen == "transactions") {
            return "NavTransactions";
        }
        if (root.current-screen == "documents") {
            return "NavDocuments";
        }
        if (root.current-screen == "reports") {
            return "NavReports";
        }
        if (root.current-screen == "settings") {
            return "NavSettings";
        }
        return "NavDashboard";
    };

    property <string> screen-title: Tr.t(root.title-key);

    HorizontalLayout {
        Rectangle {
            width: 240px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 16px;
                spacing: 4px;

                Rectangle {
                    height: 56px;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 10px;

                        Image {
                            source: @image-url("../../../assets/icons/finglass-256.png");
                            width: 36px;
                            height: 36px;
                            image-fit: contain;
                        }
                        Text {
                            text: root.app-name;
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 20px;
                    background: transparent;
                }

                NavItem {
                    label: Tr.t("NavDashboard");
                    selected: root.current-screen == "dashboard";
                    activated => { root.navigate("dashboard"); }
                }
                NavItem {
                    label: Tr.t("NavAccounts");
                    selected: root.current-screen == "accounts";
                    activated => { root.navigate("accounts"); }
                }
                NavItem {
                    label: Tr.t("NavTransactions");
                    selected: root.current-screen == "transactions";
                    activated => { root.navigate("transactions"); }
                }
                NavItem {
                    label: Tr.t("NavDocuments");
                    selected: root.current-screen == "documents";
                    activated => { root.navigate("documents"); }
                }
                NavItem {
                    label: Tr.t("NavReports");
                    selected: root.current-screen == "reports";
                    activated => { root.navigate("reports"); }
                }
                NavItem {
                    label: Tr.t("NavSettings");
                    selected: root.current-screen == "settings";
                    activated => { root.navigate("settings"); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: root.version;
                    color: Theme.muted-text;
                    font-size: 12px;
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.divider;
        }

        VerticalLayout {
            Rectangle {
                height: 64px;
                background: Theme.surface;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    spacing: 12px;

                    Text {
                        text: root.screen-title;
                        color: Theme.text;
                        font-size: 24px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    if (root.status-text != "") : Text {
                        text: root.status-text;
                        color: Theme.error;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if (root.status-text != "") : TextButton {
                        text: Tr.t("Dismiss");
                        clicked => { root.dismiss-status(); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            if (root.current-screen == "dashboard") : DashboardPage {
                loading: root.dashboard-loading;
                first-run: root.dashboard-first-run;
                show-content: root.dashboard-show-content;
                error-text: root.dashboard-error-text;

                month-label: root.dashboard-month-label;
                previous-enabled: root.dashboard-previous-enabled;
                next-enabled: root.dashboard-next-enabled;
                is-current-month: root.dashboard-is-current-month;

                available-title: root.dashboard-available-title;
                available-value: root.dashboard-available-value;
                available-subtitle: root.dashboard-available-subtitle;
                available-tone: root.dashboard-available-tone;
                income-title: root.dashboard-income-title;
                income-value: root.dashboard-income-value;
                expenses-title: root.dashboard-expenses-title;
                expenses-value: root.dashboard-expenses-value;
                pending-title: root.dashboard-pending-title;
                pending-value: root.dashboard-pending-value;
                pending-subtitle: root.dashboard-pending-subtitle;
                pending-enabled: root.dashboard-pending-enabled;

                expenses-section-title: root.dashboard-expenses-section-title;
                expenses-empty-text: root.dashboard-expenses-empty-text;
                expense-rows: root.dashboard-expense-rows;
                transfers-note: root.dashboard-transfers-note;

                chart-title: root.dashboard-chart-title;
                chart-empty-text: root.dashboard-chart-empty-text;
                chart-axis-top: root.dashboard-chart-axis-top;
                chart-axis-mid: root.dashboard-chart-axis-mid;
                chart-axis-zero: root.dashboard-chart-axis-zero;
                month-bars: root.dashboard-month-bars;
                income-legend: root.dashboard-income-legend;
                expenses-legend: root.dashboard-expenses-legend;
                partial-note: root.dashboard-partial-note;

                budgets-title: root.dashboard-budgets-title;
                budget-rows: root.dashboard-budget-rows;
                has-budgets: root.dashboard-has-budgets;
                month-progress: root.dashboard-month-progress;

                tax-title: root.dashboard-tax-title;
                tax-hint: root.dashboard-tax-hint;
                tax-value: root.dashboard-tax-value;
                tax-slices: root.dashboard-tax-slices;

                upcoming-title: root.dashboard-upcoming-title;
                upcoming-rows: root.dashboard-upcoming-rows;
                has-upcoming: root.dashboard-has-upcoming;

                recent-title: root.dashboard-recent-title;
                recent-empty-text: root.dashboard-recent-empty-text;
                recent-rows: root.dashboard-recent-rows;
                view-all-label: root.dashboard-view-all-label;

                previous-month => { root.dashboard-previous-month(); }
                next-month => { root.dashboard-next-month(); }
                current-month => { root.dashboard-current-month(); }
                open-category(category-id) => { root.dashboard-open-category(category-id); }
                open-uncategorized => { root.dashboard-open-uncategorized(); }
                open-all => { root.dashboard-open-all(); }
                open-partner(partner) => { root.dashboard-open-partner(partner); }
                open-accounts => { root.dashboard-open-accounts(); }
                open-settings => { root.dashboard-open-settings(); }
                dismiss-error => { root.dashboard-dismiss-error(); }
            }

            if (root.current-screen == "reports") : ReportsPage {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                tab: root.reports-tab;
                year-label: root.reports-year-label;
                custom: root.reports-custom;
                range-from: root.reports-range-from;
                range-to: root.reports-range-to;
                range-error: root.reports-range-error;
                loading: root.reports-loading;
                exporting: root.reports-exporting;
                has-report: root.reports-has-report;
                empty: root.reports-empty;
                empty-title: root.reports-empty-title;
                empty-hint: root.reports-empty-hint;
                error-text: root.reports-error-text;
                message-text: root.reports-message-text;
                can-export-report: root.reports-can-export-report;
                can-export-tax: root.reports-can-export-tax;
                linkable: root.reports-linkable;

                other-currency-hint: root.reports-other-currency-hint;
                income-value: root.reports-income-value;
                expenses-value: root.reports-expenses-value;
                net-value: root.reports-net-value;
                tax-value: root.reports-tax-value;
                net-tone: root.reports-net-tone;
                tax-relevant-rows: root.reports-tax-relevant-rows;
                tax-relevant-empty: root.reports-tax-relevant-empty;
                stat-transactions: root.reports-stat-transactions;
                stat-categories: root.reports-stat-categories;
                stat-average: root.reports-stat-average;
                stat-highest: root.reports-stat-highest;

                monthly-title: root.reports-monthly-title;
                monthly-rows: root.reports-monthly-rows;
                monthly-total-income: root.reports-monthly-total-income;
                monthly-total-expenses: root.reports-monthly-total-expenses;
