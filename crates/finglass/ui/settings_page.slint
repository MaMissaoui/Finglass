import { AboutSlint, CheckBox, ComboBox, LineEdit, ScrollView, Spinner, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tr } from "translations.slint";
import { ChoiceChip, PrimaryButton, TextButton } from "components.slint";
import { AuditRow, CategoryRow, ProfileRow, RuleRow } from "models.slint";
import { FinDeskPassphraseDialog, FinDeskReportDialog } from "settings_dialogs.slint";

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 20px;
    font-weight: 600;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component SettingsPage inherits Rectangle {
    in property <string> theme-pref;
    in property <string> language;
    in property <string> about-version-text;
    in property <[AuditRow]> audit-rows;

    in property <string> settings-error;
    in property <string> settings-message;
    in property <bool> categories-empty;
    in property <bool> has-duplicate-colours;

    in-out property <string> primary-currency;
    in property <[string]> currency-options;
    in-out property <int> primary-currency-index;

    in property <[ProfileRow]> profile-rows;
    in property <[CategoryRow]> category-rows;
    in property <[RuleRow]> rule-rows;
    in-out property <string> tax-keywords;
    in property <string> tax-keywords-count;

    // Backup & restore.
    in property <bool> backup-busy;
    in property <bool> backup-has-pending-restore;
    in property <string> backup-restored-text;

    // One-time import from FinDesk and its result.
    in property <bool> findesk-busy;
    in property <bool> findesk-passphrase-open;
    in property <string> findesk-folder;
    in property <bool> findesk-passphrase-wrong;
    in-out property <string> findesk-passphrase;
    in property <bool> findesk-report-open;
    in property <string> findesk-report-title;
    in property <string> findesk-report-text;
    in property <bool> findesk-report-error;

    in-out property <length> scroll-y;

    callback set-theme(string);
    callback set-language(string);
    callback open-change;
    callback dismiss-message;

    callback set-primary-currency(string);
    callback new-profile;
    callback rename-profile(int);
    callback switch-profile(int);
    callback delete-profile(int);
    callback add-category;
    callback edit-category(int);
    callback delete-category(int);
    callback add-default-categories;
    callback fix-duplicate-colours;
    callback add-rule;
    callback edit-rule(int);
    callback delete-rule(int);
    callback import-rules;
    callback export-rules;
    callback save-tax-keywords(string);
    callback reset-tax-keywords;
    callback create-backup;
    callback restore-backup;
    callback cancel-pending-restore;
    callback import-findesk;
    callback findesk-passphrase-submit(string);
    callback findesk-passphrase-cancel;
    callback findesk-report-close;

    background: Theme.background;

    VerticalLayout {
        if (root.settings-error != "") : Rectangle {
            height: 46px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;

                Text {
                    text: root.settings-error;
                    color: Theme.error;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                TextButton {
                    text: Tr.t("Dismiss");
                    clicked => { root.dismiss-message(); }
                }
            }
        }

        if (root.settings-message != "" && root.settings-error == "") : Rectangle {
            height: 46px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;

                Text {
                    text: root.settings-message;
                    color: Theme.success;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                TextButton {
                    text: Tr.t("Dismiss");
                    clicked => { root.dismiss-message(); }
                }
            }
        }

        ScrollView {
            content-y <=> root.scroll-y;

            VerticalLayout {
                padding: 32px;
                spacing: 16px;

                SectionTitle {
                    text: Tr.t("Appearance");
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: Tr.t("Theme");
                        width: 120px;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    ChoiceChip {
                        label: Tr.t("ThemeSystem");
                        selected: root.theme-pref == "system";
                        clicked => { root.set-theme("system"); }
                    }
                    ChoiceChip {
                        label: Tr.t("ThemeLight");
                        selected: root.theme-pref == "light";
                        clicked => { root.set-theme("light"); }
                    }
                    ChoiceChip {
                        label: Tr.t("ThemeDark");
                        selected: root.theme-pref == "dark";
                        clicked => { root.set-theme("dark"); }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: Tr.t("Language");
                        width: 120px;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    ChoiceChip {
                        label: "EN";
                        selected: root.language == "en";
                        clicked => { root.set-language("en"); }
                    }
                    ChoiceChip {
                        label: "DE";
                        selected: root.language == "de";
                        clicked => { root.set-language("de"); }
                    }
                    ChoiceChip {
                        label: "FR";
                        selected: root.language == "fr";
                        clicked => { root.set-language("fr"); }
                    }
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        width: 460px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: Tr.t("PrimaryCurrency");
                            color: Theme.text;
                            font-size: 14px;
                        }
                        Text {
                            text: Tr.t("PrimaryCurrencyHint");
                            color: Theme.muted-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    ComboBox {
                        width: 180px;
                        model: root.currency-options;
                        current-index <=> root.primary-currency-index;
                        selected(value) => { root.set-primary-currency(value); }
                    }
                }

                Divider {}

                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;

                        SectionTitle {
                            text: Tr.t("Profiles");
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        PrimaryButton {
                            text: Tr.t("NewProfile");
                            clicked => { root.new-profile(); }
                        }
                    }

                    Text {
                        text: Tr.t("ProfilesHint");
                        color: Theme.muted-text;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 640px;
                    }

                    for row in root.profile-rows : Rectangle {
                        height: 46px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 12px;

                            Text {
                                text: row.name;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: row.open ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            if (row.open) : Rectangle {
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.selected;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: Tr.t("ProfileOpen");
                                        color: Theme.on-selected;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if (row.next-start) : Text {
                                text: Tr.t("ProfileNextStart");
                                color: Theme.muted-text;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            if (row.can-switch) : TextButton {
                                text: Tr.t("OpenProfile");
                                clicked => { root.switch-profile(row.index); }
                            }

                            TextButton {
                                text: Tr.t("Edit");
                                clicked => { root.rename-profile(row.index); }
                            }

                            if (row.can-delete) : TextButton {
                                text: Tr.t("Delete");
                                clicked => { root.delete-profile(row.index); }
                            }
                        }
                    }
                }

                Divider {}

                VerticalLayout {
                    spacing: 12px;

                    SectionTitle {
                        text: Tr.t("Categories");
                    }

                    if (root.categories-empty) : Text {
                        text: Tr.t("NoCategoriesYet");
                        color: Theme.muted-text;
                        font-size: 13px;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        if (root.categories-empty) : PrimaryButton {
                            text: Tr.t("AddDefaultCategories");
                            clicked => { root.add-default-categories(); }
                        }

                        if (!root.categories-empty) : PrimaryButton {
                            text: Tr.t("AddCategory");
                            clicked => { root.add-category(); }
                        }

                        if (!root.categories-empty && root.has-duplicate-colours) : TextButton {
                            text: Tr.t("FixDuplicateColours");
                            clicked => { root.fix-duplicate-colours(); }
                        }

                        if (!root.categories-empty) : TextButton {
                            text: Tr.t("AddDefaultCategories");
                            clicked => { root.add-default-categories(); }
                        }

                        if (root.categories-empty) : TextButton {
                            text: Tr.t("AddCategory");
                            clicked => { root.add-category(); }
                        }
                    }

                    for row in root.category-rows : Rectangle {
                        height: 46px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 12px;

                            Rectangle {
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: row.colour;
                            }

                            Text {
                                text: row.name;
                                color: Theme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            if (row.transfer) : Text {
                                text: Tr.t("CategoryTransferLabel");
                                color: Theme.muted-text;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            if (row.tax-relevant) : Text {
                                text: Tr.t("TaxRelevant");
                                color: Theme.warning;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            if (row.budget-text != "") : Text {
                                text: row.budget-text;
                                color: Theme.muted-text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: row.usage-text;
                                color: Theme.muted-text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            TextButton {
                                text: Tr.t("Edit");
                                clicked => { root.edit-category(row.id); }
                            }

                            TextButton {
                                text: Tr.t("Delete");
                                clicked => { root.delete-category(row.id); }
                            }
                        }
                    }
                }

                Divider {}

                VerticalLayout {
                    spacing: 10px;

                    SectionTitle {
                        text: Tr.t("TaxSuggestionKeywords");
                    }

                    Text {
                        text: root.tax-keywords-count;
                        color: Theme.muted-text;
                        font-size: 12px;
                    }

                    TextEdit {
                        height: 150px;
                        text: root.tax-keywords;
                        wrap: word-wrap;
                        edited(value) => { root.tax-keywords = value; }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        PrimaryButton {
                            text: Tr.t("Save");
                            clicked => { root.save-tax-keywords(root.tax-keywords); }
                        }

                        TextButton {
                            text: Tr.t("ResetToDefaults");
                            clicked => { root.reset-tax-keywords(); }
                        }
                    }
                }

                Divider {}

                VerticalLayout {
                    spacing: 12px;

                    SectionTitle {
                        text: Tr.t("AutoCategorizationRules");
                    }

                    Text {
                        text: Tr.t("RulesHint");
                        color: Theme.muted-text;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        PrimaryButton {
                            text: Tr.t("AddRule");
                            enabled: !root.categories-empty;
                            clicked => { root.add-rule(); }
                        }

                        TextButton {
                            text: Tr.t("ImportRules");
                            clicked => { root.import-rules(); }
                        }

                        TextButton {
                            text: Tr.t("ExportRules");
                            clicked => { root.export-rules(); }
                        }
                    }

                    if (root.categories-empty) : Text {
                        text: Tr.t("HintNeedsCategory");
                        color: Theme.muted-text;
                        font-size: 13px;
                    }

                    if (!root.categories-empty && root.rule-rows.length == 0) : Text {
                        text: Tr.t("NoRulesYet");
                        color: Theme.muted-text;
                        font-size: 13px;
                    }

                    for row in root.rule-rows : Rectangle {
                        height: 56px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 12px;

                            Text {
                                text: row.pattern;
                                width: 34%;
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: "→ " + row.category-text;
                                    color: Theme.text;
                                    font-size: 13px;
                                    overflow: elide;
                                }

                                if (row.detail != "") : Text {
                                    text: row.detail;
                                    color: Theme.muted-text;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: row.prio-text;
                                color: Theme.muted-text;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            TextButton {
                                text: Tr.t("Edit");
                                clicked => { root.edit-rule(row.id); }
                            }

                            TextButton {
                                text: Tr.t("Delete");
                                clicked => { root.delete-rule(row.id); }
                            }
                        }
                    }
                }

                Divider {}

                SectionTitle {
                    text: Tr.t("Security");
                }

                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: Tr.t("ChangePassphraseText");
                        color: Theme.muted-text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    PrimaryButton {
                        text: Tr.t("ChangePassphrase");
                        clicked => { root.open-change(); }
                    }
                }

                Divider {}

                VerticalLayout {
                    spacing: 12px;

                    SectionTitle {
                        text: Tr.t("BackupAndRestore");
                    }

                    Text {
                        text: Tr.t("BackupHint");
                        color: Theme.muted-text;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 640px;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        PrimaryButton {
                            text: Tr.t("CreateBackup");
                            enabled: !root.backup-busy;
                            clicked => { root.create-backup(); }
                        }

                        TextButton {
                            text: Tr.t("RestoreFromBackup");
                            enabled: !root.backup-busy && !root.backup-has-pending-restore;
                            clicked => { root.restore-backup(); }
                        }

                        if (root.backup-busy) : HorizontalLayout {
                            spacing: 8px;
                            Spinner {
                                width: 20px;
                                height: 20px;
                            }
                        }
                    }

                    if (root.backup-has-pending-restore) : HorizontalLayout {
                        spacing: 12px;

                        Text {
                            text: Tr.t("RestoreWaiting");
                            color: Theme.warning;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }

                        TextButton {
                            text: Tr.t("CancelRestore");
                            enabled: !root.backup-busy;
                            clicked => { root.cancel-pending-restore(); }
                        }
                    }

                    if (root.backup-restored-text != "") : Text {
                        text: root.backup-restored-text;
                        color: Theme.muted-text;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                Divider {}

                VerticalLayout {
                    spacing: 12px;

                    SectionTitle {
                        text: Tr.t("FinDeskImportTitle");
                    }

                    Text {
                        text: Tr.t("FinDeskImportHint");
                        color: Theme.muted-text;
                        font-size: 12px;
                        wrap: word-wrap;
                        width: 640px;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        PrimaryButton {
                            text: Tr.t("FinDeskImportChooseFolder");
                            enabled: !root.findesk-busy;
                            clicked => { root.import-findesk(); }
                        }

                        if (root.findesk-busy) : HorizontalLayout {
                            spacing: 8px;
                            Spinner {
                                width: 20px;
                                height: 20px;
                            }
                        }
                    }
                }

                Divider {}

                SectionTitle {
                    text: Tr.t("AuditLogLatest");
                }

                if (root.audit-rows.length == 0) : Text {
                    text: Tr.t("AuditLogEmpty");
                    color: Theme.muted-text;
                    font-size: 13px;
                }

                for row in root.audit-rows : HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: row.time;
                        width: 130px;
                        color: Theme.muted-text;
                        font-size: 12px;
                    }
                    Text {
                        text: row.action;
                        width: 190px;
                        color: Theme.text;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: row.actor;
                        width: 70px;
                        color: Theme.muted-text;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: row.details;
                        color: Theme.muted-text;
                        font-size: 12px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                Divider {}

                SectionTitle {
                    text: Tr.t("AboutTitle");
                }

                HorizontalLayout {
                    spacing: 16px;

                    Image {
                        source: @image-url("../../../assets/icons/finglass-256.png");
                        width: 64px;
                        height: 64px;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Finglass";
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.about-version-text;
                            color: Theme.text;
                            font-size: 14px;
                        }
                        Text {
                            text: Tr.t("AboutText");
                            color: Theme.muted-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: Tr.t("AboutBankCodesSource");
                            color: Theme.muted-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                AboutSlint {
                    height: 100px;
                }
            }
        }
    }

    if (root.findesk-passphrase-open) : FinDeskPassphraseDialog {
        folder: root.findesk-folder;
        wrong: root.findesk-passphrase-wrong;
        busy: root.findesk-busy;
        passphrase <=> root.findesk-passphrase;
        close => { root.findesk-passphrase-cancel(); }
        submit(value) => { root.findesk-passphrase-submit(value); }
    }

    if (root.findesk-report-open) : FinDeskReportDialog {
        title: root.findesk-report-title;
        text: root.findesk-report-text;
        is-error: root.findesk-report-error;
        close => { root.findesk-report-close(); }
    }
}

// The Security section's dialog. It reuses the Change mode's fields and validation.
export component ChangePassphraseDialog inherits Rectangle {
    in property <bool> busy;
    in property <string> error-text;

    callback close;
    callback submit(string, string, string, bool);

    property <string> current;
    property <string> new-passphrase;
    property <string> repeat;
    property <bool> show-passphrase;
    property <bool> acknowledged;

    width: 100%;
    height: 100%;
    background: #00000080;

    function send() {
        if (root.busy) {
            return;
        }
        root.submit(root.current, root.new-passphrase, root.repeat, root.acknowledged);
    }

    Rectangle {
        width: 440px;
        height: dialog.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.divider;
        background: Theme.surface;

        dialog := VerticalLayout {
            padding: 24px;
            spacing: 10px;

            Text {
                text: Tr.t("ChangePassphrase");
                color: Theme.text;
                font-size: 22px;
                font-weight: 600;
            }

            Text {
                text: Tr.t("ChangePassphraseText");
                color: Theme.muted-text;
                font-size: 13px;
                wrap: word-wrap;
            }

            Text {
                text: Tr.t("CurrentPassphrase");
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            LineEdit {
                enabled: !root.busy;
                text <=> root.current;
                input-type: root.show-passphrase ? InputType.text : InputType.password;
                accepted(text) => { root.send(); }
            }

            Text {
                text: Tr.t("NewPassphrase");
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            LineEdit {
                enabled: !root.busy;
                text <=> root.new-passphrase;
                input-type: root.show-passphrase ? InputType.text : InputType.password;
                accepted(text) => { root.send(); }
            }

            Text {
                text: Tr.t("RepeatPassphrase");
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            LineEdit {
                enabled: !root.busy;
                text <=> root.repeat;
                input-type: root.show-passphrase ? InputType.text : InputType.password;
                accepted(text) => { root.send(); }
            }

            CheckBox {
                enabled: !root.busy;
                text: Tr.t("ShowPassphrase");
                checked <=> root.show-passphrase;
            }

            CheckBox {
                enabled: !root.busy;
                text: Tr.t("PassphraseNoRecovery");
                checked <=> root.acknowledged;
            }

            if (root.error-text != "") : Text {
                text: root.error-text;
                color: Theme.error;
                font-size: 13px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                PrimaryButton {
                    text: Tr.t("ChangePassphrase");
                    enabled: !root.busy;
                    clicked => { root.send(); }
                }

                TextButton {
                    text: Tr.t("Cancel");
                    enabled: !root.busy;
                    clicked => { root.close(); }
                }

                if (root.busy) : HorizontalLayout {
                    spacing: 8px;
                    Spinner {
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        text: Tr.t("Encrypting");
                        color: Theme.muted-text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
