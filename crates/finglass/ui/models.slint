// One row of the audit log, prepared by finglass-core (including the local-time string).
export struct AuditRow {
    time: string,
    action: string,
    actor: string,
    details: string,
}

// One category in the Settings list, prepared by the UI mapping.
export struct CategoryRow {
    id: int,
    name: string,
    colour: color,
    budget-text: string,
    usage-text: string,
    tax-relevant: bool,
    transfer: bool,
}

// One auto-categorization rule in the Settings list, prepared by the UI mapping.
export struct RuleRow {
    id: int,
    pattern: string,
    category-text: string,
    detail: string,
    prio-text: string,
}

// One colour of the category palette.
export struct ColourSwatch {
    hex: string,
    colour: color,
}
